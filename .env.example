# 「ふ、と」サイトの環境変数サンプル。
# このファイルをコピーして .env を作成し、実際の値を設定する。
# .env は .gitignore 対象のため、コミットしない。
#
# ここに書かれた値は静的サイトのビルド時にHTMLへ埋め込まれる
# (Astro output: "static")。ローカルでは `npm run dev` / `npm run build`
# を再起動すると反映される。本番(Cloudflare Pages等)では、
# デプロイ環境側のビルド環境変数として同じキー名で設定する。
#
# 未設定のままでもビルド・表示は壊れない
# (note→「note(準備中)」表示、お問い合わせ→「連絡先準備中」表示になる)。

# note(外部ブログ)のURL。例: https://note.com/xxxxx
PUBLIC_NOTE_URL=

# お問い合わせ先メールアドレス。設定するとmailtoリンクを表示する。
PUBLIC_CONTACT_EMAIL=

# お問い合わせ先フォームのURL。PUBLIC_CONTACT_EMAILが未設定の場合のみ使われる。
PUBLIC_CONTACT_FORM_URL=
