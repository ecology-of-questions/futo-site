---
/**
 * DefaultLayout.astro
 * ------------------------------------------------------------
 * サイト全体の共通レイアウト。
 * <head> の基本設定、global.css の読み込み、
 * Header / Footer の配置場所を担う。
 *
 * 各ページはこのレイアウトで <slot /> にコンテンツを流し込む。
 * ------------------------------------------------------------
 */
import "@styles/global.css";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "世界を観察するための、研究と実践。",
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
