---
/**
 * DefaultLayout.astro
 * ------------------------------------------------------------
 * サイト全体の共通レイアウト。
 * <head> の基本設定、global.css の読み込み、
 * Header / Footer の配置場所を担う。
 *
 * 各ページはこのレイアウトで <slot /> にコンテンツを流し込む。
 * ------------------------------------------------------------
 */
import "@styles/global.css";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  /**
   * "night" にすると、Desktop幅でmain/footerの文字色(--color-ink)を
   * --color-paperに反転させる(2026-09-03、Decision Log 0059)。
   * Home(夜空背景)専用。他ページでは指定しない = 既定の配色のまま。
   */
  theme?: "default" | "night";
}

const {
  title,
  description = "世界を観察するための、研究と実践。",
  theme = "default",
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/images/logo/favicon.svg" />
    <link rel="alternate icon" href="/images/logo/favicon.ico" />
  </head>
  <body data-theme={theme === "night" ? "night" : undefined}>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
