---
/**
 * BookshelfList.astro
 * ------------------------------------------------------------
 * 役割: 「研究の本棚」の圧縮表示(カードのみ、アクションなし)。
 * `/participate`の「本をプレゼントする」teaser(旧「本から関わる」、
 * 2026-09-11にDecision Log 0128で改称)で使う。フィルター・話したい・
 * 贈る・関連リンク等のアクションは持たない、本体ページ
 * (`/bookshelf`、BookshelfFullList.astro)への案内役に徹する
 * (2026-09-11、Decision Log 0117)。
 *
 * 【Homeプレビューの廃止(2026-09-11、Decision Log 0125)】以前は
 * Home「研究の本棚」プレビューでも共用していたが、トップページを
 * 4層構成に絞る改訂でそのプレビュー自体を廃止したため、現在は
 * `/participate`専用になっている。
 *
 * 実際の書影画像がまだない本は、tokens.cssの既存トークンを
 * color-mixで組み合わせた抽象色面(仮カバー)で代用する。本ごとに
 * `tone`を固定できる(未指定の場合は並び順から機械的に割り当てる)。
 *
 * Desktop幅では3カラム、Mobile幅では縦1カラムに積む
 * (ResearchReviewList等と同じレスポンシブパターン)。
 * ------------------------------------------------------------
 */
import styles from "./BookshelfList.module.css";
import { bookStatusLabels, type BookEntry } from "@/types/bookshelf";

interface Props {
  books: BookEntry[];
}

const { books } = Astro.props;

const tones = ["warm", "moss", "sky"] as const;
const toneForIndex = (i: number) => tones[i % tones.length];
---

<div class={styles.grid}>
  {
    books.map((book, i) => (
      <div class={styles.card}>
        <div class={styles.cover} data-tone={book.tone ?? toneForIndex(i)}>
          {book.image ? (
            <img class={styles.coverImage} src={book.image} alt={book.title} loading="lazy" />
          ) : (
            <h3 class={styles.coverTitle}>{book.title}</h3>
          )}
        </div>
        <p class={styles.label}>{bookStatusLabels[book.status]}</p>
        {book.reason && <p class={styles.description}>{book.reason}</p>}
      </div>
    ))
  }
</div>
