---
/**
 * BookshelfList.astro
 * ------------------------------------------------------------
 * 役割: 「研究の本棚」セクション(2026-09-10のトップページ再設計で
 * 新設)の本カード一覧。実在の書影画像はまだ用意していないため、
 * 各本の`tone`から抽象的な仮カバー(color-mixによる単色〜ごく淡い
 * グラデーション)を生成する(Decision Log 0111)。将来実際の書影
 * 画像を用意する際は、`.cover`をimg要素に差し替える想定で、
 * DOM構造・カード自体のレイアウトはそのまま使えるようにしてある。
 *
 * Desktop幅では3カラム、Mobile幅では縦1カラムに積む
 * (ResearchReviewListやCurrentWorkListと同じ、既存のレスポンシブ
 * パターンを踏襲)。
 * ------------------------------------------------------------
 */
import styles from "./BookshelfList.module.css";
import type { BookEntry } from "@/types/bookshelf";

interface Props {
  books: BookEntry[];
}

const { books } = Astro.props;
---

<div class={styles.grid}>
  {
    books.map((book) => (
      <div class={styles.card}>
        <div class={styles.cover} data-tone={book.tone}>
          <h3 class={styles.coverTitle}>{book.title}</h3>
        </div>
        <p class={styles.label}>{book.label}</p>
        <p class={styles.description}>{book.description}</p>
      </div>
    ))
  }
</div>
