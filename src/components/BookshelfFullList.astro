---
/**
 * BookshelfFullList.astro
 * ------------------------------------------------------------
 * 役割: 「研究の本棚」本体ページ(/bookshelf)の全冊リスト。
 * 旧ParticipateBookshelf.astro(2026-09-11、Decision Log 0116、
 * `/participate`専用として実装)を、`/bookshelf`を「研究の本棚」の
 * 正式な本体ページとする方針転換(Decision Log 0117)に伴い、
 * `/bookshelf`側のコンポーネントとして移設・改名した。ロジック・
 * マークアップは実質的に変更していない(型のimport元のみ
 * `@/types/participate`→`@/types/bookshelf`に変更)。
 *
 * 【構造】
 * 各本は「小さな書影+タイトル/著者/状態ラベル/一言」の1行として
 * 並ぶ。
 *
 * 【フィルター】
 * すべて/読書中/これから読む/読みたい/読了の5ボタン(「贈って
 * いただきました」はフィルター対象外、プロジェクトオーナーの指示。
 * ステータス自体は保持し、「すべて」でのみ表示される)。ライブラリは
 * 使わずvanilla JSでdata-status属性を見て行の表示/非表示を切り替える。
 *
 * 【「この本について話したい」「この本をプレゼントする」を公開版から
 * 保留(2026-09-11、Decision Log 0133)】プロジェクトオーナーの指示
 * により、HP公開を優先するため、共同読書・対話(Decision Log 0115)と
 * Amazonほしい物リストへのプレゼント導線(Decision Log 0119・0130)を
 * 公開UIから外した。機能自体を永久に廃止する判断ではなく、「読む道」
 * 等の仕組みとあわせて公開後に改めて設計するための保留。
 *
 * `conversationEnabled`/`giftEnabled`/`newBookUrl`/`usedBookUrl`は
 * 将来また使う可能性があるフィールドのため、`BookEntry`型・
 * `src/data/bookshelf.ts`からは削除していない(現時点でこのコンポーネント
 * からは参照しない)。`relatedUrl`のみ、この本から生まれた記録への
 * 導線として引き続き表示する。
 *
 * フィルターの開閉はフレームワークを使わずvanilla JSで実装している
 * (Header.astroのメニュー開閉と同じ方針)。
 *
 * 【「持ち寄られた本」ラベルの追加(2026-09-11、Decision Log 0137)】
 * `book.contributed`がtrueの本にのみ、statusLabelと同じ行に「・
 * 持ち寄られた本」という控えめなテキストを追加する。新しいバッジ・
 * 色付きタグは作らず、既存の.statusLabelと同じ見た目(小さく淡い
 * テキスト)のまま情報だけ足す形にした。誰が持ち寄ったかは表示しない。
 *
 * 【「本を知る→購入する→一緒に読みたい」の導線を追加(2026-09-12、
 * Decision Log 0138)】
 * - 書影は image → externalCoverUrl → 仮カバー(tone)の優先順位で
 *   表示する。externalCoverUrlは正規に取得した外部URLをそのまま
 *   <img src>で参照するだけで、画像のダウンロード・再アップロードは
 *   行わない。
 * - `purchaseUrl`がある本にのみ、`buildPurchaseUrl`(`src/config/
 *   site.ts`)が組み立てたURLへの控えめな外部リンクを表示する
 *   (`purchaseProvider`に応じて「Amazonで見る」/「購入する」と表示を
 *   分ける)。アソシエイトタグは環境変数が設定されている場合のみ
 *   付与され、未設定の間は通常のリンクとして動作する。
 * - 実際にアソシエイトタグ付きリンクを1件でも表示する場合のみ、
 *   一覧の末尾にAmazonアソシエイトの規約で必要な開示文言を表示する
 *   (`isActiveAffiliateLink`で判定)。
 * - 「一緒に読みたい →」は、購入導線とは完全に独立した、全ての本に
 *   常時表示するトグル式の小さなフォーム。読書会の参加申込ではない
 *   ことを明記し、購入有無・所有有無は尋ねない。既存の
 *   `contactFormEndpoint`(Formspree)をそのまま再利用する
 *   (新しいバックエンドは追加していない)。
 * ------------------------------------------------------------
 */
import styles from "./BookshelfFullList.module.css";
import { bookStatusLabels, type BookStatus, type BookEntry } from "@/types/bookshelf";
import { contactFormEndpoint, buildPurchaseUrl, isActiveAffiliateLink } from "@/config/site";

interface Props {
  books: BookEntry[];
}

const { books } = Astro.props;

const tones = ["warm", "moss", "sky"] as const;
const toneForIndex = (i: number) => tones[i % tones.length];

const filters: { value: "all" | BookStatus; label: string }[] = [
  { value: "all", label: "すべて" },
  { value: "reading", label: bookStatusLabels.reading },
  { value: "queued", label: bookStatusLabels.queued },
  { value: "wishlist", label: bookStatusLabels.wishlist },
  { value: "finished", label: bookStatusLabels.finished },
];

const purchaseLabels = { amazon: "Amazonで見る", other: "購入する" } as const;

const rows = books.map((book, i) => ({
  book,
  tone: book.tone ?? toneForIndex(i),
  purchaseHref: buildPurchaseUrl(book),
  purchaseLabel: purchaseLabels[book.purchaseProvider ?? "other"],
  isAffiliate: isActiveAffiliateLink(book),
}));

const hasAffiliateDisclosure = rows.some((row) => row.isAffiliate);
---

<div class={styles.filters} role="group" aria-label="本の状態で絞り込む">
  {
    filters.map((filter) => (
      <button
        type="button"
        class={styles.filterButton}
        data-book-filter={filter.value}
        aria-pressed={filter.value === "all" ? "true" : "false"}
      >
        {filter.label}
      </button>
    ))
  }
</div>

<ul class={styles.list} data-book-list>
  {
    rows.map(({ book, tone, purchaseHref, purchaseLabel, isAffiliate }) => (
      <li class={styles.row} data-book-row data-status={book.status}>
        <div class={styles.rowMain}>
          <span class={styles.cover} data-tone={tone}>
            {book.image ? (
              <img class={styles.coverImage} src={book.image} alt={book.title} loading="lazy" />
            ) : book.externalCoverUrl ? (
              <img class={styles.coverImage} src={book.externalCoverUrl} alt={book.title} loading="lazy" />
            ) : (
              <span class={styles.coverTitle}>{book.title}</span>
            )}
          </span>
          <div class={styles.info}>
            <p class={styles.statusLabel}>
              {bookStatusLabels[book.status]}
              {book.contributed && <span class={styles.contributedTag}>・ 持ち寄られた本</span>}
            </p>
            <p class={styles.title}>{book.title}</p>
            {book.author && <p class={styles.author}>{book.author}</p>}
            {book.reason && <p class={styles.reason}>{book.reason}</p>}
          </div>
        </div>

        <div class={styles.actions}>
          {purchaseHref && (
            <a
              class={styles.actionLink}
              href={purchaseHref}
              target="_blank"
              rel={isAffiliate ? "noopener noreferrer sponsored" : "noopener noreferrer"}
            >
              {purchaseLabel} <span class={styles.actionArrow} aria-hidden="true">→</span>
            </a>
          )}
          {book.relatedUrl && (
            <a class={styles.actionLink} href={book.relatedUrl}>
              この本から生まれた記録 <span class={styles.actionArrow} aria-hidden="true">→</span>
            </a>
          )}
          <button
            type="button"
            class={styles.actionLink}
            data-toggle-trigger
            aria-expanded="false"
            aria-controls={`read-together-panel-${book.id}`}
          >
            一緒に読みたい <span class={styles.actionArrow} aria-hidden="true">→</span>
          </button>
        </div>

        <div
          id={`read-together-panel-${book.id}`}
          class={styles.readTogetherPanel}
          data-read-together-panel
          hidden
        >
          <h3 class={styles.readTogetherHeading}>一緒に読みたい</h3>
          <p class={styles.readTogetherIntro}>
            「この本を一緒に読みたい」と思ったことを知らせるためのフォームです。
            <br />
            読書会への参加申込ではありません。
          </p>
          <p class={styles.readTogetherIntro}>
            同じ本が気になっている人が集まったときに、
            <br />
            こちらから連絡することがあります。
          </p>

          <form
            class={styles.readTogetherForm}
            method="POST"
            action={contactFormEndpoint}
            data-read-together-form
          >
            <input
              type="text"
              name="_gotcha"
              class={styles.honeypot}
              tabindex="-1"
              autocomplete="off"
              aria-hidden="true"
            />
            <input type="hidden" name="_subject" value="ふ、と 研究の本棚 一緒に読みたい" />
            <input type="hidden" name="book_id" value={book.id} />
            <input type="hidden" name="book_title" value={book.title} />

            <div class={styles.field}>
              <label class={styles.label} for={`read-together-email-${book.id}`}
                >メールアドレス <span class={styles.required}>必須</span></label
              >
              <input
                class={styles.input}
                type="email"
                id={`read-together-email-${book.id}`}
                name="email"
                autocomplete="email"
                required
              />
            </div>

            <div class={styles.field}>
              <label class={styles.label} for={`read-together-name-${book.id}`}
                >お名前 <span class={styles.optional}>任意</span></label
              >
              <input
                class={styles.input}
                type="text"
                id={`read-together-name-${book.id}`}
                name="name"
                autocomplete="name"
              />
            </div>

            <div class={styles.field}>
              <label class={styles.label} for={`read-together-note-${book.id}`}
                >この本で気になっていること <span class={styles.optional}>任意</span></label
              >
              <textarea class={styles.textarea} id={`read-together-note-${book.id}`} name="note" rows="3" />
            </div>

            <button class={styles.readTogetherSubmit} type="submit"
              >送る <span aria-hidden="true">→</span></button
            >

            <p class={styles.status} data-read-together-status role="status" aria-live="polite" />

            <p class={styles.readTogetherPrivacyNote}>
              送信いただいた情報は、<a class={styles.privacyLink} href="/privacy">個人情報の取り扱い</a
              >に基づいて管理します。
            </p>
          </form>
        </div>
      </li>
    ))
  }
</ul>

{
  hasAffiliateDisclosure && (
    <p class={styles.affiliateDisclosure}>
      Amazonのアソシエイトとして、「ふ、と」は適格販売により収入を得ています。
    </p>
  )
}

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>("[data-book-filter]");
  const bookRows = document.querySelectorAll<HTMLElement>("[data-book-row]");

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const filter = button.dataset.bookFilter ?? "all";
      filterButtons.forEach((b) => b.setAttribute("aria-pressed", b === button ? "true" : "false"));
      bookRows.forEach((row) => {
        row.hidden = filter !== "all" && row.dataset.status !== filter;
      });
    });
  });

  const toggles = document.querySelectorAll<HTMLButtonElement>("[data-toggle-trigger]");
  toggles.forEach((trigger) => {
    const targetId = trigger.getAttribute("aria-controls");
    const panel = targetId ? document.getElementById(targetId) : null;
    if (!panel) return;

    trigger.addEventListener("click", () => {
      const expanded = trigger.getAttribute("aria-expanded") === "true";
      trigger.setAttribute("aria-expanded", expanded ? "false" : "true");
      panel.hidden = expanded;
    });
  });

  const readTogetherForms = document.querySelectorAll<HTMLFormElement>("[data-read-together-form]");
  readTogetherForms.forEach((form) => {
    const status = form.querySelector<HTMLElement>("[data-read-together-status]");
    if (!status) return;

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      submitButton?.setAttribute("disabled", "true");
      status.textContent = "送信中...";

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });

        if (response.ok) {
          status.textContent = "知らせました。ありがとうございます。";
          form.reset();
        } else {
          status.textContent = "送信に失敗しました。時間をおいて、もう一度お試しください。";
        }
      } catch {
        status.textContent = "送信に失敗しました。時間をおいて、もう一度お試しください。";
      } finally {
        submitButton?.removeAttribute("disabled");
      }
    });
  });
</script>
