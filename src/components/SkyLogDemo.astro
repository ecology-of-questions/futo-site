---
/**
 * SkyLogDemo.astro
 * ------------------------------------------------------------
 * 「きょうの空」制作ノート(/kyou-no-sora/)に埋め込む体験デモ
 * (2026-11-11)。プロジェクトオーナーから「触って動くデモを直接
 * 埋め込みたい」との指示を受け、制作過程の参考資料
 * (reference/zujo-prototype.html、Claude Artifactの試作、
 * リポジトリには取り込んでいない)の語彙(きこえたものの種類・
 * うるささの段階)だけを引き継ぎ、Firestore等の実バックエンドに
 * 依存する部分は持たず、素のHTML/CSS/JSとして作り直したもの。
 *
 * 【実装方式】FieldnoteMemoDemo・WalkingScorePlayerと同じ
 * progressive enhancementの方針を踏襲する。きこえた記録の一覧は
 * ビルド時にすべて描画し、新しい記録は`<template>`をクローンして
 * 追加する(innerHTML組み立てやCSS Modulesのハッシュ化クラス名の
 * 付け外しはしない)。種類・うるささの選択は`aria-pressed`のみで
 * 管理する(タブの選択状態管理と同じ考え方)。JS無効時は、プリセットの
 * 記録一覧と選択肢がそのまま読める静的な状態になる(記録ボタンのみ
 * JSが必要)。
 *
 * 色は空の時刻ごとの色(`skyHourColors`、24色)のみを例外的にデータ
 * ファイル側で管理する(`src/data/skyLogDemo.ts`のコメント参照)。
 * それ以外の配色・書体はすべて`tokens.css`の既存トークン
 * (--color-ink/--color-ink-muted/--color-accent-blue/
 * --color-accent-beige/--color-paper、--font-sans/--font-body)のみを
 * 使う。架空の記録を本物らしく見せる保存機能は持たず、押しても
 * 何も起きないボタン(写真添付など)は最初から置いていない。
 * ------------------------------------------------------------
 */
import { skyHourColors, kindLabels, loudnessLabels, type SkyLogEntry } from "@/data/skyLogDemo";
import styles from "./SkyLogDemo.module.css";

interface Props {
  entries: SkyLogEntry[];
}

const { entries } = Astro.props;

function formatTime(entry: SkyLogEntry): string {
  return `${String(entry.hour).padStart(2, "0")}:${String(entry.minute).padStart(2, "0")}`;
}

const sortedEntries = [...entries].sort((a, b) => b.hour * 60 + b.minute - (a.hour * 60 + a.minute));
const kindEntries = Object.entries(kindLabels) as [keyof typeof kindLabels, string][];
const loudnessEntries = Object.entries(loudnessLabels) as [keyof typeof loudnessLabels, string][];
---

<div class={styles.wrapper} data-sky-log-demo>
  <div class={styles.top}>
    <span class={styles.topLabel}>「きょうの空」の体験デモ</span>
    <span class={styles.topNote}>デモ・架空の記録です</span>
  </div>

  <div class={styles.skyStrip} aria-hidden="true">
    {skyHourColors.map((color, hour) => <span class={styles.hourSegment} style={`background-color: ${color}`} data-hour={hour} />)}
  </div>
  <p class={styles.skyCaption}>いまは<span data-current-hour-label>—</span>の空です。</p>

  <div class={styles.logger}>
    <p class={styles.loggerLabel}>なにがきこえた?</p>
    <div class={styles.chipRow} role="group" aria-label="きこえたものの種類">
      {kindEntries.map(([key, label], index) => (
        <button type="button" class={styles.chip} data-kind-choice={key} aria-pressed={index === 0 ? "true" : "false"}>
          {label}
        </button>
      ))}
    </div>
    <div class={styles.chipRow} role="group" aria-label="うるささ">
      {loudnessEntries.map(([key, label], index) => (
        <button type="button" class={styles.chip} data-loudness-choice={key} aria-pressed={index === 0 ? "true" : "false"}>
          {label}
        </button>
      ))}
    </div>
    <button type="button" class={styles.logButton} data-log-button>いまの空に記録する</button>
  </div>

  <ul class={styles.entryList} data-entry-list hidden={sortedEntries.length === 0}>
    {sortedEntries.map((entry) => (
      <li class={styles.entryRow}>
        <span class={styles.entryTime}>{formatTime(entry)}</span>
        <span class={styles.entryKind}>{kindLabels[entry.kind]}</span>
        <span class={styles.entryLoudness}>{loudnessLabels[entry.loudness]}</span>
      </li>
    ))}
  </ul>
  <p class={styles.empty} data-entry-empty hidden={sortedEntries.length > 0}>
    まだ記録がありません。
  </p>

  <template data-entry-template>
    <li class={styles.entryRow}>
      <span class={styles.entryTime} data-entry-time></span>
      <span class={styles.entryKind} data-entry-kind></span>
      <span class={styles.entryLoudness} data-entry-loudness></span>
    </li>
  </template>

  <p class={styles.caption}>
    「きょうの空」でできることのイメージを、架空の記録で再現した体験デモです。ここでの記録はこのページを離れると保存されません。
  </p>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-sky-log-demo]").forEach((root) => {
    const currentHourLabel = root.querySelector<HTMLElement>("[data-current-hour-label]");
    const hourSegments = root.querySelectorAll<HTMLElement>("[data-hour]");
    const entryList = root.querySelector<HTMLElement>("[data-entry-list]");
    const entryTemplate = root.querySelector<HTMLTemplateElement>("[data-entry-template]");
    const emptyMessage = root.querySelector<HTMLElement>("[data-entry-empty]");
    const logButton = root.querySelector<HTMLButtonElement>("[data-log-button]");
    if (!entryList || !entryTemplate || !logButton) return;

    const currentHour = new Date().getHours();
    hourSegments.forEach((segment) => {
      segment.toggleAttribute("data-is-current", Number(segment.dataset.hour) === currentHour);
    });
    if (currentHourLabel) currentHourLabel.textContent = `${currentHour}時`;

    let selectedKindLabel = root.querySelector<HTMLElement>('[data-kind-choice][aria-pressed="true"]')?.textContent?.trim() ?? "";
    let selectedLoudnessLabel = root.querySelector<HTMLElement>('[data-loudness-choice][aria-pressed="true"]')?.textContent?.trim() ?? "";

    root.querySelectorAll<HTMLElement>("[data-kind-choice]").forEach((btn) => {
      btn.addEventListener("click", () => {
        selectedKindLabel = btn.textContent?.trim() ?? selectedKindLabel;
        root.querySelectorAll<HTMLElement>("[data-kind-choice]").forEach((b) => b.setAttribute("aria-pressed", b === btn ? "true" : "false"));
      });
    });

    root.querySelectorAll<HTMLElement>("[data-loudness-choice]").forEach((btn) => {
      btn.addEventListener("click", () => {
        selectedLoudnessLabel = btn.textContent?.trim() ?? selectedLoudnessLabel;
        root.querySelectorAll<HTMLElement>("[data-loudness-choice]").forEach((b) => b.setAttribute("aria-pressed", b === btn ? "true" : "false"));
      });
    });

    logButton.addEventListener("click", () => {
      const clone = entryTemplate.content.firstElementChild?.cloneNode(true) as HTMLElement | undefined;
      if (!clone) return;
      const now = new Date();
      const timeEl = clone.querySelector<HTMLElement>("[data-entry-time]");
      const kindEl = clone.querySelector<HTMLElement>("[data-entry-kind]");
      const loudnessEl = clone.querySelector<HTMLElement>("[data-entry-loudness]");
      if (timeEl) timeEl.textContent = `${String(now.getHours()).padStart(2, "0")}:${String(now.getMinutes()).padStart(2, "0")}`;
      if (kindEl) kindEl.textContent = selectedKindLabel;
      if (loudnessEl) loudnessEl.textContent = selectedLoudnessLabel;
      entryList.prepend(clone);
      entryList.hidden = false;
      emptyMessage?.setAttribute("hidden", "");
    });
  });
</script>
