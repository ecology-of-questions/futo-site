---
/**
 * ResearchCard.astro
 * ------------------------------------------------------------
 * 役割: 「研究断面」等で使う個別カード。
 * β公開の方針(2026-08-04 方針転換)により、Researchページは
 * 詳細UIを作り込まず、"Status: Preparing" 程度の最小情報で
 * 十分とすることになった。このカードはその最小構成を実装する。
 *
 * 汎用カードとして設計しており、statusが "preparing" 以外の値
 * (例: "published") になった場合も同じ構造で表示できるようにしている。
 * これは実装として自然に決められる範囲の提案であり、
 * カードに実際に載せる文言・件数などの情報設計はプロジェクトオーナー/
 * ChatGPTの判断領域として空けてある。
 * ------------------------------------------------------------
 */
import styles from "./ResearchCard.module.css";

interface Props {
  title: string;
  status: "preparing" | "published";
  /** 現在取り組んでいる問い、または公開時のテーマ */
  currentFocus?: string;
  lastUpdated?: string;
}

const { title, status, currentFocus, lastUpdated } = Astro.props;

const statusLabel: Record<Props["status"], string> = {
  preparing: "Preparing",
  published: "Published",
};
---

<article class={styles.card} data-status={status}>
  <h3 class={styles.title}>{title}</h3>

  <dl class={styles.meta}>
    <div class={styles.row}>
      <dt>Status</dt>
      <dd>{statusLabel[status]}</dd>
    </div>

    {
      currentFocus && (
        <div class={styles.row}>
          <dt>Current Focus</dt>
          <dd>"{currentFocus}"</dd>
        </div>
      )
    }

    {
      lastUpdated && (
        <div class={styles.row}>
          <dt>Last Updated</dt>
          <dd>{lastUpdated}</dd>
        </div>
      )
    }
  </dl>
</article>
