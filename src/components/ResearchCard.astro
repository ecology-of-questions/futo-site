---
/**
 * ResearchCard.astro
 * ------------------------------------------------------------
 * 役割: 「研究断面」等で使う個別カード。
 * β公開の方針(2026-08-04 方針転換)により、Researchページは
 * 詳細UIを作り込まず、"Status: Preparing" 程度の最小情報で
 * 十分とすることになった。このカードはその最小構成を実装する。
 *
 * status は「出版状態」ではなく「研究状態」を表す(Decision Log 0005)。
 * Research Review に限らず、Research Fragment 等でも再利用できるよう、
 * status の型は ResearchCard から独立させ `src/types/research.ts` に置いた。
 *
 * href(2026-08-15追加、Decision Log 0030): 詳細ページを持つReviewが
 * 出てきたため、任意でカード全体を詳細ページへのリンクにできるように
 * した。未指定の場合はこれまで通りリンクなしのカードとして表示する
 * (詳細ページがまだ無いpreparing状態のカード等)。
 * ------------------------------------------------------------
 */
import styles from "./ResearchCard.module.css";
import { researchStatusLabel, type ResearchStatus } from "@/types/research";

interface Props {
  title: string;
  status: ResearchStatus;
  /** 現在取り組んでいる問い、または公開時のテーマ */
  currentFocus?: string;
  lastUpdated?: string;
  /** 詳細ページへのリンク先。未指定ならリンクなしのカードとして表示する */
  href?: string;
}

const { title, status, currentFocus, lastUpdated, href } = Astro.props;
const Wrapper = href ? "a" : "div";
---

<Wrapper href={href} class={href ? styles.cardLink : undefined}>
  <article class={styles.card} data-status={status}>
    <h3 class={styles.title}>{title}</h3>

    <dl class={styles.meta}>
      <div class={styles.row}>
        <dt>Status</dt>
        <dd>{researchStatusLabel[status]}</dd>
      </div>

      {
        currentFocus && (
          <div class={styles.row}>
            <dt>Current Focus</dt>
            <dd>"{currentFocus}"</dd>
          </div>
        )
      }

      {
        lastUpdated && (
          <div class={styles.row}>
            <dt>Last Updated</dt>
            <dd>{lastUpdated}</dd>
          </div>
        )
      }
    </dl>
  </article>
</Wrapper>
