---
/**
 * FieldnoteMemoDemo.astro
 * ------------------------------------------------------------
 * 「Fieldnote」ノート詳細ページに埋め込む体験デモ(2026-09-19、
 * Decision Log 0184)。プロジェクトオーナーがClaudeの「Design」
 * キャンバスで作った「Fieldnote デューイ読書」モックアップ
 * (claude.ai/artifact/QSx1PF2fTRXEEpqAzqAXwL)を、サイト内で完結する
 * 素のHTML/CSS/JSとして移植したもの。元のモックアップはClaude Canvas
 * 独自のテンプレート構文・ランタイムに依存しており、そのままiframeで
 * 埋め込むとCanvasの編集画面ごと表示されうる・外部ランタイムに依存する
 * ため採用せず、見た目と状態遷移だけを再現している。
 *
 * 【元モックアップから変更した点】
 * - 「Watchの録音の追記先」ボトムシートは、まだ存在しない実機連携
 *   (Apple Watch)を前提にしていたため、「他の記録を見る」という
 *   セッション切り替えに置き換えた(切り替えると実際にそのセッションの
 *   記録が表示される。元のUIはこの一覧が「録音の追記先」を選ぶだけで
 *   表示中のセッションは切り替わらなかった)。
 * - 「写真を追加」「読み取り直す」「この追記を削除」は、実際のバック
 *   エンドが無いデモで押しても何も起きないボタンになってしまうため
 *   削除した(未完成な動作をそれらしく見せない、という既存コンポーネント
 *   ―WalkingScorePlayer等―と同じ方針)。
 * - 「私のメモ」欄は実際に入力できるtextareaにした(このデモでは
 *   保存されない、ページを離れると消える)。
 * - 色は元モックアップ独自の配色(緑・赤のアクセント含む)ではなく、
 *   `tokens.css`の既存トークンのみを使うよう配色し直した
 *   (CLAUDE.mdの「色を独自にハードコードしない」方針)。フォントも
 *   Google Fonts読み込みをやめ、サイト共通の--font-body/--font-sansを
 *   使っている。
 *
 * 【実装方式】フレームワーク不使用の方針(CLAUDE.md)のため、6セッション
 * 分のヘッダー・タブ・パネルを全てビルド時に描画し、JSは表示/非表示の
 * 切り替えのみを行う(WalkingScorePlayerと同じ「全部描画してJSで
 * 出し分ける」progressive enhancement)。JSが無い場合は初期状態
 * (デューイ読書・たどるタブ)がそのまま読める。タブの選択状態は
 * aria-selectedのみで管理し、CSS Modulesのハッシュ化されたクラス名を
 * JS側から付け外ししない(既存コンポーネントの検証で得た教訓)。
 *
 * 【個人の記録ではないことの明示・実アプリへの導線を追加(2026-09-20、
 * Decision Log 0187)】指示書「Fieldnote読書記録と公開本棚の統合 v3」に
 * 基づき、「個人の記録は表示されません」という明示的な注記と、実際の
 * 個人用ツール(`/fieldnote/`)への「自分のFieldnoteを開く →」リンクを
 * 追加した。このデモが表す「たどる/自分のまとめ/育つ」というAI活用の
 * タブ構成自体(Decision Log 0184でプロジェクトオーナーが持ち込んだ
 * 将来構想のCanvasモックアップに基づく)は、実アプリの「抜粋・コメント・
 * つながり」という現在の実装語彙に合わせて全面刷新することはしなかった
 * ——モックアップ無しでの独自改変は情報設計の決定にあたり、Decision
 * Log 0184の経緯(プロジェクトオーナー自身が作った構想)を尊重すべき
 * 範囲外の判断だと判断したため(実行判断、Decision Log 0187参照)。
 * デモの状態(`data-fieldnote-memo`配下のDOM操作のみ)は、実アプリの
 * IndexedDB(`futo-fieldnote`)には一切アクセスしておらず、分離は従来
 * どおり維持されている。
 * ------------------------------------------------------------
 */
import type { FieldnoteEntry, FieldnoteSession, FieldnoteSessionIcon } from "@/types/fieldnoteMemo";
import styles from "./FieldnoteMemoDemo.module.css";

interface Props {
  sessions: FieldnoteSession[];
}

const { sessions } = Astro.props;
const defaultSessionId = sessions[0]?.id;

const SESSION_ICON_PATHS: Record<FieldnoteSessionIcon, string> = {
  book: "M4 5.5C6.5 4.5 9.5 4.5 12 6c2.5-1.5 5.5-1.5 8-.5V19c-2.5-1-5.5-1-8 .5-2.5-1.5-5.5-1.5-8-.5zM12 6v13.5",
  frame:
    "M5.5 5h13a1.5 1.5 0 0 1 1.5 1.5v11a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 17.5v-11A1.5 1.5 0 0 1 5.5 5zM4 15l4.5-4.5 4 4 3-3L20 16",
  smile: "M12 3.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17zM8.5 14a4 4 0 0 0 7 0M9 9.5v.5M15 9.5v.5",
  leaf: "M12 20v-8M12 12C12 8.5 9.5 6.5 5.5 6.5c0 3.5 2 5.5 6.5 5.5zM12 14.5c0-3 2.5-5 6.5-5 0 3.2-2 5-6.5 5z",
  chat: "M5 5h14v10H10l-4 4v-4H5z",
  pin: "M12 21s-6-5.5-6-10a6 6 0 0 1 12 0c0 4.5-6 10-6 10zM12 8.8a2.2 2.2 0 1 0 0 4.4 2.2 2.2 0 0 0 0-4.4z",
};

const TABS = [
  { key: "overview", label: "概要" },
  { key: "trace", label: "たどる" },
  { key: "notes", label: "自分のまとめ" },
  { key: "grow", label: "育つ" },
] as const;

function isEditableEntry(entry: FieldnoteEntry): boolean {
  return entry.type === "photo" || entry.type === "hand";
}

type TraceRow = { kind: "header"; label: string } | { kind: "entry"; entry: FieldnoteEntry };

/** 記録を日付見出しでグループ化した行の並びを作る(同じ日が続く間は見出しを出さない) */
function buildTraceRows(entries: FieldnoteEntry[]): TraceRow[] {
  const rows: TraceRow[] = [];
  let lastDay: string | null = null;
  for (const entry of entries) {
    if (entry.day !== lastDay) {
      rows.push({ kind: "header", label: entry.day });
      lastDay = entry.day;
    }
    rows.push({ kind: "entry", entry });
  }
  return rows;
}

const editableEntries = sessions.flatMap((session) =>
  session.entries.filter(isEditableEntry).map((entry) => ({ entry, session })),
);
const publishableEntries = editableEntries.filter(({ entry }) => Boolean(entry.excerpt));
---

<div class={styles.wrapper} data-fieldnote-memo>
  <div class={styles.top}>
    <span class={styles.topLabel}>Fieldnoteの体験デモ</span>
    <span class={styles.topNote}>デモ・架空の記録です</span>
  </div>
  <p class={styles.demoDisclaimer}>
    ここに表示されるのはすべて架空の記録です。個人の記録は表示されません。
    <a class={styles.demoDisclaimerLink} href="/fieldnote/">自分のFieldnoteを開く →</a>
  </p>

  <div class={styles.frame}>
    <div class={styles.screen} data-screen="session">
      {
        sessions.map((session) => (
          <div class={styles.sessionBlock} data-session={session.id} style={session.id === defaultSessionId ? undefined : "display: none"}>
            <div class={styles.header}>
              <div class={styles.headerTile}>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <path d={SESSION_ICON_PATHS[session.icon]} />
                </svg>
              </div>
              <div class={styles.headerTitle}>{session.title}</div>
            </div>

            <div class={styles.tabbar} role="tablist">
              {TABS.map((tab) => (
                <button type="button" role="tab" data-tab-button={tab.key} class={styles.tabButton} aria-selected={tab.key === "trace" ? "true" : "false"}>
                  {tab.label}
                </button>
              ))}
            </div>

            <div class={styles.tabPanels}>
              <div data-tab-panel="overview" class={styles.panel} style="display: none">
                <div class={styles.overviewCard}>
                  {session.overview ? <p>{session.overview}</p> : <p class={styles.placeholder}>目的や範囲を短く書けます（任意）。</p>}
                </div>
              </div>

              <div data-tab-panel="trace" class={styles.panel}>
                <div class={styles.traceList}>
                  {buildTraceRows(session.entries).map((row) =>
                    row.kind === "header" ? (
                      <div class={styles.dayHeader}>{row.label}</div>
                    ) : (
                      <div class={styles.entryRow}>
                        <span class={styles.entryTime}>{row.entry.time}</span>
                        {isEditableEntry(row.entry) ? (
                          <button type="button" class={styles.entryCard} data-open-entry={row.entry.id}>
                            {row.entry.type === "photo" && (
                              <Fragment>
                                <div class={styles.entryKind}>
                                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M4 8h3l1.5-2h7L17 8h3v11H4z" />
                                    <circle cx="12" cy="13.5" r="3.5" />
                                  </svg>
                                  写真
                                </div>
                                <p class={styles.entryMemo}>{row.entry.memo}</p>
                                {row.entry.count && row.entry.count > 1 && <span class={styles.entryBadge}>＋{row.entry.count - 1}枚</span>}
                              </Fragment>
                            )}
                            {row.entry.type === "hand" && (
                              <Fragment>
                                <div class={styles.entryKind}>
                                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M4 20l1.2-4.2L16.6 4.4a2 2 0 0 1 2.8 0l.2.2a2 2 0 0 1 0 2.8L8.2 18.8 4 20z" />
                                  </svg>
                                  手書き
                                </div>
                                <p class={styles.entryMemo}>{row.entry.memo}</p>
                              </Fragment>
                            )}
                          </button>
                        ) : (
                          <div class={styles.entryCard}>
                            {row.entry.type === "audio" && (
                              <Fragment>
                                <div class={styles.entryKind}>
                                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="9" y="3" width="6" height="11" rx="3" />
                                    <path d="M5.5 11.5a6.5 6.5 0 0 0 13 0M12 18v3" />
                                  </svg>
                                  音声・{row.entry.duration}
                                </div>
                                <p class={styles.entryMemoClamp}>{row.entry.text}</p>
                              </Fragment>
                            )}
                            {row.entry.type === "url" && (
                              <div class={styles.entryUrlRow}>
                                <span class={styles.entryUrlIcon}>
                                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" />
                                  </svg>
                                </span>
                                <div>
                                  <p class={styles.entryMemoClamp}>{row.entry.title}</p>
                                  <p class={styles.entryDomain}>{row.entry.domain}</p>
                                </div>
                              </div>
                            )}
                            {row.entry.type === "text" && (
                              <Fragment>
                                <div class={styles.entryKind}>
                                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M6 3h9l4 4v14H6z" />
                                    <path d="M9 12h7M9 16h7" />
                                  </svg>
                                  テキスト
                                </div>
                                <p class={styles.entryMemoClamp}>{row.entry.text}</p>
                              </Fragment>
                            )}
                          </div>
                        )}
                      </div>
                    ),
                  )}
                </div>
              </div>

              <div data-tab-panel="notes" class={styles.panel} style="display: none">
                <div class={styles.notesHead}>
                  <span class={styles.panelLabel}>あなたのまとめ</span>
                  <span class={styles.notesUpdated}>{session.notesUpdatedLabel}</span>
                </div>
                <div class={styles.notesCard}>
                  {session.notes.length > 0 ? (
                    session.notes.map((line) => <p>{line}</p>)
                  ) : (
                    <p class={styles.placeholder}>ここに、自分の言葉でまとめを書けます。</p>
                  )}
                </div>
                <p class={styles.notesFooter}>この欄はあなただけが書きます。</p>
              </div>

              <div data-tab-panel="grow" class={styles.panel} style="display: none">
                <div class={styles.growHead}>
                  <span class={styles.notesUpdated}>AIの見立てです。違うこともあります。</span>
                  <span class={styles.notesUpdated}>{session.growUpdatedLabel}</span>
                </div>
                {session.growingQuestions.length === 0 ? (
                  <p class={styles.growEmpty}>まだ見つかっていません。追記がたまったら、また見に来てみてください。</p>
                ) : (
                  <Fragment>
                    <p class={styles.growSubheading}>今育っている問い</p>
                    {session.growingQuestions.map((q) => (
                      <div class={styles.growCard}>
                        <p class={styles.growQuestionText}>{q.text}</p>
                        <div class={styles.growMeta}>
                          {q.growing ? <span class={styles.growTag}>育っている</span> : <span class={styles.growTagIdle}>しばらく動いていない</span>}
                          {q.since && <span class={styles.notesUpdated}>{q.since}</span>}
                          <span class={styles.notesUpdated}>・ {q.fromSessionsLabel}</span>
                        </div>
                      </div>
                    ))}
                    {session.connectedRecord && (
                      <Fragment>
                        <p class={styles.growSubheading}>最近つながった記録</p>
                        <div class={styles.growCard}>
                          <div class={styles.growTags}>
                            {session.connectedRecord.tags.map((tag) => (
                              <span class={styles.growLinkedTag}>{tag}</span>
                            ))}
                          </div>
                          <p class={styles.growQuestionText}>{session.connectedRecord.text}</p>
                        </div>
                      </Fragment>
                    )}
                    {session.crossSessionInsight && (
                      <Fragment>
                        <p class={styles.growSubheading}>セッション横断で見えてきたこと</p>
                        <div class={styles.growCard}>
                          <p class={styles.notesUpdated}>{session.crossSessionInsight.sessionsLabel}</p>
                          <p class={styles.growQuestionText}>{session.crossSessionInsight.text}</p>
                        </div>
                      </Fragment>
                    )}
                  </Fragment>
                )}
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <div class={styles.screen} data-screen="edit" style="display: none">
      {
        editableEntries.map(({ entry }) => (
          <div class={styles.editPanel} data-entry-panel={entry.id} style="display: none">
            <div class={styles.editHeader}>
              <button type="button" aria-label="閉じる" class={styles.iconButton} data-close-edit>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 6l12 12M18 6L6 18" />
                </svg>
              </button>
              <div class={styles.editHeaderTitle}>記録を見る</div>
              <button type="button" class={styles.editDoneButton} data-close-edit>
                閉じる
              </button>
            </div>

            <div class={styles.editMeta}>
              <span class={styles.editKind}>{entry.type === "photo" ? `写真・${entry.count ?? 1}枚` : "手書き"}</span>
              <span class={styles.notesUpdated}>{entry.time}</span>
            </div>

            <div class={styles.editPreview}>
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                {entry.type === "photo" ? (
                  <Fragment>
                    <path d="M4 8h3l1.5-2h7L17 8h3v11H4z" />
                    <circle cx="12" cy="13.5" r="3.5" />
                  </Fragment>
                ) : (
                  <path d="M4 20l1.2-4.2L16.6 4.4a2 2 0 0 1 2.8 0l.2.2a2 2 0 0 1 0 2.8L8.2 18.8 4 20z" />
                )}
              </svg>
              <p class={styles.editPreviewCaption}>{entry.type === "photo" ? "写真のプレビュー（デモ）" : "手書きのプレビュー（デモ）"}</p>
            </div>

            <div class={styles.entryTabbar} role="tablist">
              <button type="button" role="tab" data-entry-tab-button="excerpt" class={styles.tabButton} aria-selected="true">
                抜粋
              </button>
              <button type="button" role="tab" data-entry-tab-button="comments" class={styles.tabButton} aria-selected="false">
                コメント
              </button>
              <button type="button" role="tab" data-entry-tab-button="connections" class={styles.tabButton} aria-selected="false">
                つながり
              </button>
            </div>

            <div data-entry-tab-panel="excerpt" class={styles.editSection}>
              {entry.excerpt ? (
                <p class={styles.excerptText}>{entry.excerpt}</p>
              ) : (
                <p class={styles.placeholder}>まだ書いていません。</p>
              )}
            </div>

            <div data-entry-tab-panel="comments" class={styles.editSection} style="display: none">
              <div class={styles.commentsList}>
                {entry.comments && entry.comments.length > 0 ? (
                  entry.comments.map((comment) => (
                    <div class={styles.commentRow}>
                      <p>{comment.body}</p>
                      <span class={styles.notesUpdated}>{comment.time}</span>
                    </div>
                  ))
                ) : (
                  <p class={styles.placeholder}>コメントはまだありません。</p>
                )}
              </div>
              <textarea class={styles.noteInput} placeholder="コメントを追加(このデモでは保存されません)"></textarea>
            </div>

            <div data-entry-tab-panel="connections" class={styles.editSection} style="display: none">
              {entry.connections && entry.connections.length > 0 ? (
                <div class={styles.connectionsList}>
                  {entry.connections.map((connection) =>
                    connection.href.startsWith("#entry:") ? (
                      <button
                        type="button"
                        class={styles.connectionLink}
                        data-open-entry={connection.href.replace("#entry:", "")}
                      >
                        {connection.label}
                      </button>
                    ) : (
                      <a class={styles.connectionLink} href={connection.href}>
                        {connection.label}
                      </a>
                    ),
                  )}
                </div>
              ) : (
                <p class={styles.placeholder}>つながりはまだありません。</p>
              )}
            </div>

            {entry.excerpt && (
              <button type="button" class={styles.editDoneButton} data-open-publish-preview={entry.id}>
                公開プレビューを見る →
              </button>
            )}
          </div>
        ))
      }
    </div>

    <div class={styles.screen} data-screen="publish" style="display: none">
      {
        publishableEntries.map(({ entry, session }) => (
          <div class={styles.editPanel} data-publish-panel={entry.id} style="display: none">
            <div class={styles.editHeader}>
              <button type="button" aria-label="閉じる" class={styles.iconButton} data-close-publish>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 6l12 12M18 6L6 18" />
                </svg>
              </button>
              <div class={styles.editHeaderTitle}>公開プレビュー</div>
              <button type="button" class={styles.editDoneButton} data-close-publish>
                閉じる
              </button>
            </div>

            <p class={styles.publishDemoNote}>デモです。実際には公開されません。</p>

            <div class={styles.editSection}>
              <p class={styles.panelLabel}>自分の考え</p>
              <p class={styles.excerptText}>{entry.comments?.[0]?.body ?? entry.excerpt}</p>
            </div>

            <div class={styles.editSection}>
              <p class={styles.panelLabel}>引用</p>
              <blockquote class={styles.publishQuoteBlock}>
                <p>{entry.excerpt}</p>
                {session.bookCitation && <cite>{session.bookCitation}</cite>}
              </blockquote>
            </div>

            {entry.connections && entry.connections.length > 0 && (
              <div class={styles.editSection}>
                <p class={styles.panelLabel}>関連記録</p>
                <div class={styles.connectionsList}>
                  {entry.connections.map((connection) => (
                    <span class={styles.connectionLink}>{connection.label}</span>
                  ))}
                </div>
              </div>
            )}
          </div>
        ))
      }
    </div>

    <button type="button" class={styles.bottomBar} data-open-sheet>
      <span class={styles.bottomBarDot} aria-hidden="true" />
      <span class={styles.bottomBarLabels}>
        <span class={styles.bottomBarCaption}>他の記録を見る</span>
        <span class={styles.bottomBarTitle} data-current-session-title>{sessions[0]?.title}</span>
      </span>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 15l6-6 6 6" />
      </svg>
    </button>

    <div class={styles.sheetWrap} data-sheet style="display: none">
      <button type="button" aria-label="閉じる" class={styles.sheetBackdrop} data-close-sheet />
      <div class={styles.sheet}>
        <div class={styles.sheetHandle} aria-hidden="true" />
        <p class={styles.sheetTitle}>他の記録を見る</p>
        {
          sessions.map((session) => (
            <button type="button" class={styles.sheetRow} data-pick-session={session.id}>
              <span class={styles.sheetTile}>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <path d={SESSION_ICON_PATHS[session.icon]} />
                </svg>
              </span>
              <span class={styles.sheetRowTitle} data-sheet-row-title>{session.title}</span>
              <span class={styles.sheetRowUpdated}>{session.updatedLabel}</span>
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <p class={styles.caption}>
    プロジェクトオーナーが構想している「記録を、たどれる・育てられるようにする」ためのツールの体験デモです。ここでの操作・記録・メモはこのページを離れると保存されません。
  </p>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-fieldnote-memo]").forEach((root) => {
    const sessionScreen = root.querySelector<HTMLElement>('[data-screen="session"]');
    const editScreen = root.querySelector<HTMLElement>('[data-screen="edit"]');
    const publishScreen = root.querySelector<HTMLElement>('[data-screen="publish"]');
    const bottomBar = root.querySelector<HTMLElement>("[data-open-sheet]");
    const sheet = root.querySelector<HTMLElement>("[data-sheet]");
    const currentTitleEl = root.querySelector<HTMLElement>("[data-current-session-title]");
    if (!sessionScreen || !editScreen || !publishScreen || !bottomBar || !sheet || !currentTitleEl) return;

    function activateTab(sessionBlock: HTMLElement, tabKey: string) {
      sessionBlock.querySelectorAll<HTMLElement>("[data-tab-button]").forEach((btn) => {
        btn.setAttribute("aria-selected", btn.dataset.tabButton === tabKey ? "true" : "false");
      });
      sessionBlock.querySelectorAll<HTMLElement>("[data-tab-panel]").forEach((panel) => {
        panel.style.display = panel.dataset.tabPanel === tabKey ? "" : "none";
      });
    }

    root.querySelectorAll<HTMLElement>("[data-tab-button]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const sessionBlock = btn.closest<HTMLElement>("[data-session]");
        const tabKey = btn.dataset.tabButton;
        if (sessionBlock && tabKey) activateTab(sessionBlock, tabKey);
      });
    });

    function openEntry(entryId: string) {
      sessionScreen!.style.display = "none";
      publishScreen!.style.display = "none";
      editScreen!.style.display = "";
      editScreen!.querySelectorAll<HTMLElement>("[data-entry-panel]").forEach((panel) => {
        panel.style.display = panel.dataset.entryPanel === entryId ? "" : "none";
      });
      bottomBar!.style.display = "none";
    }

    function closeEntry() {
      editScreen!.style.display = "none";
      sessionScreen!.style.display = "";
      bottomBar!.style.display = "";
    }

    root.querySelectorAll<HTMLElement>("[data-open-entry]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const entryId = btn.dataset.openEntry;
        if (entryId) openEntry(entryId);
      });
    });

    root.querySelectorAll<HTMLElement>("[data-close-edit]").forEach((btn) => btn.addEventListener("click", closeEntry));

    // 記録詳細内の「抜粋・コメント・つながり」タブ(2026-09-20、Decision Log 0190)。
    function activateEntryTab(panel: HTMLElement, tabKey: string) {
      panel.querySelectorAll<HTMLElement>("[data-entry-tab-button]").forEach((btn) => {
        btn.setAttribute("aria-selected", btn.dataset.entryTabButton === tabKey ? "true" : "false");
      });
      panel.querySelectorAll<HTMLElement>("[data-entry-tab-panel]").forEach((tabPanel) => {
        tabPanel.style.display = tabPanel.dataset.entryTabPanel === tabKey ? "" : "none";
      });
    }

    root.querySelectorAll<HTMLElement>("[data-entry-tab-button]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const panel = btn.closest<HTMLElement>("[data-entry-panel]");
        const tabKey = btn.dataset.entryTabButton;
        if (panel && tabKey) activateEntryTab(panel, tabKey);
      });
    });

    // 公開プレビューを見る(2026-09-20、Decision Log 0190)。
    function openPublishPreview(entryId: string) {
      editScreen!.style.display = "none";
      publishScreen!.style.display = "";
      publishScreen!.querySelectorAll<HTMLElement>("[data-publish-panel]").forEach((panel) => {
        panel.style.display = panel.dataset.publishPanel === entryId ? "" : "none";
      });
      bottomBar!.style.display = "none";
    }

    function closePublishPreview() {
      publishScreen!.style.display = "none";
      sessionScreen!.style.display = "";
      bottomBar!.style.display = "";
    }

    root.querySelectorAll<HTMLElement>("[data-open-publish-preview]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const entryId = btn.dataset.openPublishPreview;
        if (entryId) openPublishPreview(entryId);
      });
    });

    root
      .querySelectorAll<HTMLElement>("[data-close-publish]")
      .forEach((btn) => btn.addEventListener("click", closePublishPreview));

    function openSheet() {
      sheet!.style.display = "";
    }
    function closeSheet() {
      sheet!.style.display = "none";
    }

    bottomBar.addEventListener("click", openSheet);
    root.querySelectorAll<HTMLElement>("[data-close-sheet]").forEach((btn) => btn.addEventListener("click", closeSheet));

    root.querySelectorAll<HTMLElement>("[data-pick-session]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const sessionId = btn.dataset.pickSession;
        if (!sessionId) return;
        sessionScreen!.querySelectorAll<HTMLElement>("[data-session]").forEach((block) => {
          const active = block.dataset.session === sessionId;
          block.style.display = active ? "" : "none";
          if (active) activateTab(block, "trace");
        });
        const title = btn.querySelector<HTMLElement>("[data-sheet-row-title]")?.textContent?.trim();
        if (title) currentTitleEl!.textContent = title;
        closeSheet();
      });
    });
  });
</script>
