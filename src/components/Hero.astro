---
/**
 * Hero.astro
 * ------------------------------------------------------------
 * 役割: Homeの最初のセクション。役割は「研究内容」ではなく「空気」を
 * 伝えること(Design Spec 5)。左にコピー、右にVisual Fragment。
 * 実装元: Home_Hero_v1_mockup.png / Home_Hero_v1_spec.md
 *
 * レイアウト:
 * - Desktop: ビジュアル(渦のアートワーク)はDecision Log 0024で
 *   Home全体のposition: fixed背景に格上げされ、その後Decision Log
 *   0060で背景からも撤去された。Hero自体はコピーのみのシンプルな
 *   構成。
 * - Mobile: 以前はビジュアルをコピーの背景に重ねる「透かし」表現
 *   だったが(2026-08-15、Decision Log 0023)、Desktopの背景も
 *   アートワークなしの「夜空」のみになったこと(Decision Log 0085)
 *   に揃え、2026-09-04にMobileの透かしも撤去した(Decision Log
 *   0086)。現在はDesktop・Mobileともにコピーのみで、渦の
 *   アートワーク画像はHeroで使用していない。
 *
 * コンテンツ(コピー)はこのコンポーネント内にハードコードせず、
 * すべて props として呼び出し側(pages/index.astro)から渡す。
 * 「世界観・コピーは変更しない」方針のもと、コピー修正が発生した場合に
 * コンポーネントのロジックへ触れずに page 側だけで完結させるため。
 * ------------------------------------------------------------
 */
import styles from "./Hero.module.css";

interface Props {
  /** 見出し(複数行を配列で渡す。改行位置はコピーの意図そのものなので変更しない) */
  headingLines: string[];
  /** サブコピー(複数行) */
  bodyLines: string[];
}

const { headingLines, bodyLines } = Astro.props;
---

<section class={styles.hero} aria-label="ふ、とについて">
  <div class={styles.copy}>
    <h1 class={styles.heading}>
      {
        headingLines.map((line, i) => (
          <Fragment>
            {i > 0 && <br />}
            {line}
          </Fragment>
        ))
      }
    </h1>

    <div class={styles.body}>
      {bodyLines.map((line) => <p>{line}</p>)}
    </div>
  </div>
</section>
