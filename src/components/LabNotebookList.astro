---
/**
 * LabNotebookList.astro
 * ------------------------------------------------------------
 * 役割: 実験室(/participate)ランディングの、ノート/実験の一覧行を
 * 描画する。「いま、考えていること」(現状、全3冊がここに属する)と、
 * 将来追加する「いま、ひらいている実験」(実際に公開可能な音の道β/
 * Miro等ができた際、そのnotebookだけをこちらに移す)の両方から、
 * 同じ見た目・同じロジックで呼び出せるようにするため切り出した
 * (2026-09-16、Decision Log 0156)。
 *
 * カードUIにはせず、細い罫線区切りの縦リスト+ノートごとに異なる
 * 抽象的な「痕跡」(インラインSVG、装飾要素)で見せる(Decision Log
 * 0155を踏襲)。写真・生成画像は使わない。
 *
 * `descriptions`は、`labNotebooks.ts`の`description`(ノート詳細
 * ページの本文でも使う、より汎用的な説明文)とは別に、ランディング
 * 専用の短い説明文をこのページからpropsで渡す。理由:
 * 「いま、考えていること」の説明文は「完成・稼働を示唆する表現を
 * 避け、現在地に合う表現にする」という指示のもとに書き分けたもので、
 * `labNotebooks.ts`(ノート詳細ページと共有)を変更すると詳細ページの
 * 表示にも影響してしまうため、ランディングだけで完結する上書き値と
 * して扱う(`labNotebooks.ts`・`[slug].astro`は変更していない)。
 *
 * `ctaLabel`は呼び出し元が指定する(「いま、考えていること」では
 * 「ノートを見る」、将来の「いま、ひらいている実験」では「実験を
 * 見る」を想定)。
 *
 * 【モチーフを決定案3種に統一(2026-09-17、Decision Log 0159)】
 * プロジェクトオーナーから渡された決定イメージに基づき、3つの
 * モチーフをすべて描き直した。
 * - 音の道: 「立ち止まり、また歩き出す」= 一本線がゆるく進み、
 *   一度だけ小さくループしたのち前へ進む。始点・終点に小さな点。
 * - Fieldnote: 「点の記録が、あとから線になる」= 左側は散らばった点、
 *   右へ進むにつれ点が収束し、最後は一本の細い線として続く。
 * - 研究断面をひらく: 「重なっているところから、断面が見えてくる」=
 *   3本の有機的な線が中央付近で重なり、重なった部分だけごく淡い面
 *   (`.overlap`)が生まれる。線はその後もそれぞれ続く。
 * 3つとも同じviewBox(130×54)に揃え、線幅・点サイズ(r=2)・全体の
 * 見た目のサイズを統一した(以前は3:1/1:1/1.36:1とばらばらの比率
 * だった)。タイトルの右に添える形に配置が変わったことに伴い、
 * それぞれの図形自体も見出しの高さと釣り合う横長比率に描き直して
 * いる。
 *
 * 【中身が無いノートはリンクにしない(2026-09-26、Decision Log 0192)】
 * `hasDetailPage()`がfalseのノート(現状Fieldnote・研究断面をひらく)は、
 * `<a>`ではなく`<div>`で同じ見た目(category/title/description)だけを
 * 表示し、CTA(`ctaLabel`の文字列+矢印)も出さない。詳細ページ自体が
 * 存在しない([slug].astro参照)ため、リンク切れを作らない。
 * ------------------------------------------------------------
 */
import HomeMotion from "./HomeMotion.astro";
import styles from "./LabNotebookList.module.css";
import { hasDetailPage } from "@/data/labNotebooks";
import type { LabNotebook } from "@/types/labNotebook";

interface Props {
  notebooks: LabNotebook[];
  descriptions: Record<string, string>;
  ctaLabel: string;
}

const { notebooks, descriptions, ctaLabel } = Astro.props;

/** ノートごとの抽象的な「痕跡」(装飾要素、aria-hidden)。写真・生成
    画像は使わず、細い線のみで構成する。すべて同じ見た目にならない
    よう、ノートの性質(実験/アプリ/企画)に合わせて形を変えている。
    labNotebooks.ts側にデータを増やさず、このコンポーネント内で完結
    させる(装飾情報のため)。 */
const traces: Record<string, string> = {
  // 音の道: ゆるく進む一本線が、一度だけ小さくループしてから前へ進む。
  // 始点・終点に小さな点。停止記号や矢印、波形の反復はつくらない。
  "oto-no-michi": `<svg viewBox="0 0 130 54" aria-hidden="true"><path d="M8 40 C 26 22 38 28 50 30 C 60 34 60 16 50 16 C 40 16 38 28 50 32 C 66 36 88 26 108 16 T 122 12" /><circle cx="8" cy="40" r="2" /><circle cx="122" cy="12" r="2" /></svg>`,
  // Fieldnote: 左は散らばった点、右へ進むほど点が収束し、最後は
  // 一本の細い線として続く。最初からすべてを線でつながない。
  fieldnote: `<svg viewBox="0 0 130 54" aria-hidden="true"><circle cx="8" cy="42" r="2" /><circle cx="17" cy="16" r="2" /><circle cx="25" cy="36" r="2" /><circle cx="31" cy="10" r="2" /><circle cx="39" cy="26" r="2" /><circle cx="47" cy="20" r="2" /><circle cx="54" cy="23" r="2" /><path d="M54 23 C 66 19 80 17 94 18 T 122 12" /><circle cx="122" cy="12" r="2" /></svg>`,
  // 研究断面をひらく: 3本の有機的な線が中央付近で重なる。重なった
  // 部分だけ、ごく淡い面(.overlap)が生まれる。線はその後も個別に
  // 続く。本・ページ・窓のような説明的図形にはしない。
  "research-fragments": `<svg viewBox="0 0 130 54" aria-hidden="true"><path class="overlap" d="M50 24 C 58 12 72 14 78 22 C 86 28 82 40 70 38 C 58 40 44 34 50 24 Z" /><path d="M8 44 C 40 28 70 42 122 16" /><path d="M8 16 C 42 38 68 16 122 40" /><path d="M8 32 C 46 6 62 50 122 24" /></svg>`,
};
---

<ul class={styles.list}>
  {
    notebooks.map((notebook) => {
      const linked = hasDetailPage(notebook);
      const body = (
        <>
          <p class={styles.label}>{notebook.category}</p>
          <div class={styles.titleRow}>
            <h3 class={styles.title}>{notebook.title}</h3>
          </div>
          <p class={styles.description}>{descriptions[notebook.slug] ?? notebook.description}</p>
          {linked && (
            <span class={styles.readMore}>
              {ctaLabel} <span class={styles.arrow} aria-hidden="true">→</span>
            </span>
          )}
        </>
      );
      return (
        <li class={styles.item}>
          {linked ? (
            <a class={styles.link} href={`/participate/${notebook.slug}`} aria-label={`「${notebook.title}」の${ctaLabel}`}>
              {body}
            </a>
          ) : (
            <div class={styles.linkless}>{body}</div>
          )}
          <div class={styles.visual}>
            {notebook.slug === 'oto-no-michi' ? <HomeMotion kind="sound" /> : notebook.slug === 'fieldnote' ? <HomeMotion kind="question" /> : <span class={styles.trace} set:html={traces[notebook.slug]} />}
          </div>
        </li>
      );
    })
  }
</ul>
