---
/**
 * ResearchReviewArticle.astro
 * ------------------------------------------------------------
 * 役割: Research Review詳細ページ(研究断面01〜)の本文を表示する。
 * Design Spec v0.4のIA(Research > Reviews)に対応する詳細UI。
 * CLAUDE.md Parking Lotで「β公開まで実装しない」としていたが、
 * 研究断面01の公開に伴いこの1件に限って解禁した(2026-08-15、
 * Decision Log 0030)。02以降も同じコンポーネントを再利用する想定。
 *
 * 元原稿の構造(見出し→本文→箇条書き→表)をそのまま表示するための、
 * 最小限のコンテンツブロック方式を採用している(型はsrc/types/
 * researchReview.ts参照)。2026-08-15、研究断面01の本文改訂に合わせ
 * quote(引用・定義)・subheading(小見出し)・image(図版)を追加した
 * (Decision Log 0036)。
 *
 * 段落内の改行は、Research Statementで採用した「自然な折返しに
 * 任せる」方針(Decision Log 0026)を踏襲し、強制改行は入れていない。
 *
 * ResearchStatementと同様、コンテンツはpropsで受け取り、コンポーネント
 * 自体にはハードコードしない(Decision Log 0003の方針を踏襲)。
 *
 * 【2026-08-16追記】図版・表の回り込み配置(float)を試したが
 * (Decision Log 0038〜0040)、最終的にRowBlockで図版・表を横並びに
 * 配置する方式に落ち着いた(Decision Log 0041)。個々のブロックの
 * 描画はReviewContentBlock.astroに切り出し、セクション直下と
 * RowBlock内の両方から再利用している。
 *
 * 【1画面ずつ切り替えるページング(2026-09-04、Decision Log 0092)】
 * 「文字での説明を減らせないか」との指摘を受け、任意で`pagesOf`
 * (各画面に含むsection数の配列)を渡せるようにした。指定時は
 * sectionsをその単位でグループ化し、1画面ずつ表示を切り替える
 * (URLは変えない、`src/lib/pager.ts`。ResearchStatementと同じ
 * 仕組み)。省略時は従来通り全sectionを1画面に表示する。
 * ------------------------------------------------------------
 */
import ResearchSection from "./ResearchSection.astro";
import SectionTitle from "./SectionTitle.astro";
import ReviewContentBlock from "./ReviewContentBlock.astro";
import styles from "./ResearchReviewArticle.module.css";
import type { ReviewSection } from "@/types/researchReview";

interface Props {
  /** SectionTitleとして表示する英語ラベル(例: "Research Review") */
  sectionLabel: string;
  /** 例: "研究断面01" */
  title: string;
  subtitle?: string;
  sections: ReviewSection[];
  /**
   * 画面ごとのsection数(合計はsections.lengthと一致させる)。指定時は
   * この単位でsectionをグループ化し、1画面ずつ切り替えるページングを
   * 有効にする(Decision Log 0092)。省略時は全sectionを1画面に表示する。
   */
  pagesOf?: number[];
}

const { sectionLabel, title, subtitle, sections, pagesOf } = Astro.props;

const pages: ReviewSection[][] = pagesOf
  ? (() => {
      const result: ReviewSection[][] = [];
      let offset = 0;
      for (const size of pagesOf) {
        result.push(sections.slice(offset, offset + size));
        offset += size;
      }
      return result;
    })()
  : [sections];
---

<ResearchSection ariaLabel={title}>
  <SectionTitle>{sectionLabel}</SectionTitle>
  <h1 class={styles.title}>{title}</h1>
  {subtitle && <p class={styles.subtitle}>{subtitle}</p>}

  <div data-pager={pagesOf ? true : undefined}>
    <div class={styles.article}>
      {
        pages.map((pageSections) => (
          <div class={styles.page} data-pager-page tabindex="-1">
            {pageSections.map((section) => (
              <section class={styles.section}>
                <h2 class={styles.sectionHeading}>{section.heading}</h2>
                {section.blocks.map((block) =>
                  block.type === "row" ? (
                    <div class={styles.row}>
                      {block.items.map((item) => (
                        <ReviewContentBlock block={item} />
                      ))}
                    </div>
                  ) : (
                    <ReviewContentBlock block={block} />
                  ),
                )}
              </section>
            ))}
          </div>
        ))
      }
    </div>

    {
      pagesOf && (
        <div class={styles.pagerControls} data-pager-controls hidden>
          <button type="button" class={styles.pagerButton} aria-label="戻る" data-pager-prev>
            <span aria-hidden="true" class={styles.pagerArrowPrev}>←</span>
          </button>
          <span class={styles.pagerStatus} data-pager-status />
          <button type="button" class={styles.pagerButton} aria-label="次へ" data-pager-next>
            <span aria-hidden="true" class={styles.pagerArrowNext}>→</span>
          </button>
        </div>
      )
    }
  </div>
</ResearchSection>

<script src="../lib/pager.ts"></script>
