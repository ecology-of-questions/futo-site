---
import type { BookEntry } from "@/types/bookshelf";
interface Props { book: BookEntry }
const { book } = Astro.props;
const cover = book.image || book.externalCoverUrl || (book.isbn13 ? `https://covers.openlibrary.org/b/isbn/${book.isbn13}-M.jpg?default=false` : undefined);
---
<a class="home-book" href="/bookshelf" aria-label={`${book.title} — 本棚を見る`} data-tone={book.tone ?? "warm"}>
  <span class="home-book-type" aria-hidden="true"><span>{book.title}</span><small>{book.author}</small></span>
  {cover && <img src={cover} alt="" loading="lazy" decoding="async" width="160" height="240" data-home-cover />}
</a>
<style>
.home-book { display: block; container-type: inline-size; position: relative; aspect-ratio: 2 / 3; background: var(--home-book-warm); color: var(--color-ink); text-decoration: none; }
.home-book[data-tone="moss"] { background: var(--home-book-moss); }
.home-book[data-tone="sky"] { background: var(--home-book-sky); }
.home-book-type { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: space-between; padding: var(--space-2) var(--space-1); border-left: 3px double var(--color-accent-beige); }
.home-book-type > span { writing-mode: vertical-rl; align-self: center; font-size: var(--home-book-title); letter-spacing: var(--home-tracking); max-height: 75%; }
.home-book-type small { font-family: var(--font-sans); font-size: var(--home-book-author); line-height: var(--lh-body); text-align: center; }
.home-book img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; opacity: 0; }
.home-book[data-loaded] img { opacity: 1; }
.home-book[data-loaded] .home-book-type { visibility: hidden; }
.home-book:hover { outline: 1px solid var(--color-ink-muted); outline-offset: 4px; }
@container (max-width: 110px) {
 .home-book-type small { display: none; }
 .home-book-type > span { max-height: 100%; flex-shrink: 0; }
}
</style>
<script>
 document.querySelectorAll<HTMLImageElement>('[data-home-cover]').forEach((img) => {
   const reveal = () => { if (img.naturalWidth > 1) img.parentElement?.setAttribute('data-loaded', ''); };
   if (img.complete) reveal();
   else img.addEventListener('load', reveal, {once: true});
 });
</script>
