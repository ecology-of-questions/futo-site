---
/**
 * ResearchSection.astro
 * ------------------------------------------------------------
 * 役割: 「Research Statement」「今、取り組んでいること」等、
 * Homeを構成する各セクションの共通ラッパー。
 * Design Spec 11 Components: Research Block に対応。
 *
 * 余白・幅・landmarkなど、セクション共通のレイアウトルールを
 * ここに集約し、各セクション固有の中身はslotで受け取る。
 * Heroだけは独自レイアウト(左右分割)を持つため対象外。
 * ------------------------------------------------------------
 */
import styles from "./ResearchSection.module.css";

interface Props {
  ariaLabel?: string;
  id?: string;
}

const { ariaLabel, id } = Astro.props;
---

<section class={styles.section} aria-label={ariaLabel} id={id}>
  <slot />
</section>
