---
/**
 * ResearchStatement.astro
 * ------------------------------------------------------------
 * 役割: Homeの2番目のセクション。Design Spec 6(Section Roles)で
 * 「Research Statement＝思想」と定義されている。
 *
 * 【重要】このコンポーネントは「文章を受け取る器」である。
 * コンテンツ(attitudeLines / principleLines)は差し替えられることを
 * 前提としている。現在 index.astro から渡している文章
 * (Design Spec 7: Research Attitude / 8: Design Principles)は、
 * 正式なResearch Statement(「問いの生態系」のステートメント)が
 * 執筆されるまでの仮コンテンツである(Decision Log 0008参照)。
 * レイアウト・タイポグラフィ・余白は確定事項として扱ってよい。
 *
 * コンテンツはpropsで受け取り、コンポーネント自体には
 * ハードコードしない(Decision Log 0003の方針を踏襲)。
 * 正式なステートメントが届いたら、index.astro側のpropsを
 * 差し替えるだけで反映できる。
 * ------------------------------------------------------------
 */
import ResearchSection from "./ResearchSection.astro";
import SectionTitle from "./SectionTitle.astro";
import ArrowLink from "./ArrowLink.astro";
import styles from "./ResearchStatement.module.css";

interface Props {
  title: string;
  /** Design Spec 7: Research Attitude */
  attitudeLines: string[];
  /** Design Spec 8: Design Principles */
  principleLines: string[];
  /** Researchページ等、続きへの導線(回遊のため。Decision Log 0010) */
  linkLabel?: string;
  linkHref?: string;
}

const { title, attitudeLines, principleLines, linkLabel, linkHref } =
  Astro.props;
---

<ResearchSection ariaLabel={title} id="research-statement">
  <SectionTitle>{title}</SectionTitle>

  <div class={styles.statement}>
    <ul class={styles.list}>
      {attitudeLines.map((line) => <li>{line}</li>)}
    </ul>
    <ul class={styles.list}>
      {principleLines.map((line) => <li>{line}</li>)}
    </ul>
  </div>

  {
    linkLabel && linkHref && (
      <div class={styles.link}>
        <ArrowLink href={linkHref} label={linkLabel} />
      </div>
    )
  }
</ResearchSection>
