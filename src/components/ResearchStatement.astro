---
/**
 * ResearchStatement.astro
 * ------------------------------------------------------------
 * 役割: Homeの2番目のセクション。Design Spec 6(Section Roles)で
 * 「Research Statement＝思想」と定義されている。
 *
 * 【重要】このコンポーネントは「文章を受け取る器」である。
 * より正確には、「完成版を表示するための器」ではなく
 * 「最新版を表示するための器」である。Research Statementは
 * v0.1 → v0.2 → v1.0 と、Research Reviewや研究の進展とともに
 * 変化し続けることを前提とする(2026-08-04フィードバックより)。
 *
 * 現在の paragraphs props は「最新版を丸ごと差し替える」という
 * 使い方において、追加の実装なしでこの前提を満たしている。
 * バージョン履歴の保持・切り替えUI・変更履歴の表示等は、
 * β公開まで新機能を増やさない方針によりParking Lot
 * (Decision Log 0013参照)。
 *
 * 2026-08-04: Research Statement v0.1(First Draft)を受け、
 * propsの形を attitudeLines / principleLines(短文の2リスト)から
 * paragraphs(段落の配列、各段落は複数行の配列)へ作り直した
 * (Decision Log 0012)。散文としての改行・段落のリズムを
 * そのまま保持できるようにするため。v0.1は「まだ途中である」ことを
 * 明言した文章であり、今後も更新される前提。レイアウト・
 * タイポグラフィ・余白は確定事項として扱ってよいが、paragraphsの
 * 中身は今後も変わりうる。
 *
 * コンテンツはpropsで受け取り、コンポーネント自体には
 * ハードコードしない(Decision Log 0003の方針を踏襲)。
 *
 * 2026-08-07: Research Statement正式版を受け、`heading`(文章自体の
 * 見出し)を`title`(セクション共通の控えめなラベル。Decision Log 0007
 * の通りResearch Reviews等と同じ扱い)とは別に追加した(Decision Log
 * 0016)。titleは今まで通りSectionTitleとして小さく表示し、heading
 * は文章本文の一部として、段落より大きい見出しサイズで表示する。
 *
 * 【1画面ずつ切り替えるページング(2026-09-04、Decision Log 0092)】
 * 「文字での説明を減らせないか」との指摘を受け、段落数が多い場合に
 * 任意で`pagesOf`(各画面に含む段落数の配列)を渡せるようにした。
 * 指定時は段落をその単位でグループ化し、1画面ずつ表示を切り替える
 * (URLは変えない、`src/lib/pager.ts`)。省略時は従来通り全段落を
 * 1画面に表示する(Home抜粋での用途はこちら)。どの段落をどの画面に
 * まとめるかは文章の意味的な区切りに沿うため、コンポーネント側では
 * 判断せず、呼び出し側(ページ)がpagesOfとして指定する。
 * ------------------------------------------------------------
 */
import ResearchSection from "./ResearchSection.astro";
import SectionTitle from "./SectionTitle.astro";
import ArrowLink from "./ArrowLink.astro";
import styles from "./ResearchStatement.module.css";

interface Props {
  title: string;
  /** 文章自体の見出し(SectionTitleの控えめなラベルとは別。Decision Log 0016) */
  heading?: string;
  /** 段落の配列。各段落は複数行(改行位置はコピーの意図そのものなので変更しない) */
  paragraphs: string[][];
  /** Researchページ等、続きへの導線(回遊のため。Decision Log 0010・0011) */
  linkLabel?: string;
  linkHref?: string;
  /**
   * 画面ごとの段落数(合計はparagraphs.lengthと一致させる)。指定時は
   * この単位で段落をグループ化し、1画面ずつ切り替えるページングを
   * 有効にする(Decision Log 0092)。省略時は全段落を1画面に表示する。
   */
  pagesOf?: number[];
}

const { title, heading, paragraphs, linkLabel, linkHref, pagesOf } = Astro.props;

const pages: string[][][] = pagesOf
  ? (() => {
      const result: string[][][] = [];
      let offset = 0;
      for (const size of pagesOf) {
        result.push(paragraphs.slice(offset, offset + size));
        offset += size;
      }
      return result;
    })()
  : [paragraphs];
---

<ResearchSection ariaLabel={title} id="research-statement">
  <SectionTitle>{title}</SectionTitle>

  {heading && <p class={styles.heading}>{heading}</p>}

  <div data-pager={pagesOf ? true : undefined}>
    <div class={styles.statement}>
      {
        pages.map((pageParagraphs) => (
          <div class={styles.page} data-pager-page tabindex="-1">
            {pageParagraphs.map((lines) => (
              <p class={styles.paragraph}>
                {lines.map((line, i) => (
                  <Fragment>
                    {i > 0 && <br />}
                    {line}
                  </Fragment>
                ))}
              </p>
            ))}
          </div>
        ))
      }
    </div>

    {
      pagesOf && (
        <div class={styles.pagerControls} data-pager-controls hidden>
          <button type="button" class={styles.pagerButton} data-pager-prev>
            戻る
          </button>
          <span class={styles.pagerStatus} data-pager-status />
          <button type="button" class={styles.pagerButton} data-pager-next>
            次へ
          </button>
        </div>
      )
    }
  </div>

  {
    linkLabel && linkHref && (
      <div class={styles.link}>
        <ArrowLink href={linkHref} label={linkLabel} />
      </div>
    )
  }
</ResearchSection>

<script src="../lib/pager.ts"></script>
