---
/**
 * ResearchStatement.astro
 * ------------------------------------------------------------
 * 役割: Homeの2番目のセクション。Design Spec 6(Section Roles)で
 * 「Research Statement＝思想」と定義されている。
 *
 * 【重要】このコンポーネントは「文章を受け取る器」である。
 * より正確には、「完成版を表示するための器」ではなく
 * 「最新版を表示するための器」である。Research Statementは
 * v0.1 → v0.2 → v1.0 と、Research Reviewや研究の進展とともに
 * 変化し続けることを前提とする(2026-08-04フィードバックより)。
 *
 * 現在の paragraphs props は「最新版を丸ごと差し替える」という
 * 使い方において、追加の実装なしでこの前提を満たしている。
 * バージョン履歴の保持・切り替えUI・変更履歴の表示等は、
 * β公開まで新機能を増やさない方針によりParking Lot
 * (Decision Log 0013参照)。
 *
 * 2026-08-04: Research Statement v0.1(First Draft)を受け、
 * propsの形を attitudeLines / principleLines(短文の2リスト)から
 * paragraphs(段落の配列、各段落は複数行の配列)へ作り直した
 * (Decision Log 0012)。散文としての改行・段落のリズムを
 * そのまま保持できるようにするため。v0.1は「まだ途中である」ことを
 * 明言した文章であり、今後も更新される前提。レイアウト・
 * タイポグラフィ・余白は確定事項として扱ってよいが、paragraphsの
 * 中身は今後も変わりうる。
 *
 * コンテンツはpropsで受け取り、コンポーネント自体には
 * ハードコードしない(Decision Log 0003の方針を踏襲)。
 * ------------------------------------------------------------
 */
import ResearchSection from "./ResearchSection.astro";
import SectionTitle from "./SectionTitle.astro";
import ArrowLink from "./ArrowLink.astro";
import styles from "./ResearchStatement.module.css";

interface Props {
  title: string;
  /** 段落の配列。各段落は複数行(改行位置はコピーの意図そのものなので変更しない) */
  paragraphs: string[][];
  /** Researchページ等、続きへの導線(回遊のため。Decision Log 0010・0011) */
  linkLabel?: string;
  linkHref?: string;
}

const { title, paragraphs, linkLabel, linkHref } = Astro.props;
---

<ResearchSection ariaLabel={title} id="research-statement">
  <SectionTitle>{title}</SectionTitle>

  <div class={styles.statement}>
    {
      paragraphs.map((lines) => (
        <p class={styles.paragraph}>
          {lines.map((line, i) => (
            <Fragment>
              {i > 0 && <br />}
              {line}
            </Fragment>
          ))}
        </p>
      ))
    }
  </div>

  {
    linkLabel && linkHref && (
      <div class={styles.link}>
        <ArrowLink href={linkHref} label={linkLabel} />
      </div>
    )
  }
</ResearchSection>
