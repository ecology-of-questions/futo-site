---
/**
 * SectionTitle.astro
 * ------------------------------------------------------------
 * 役割: 各セクション(Research Statement / 今、取り組んでいること /
 * 研究断面 / 研究便り 等)共通の見出しコンポーネント。
 * Design Spec 11 Components: Section Title
 *
 * Heroの大きな見出しとは対照的に、セクション見出しは控えめな
 * ラベルとして扱う(余白・思考時間を優先する方針のため、
 * 各セクションの主役はコピー本文であって見出しではない)。
 * ------------------------------------------------------------
 */
import styles from "./SectionTitle.module.css";

interface Props {
  as?: "h1" | "h2" | "h3";
}

const { as: Tag = "h2" } = Astro.props;
---

<Tag class={styles.title}>
  <slot />
</Tag>
