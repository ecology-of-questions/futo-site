---
/**
 * BookshelfShelf.astro
 * ------------------------------------------------------------
 * 役割: 「研究の本棚」(/bookshelf)本体の表示。
 *
 * 【v0.1公開仕様への全面刷新(2026-09-16、Decision Log 0154)】旧
 * `BookshelfFullList.astro`を置き換え、「いま読んでいる」Hero区画+
 * status別の行リストという構成にした。その後、1画面フィットを狙った
 * タイトル行横並び化・1冊ずつ表示化(Decision Log 0164・0165)を経て、
 * 「見にくい」という指摘によりDecision Log 0166で0154の状態(Hero+
 * 行リスト)まで差し戻した。
 *
 * 【ブクログ風の書影グリッドに刷新(2026-09-17、Decision Log 0167〜
 * 0170)】その後、書影(実画像→Open Library Covers API→色面プレース
 * ホルダーの優先順位)を並べるグリッド表示を採用したが、以下の経緯で
 * テキストのみの行リストに戻した(2026-09-18、Decision Log 0179)。
 *
 * 【テキストのみの行リストに変更(2026-09-18、Decision Log 0179)】
 * プロジェクトオーナーから「表紙は見にくいかもしれない」という懸念の
 * 相談を受け、画像を入れた場合(3列グリッド)・プレースホルダーのみの
 * 場合(縦書きタイトル)双方のモックアップを検討した結果、色面カード・
 * 縦書きタイトルの表現をやめ、タイトル・著者だけを罫線区切りの1行
 * リストで見せる形に変更した。検討中、縦書きタイトルが`max-height`の
 * 制約で長いタイトル(例:「生きていること――動く、知る、記述する」)
 * において折り返し・重なりを起こす見た目の問題も見つかっており、今回の
 * 変更でこの問題も解消される。
 *
 * 書影(`book.image`・`book.externalCoverUrl`)・ISBN
 * (`book.isbn13`)・Open Library Covers APIからの取得・色面`tone`は、
 * このコンポーネントの表示からは使わなくなった。データ自体
 * (`src/data/bookshelf.ts`・`src/types/bookshelf.ts`)は削除していない
 * (実在する書誌情報であり、将来書影表示に戻す可能性のため)。
 *
 * 表紙タップ時の遷移先だった`purchaseUrl`(`src/config/site.ts`の
 * `buildPurchaseUrl`)は、行全体のリンク先としてそのまま引き継いでいる。
 * `purchaseUrl`が無い本の行はリンクにならない(存在しないリンクを
 * 作らない、実在するデータだけを見せる方針は維持)。
 *
 * `BookActions.astro`(購入リンク・この本から生まれた記録・
 * 「一緒に読みたい」フォーム)は、このコンポーネントからの呼び出しを
 * 止めただけで、ファイル自体・Formspree連携ロジックは削除していない
 * (Decision Log 0167の「一回」削除という判断を維持)。
 *
 * 【「この本にメモする」を撤回、公開読書メモの閲覧に置き換え
 * (2026-09-20、Decision Log 0186)】Decision Log 0185で追加した
 * 「この本にメモする →」(Fieldnote Readingの新規メモ導線)は撤回した。
 * 公開本棚は「本人が選んで公開した読書メモを読む場所」であり、訪問者が
 * 自分の読書メモを書き始める入口ではない、というプロジェクトオーナーの
 * 判断による。個人用Fieldnote Reading自体(本の紐づけ・過去の記録の
 * 絞り込み)はアプリ内に維持しており、`/fieldnote/`から直接使える。
 *
 * 代わりに、本人が明示的に公開した読書メモ(`src/data/publicReadingNotes.ts`、
 * 手動キュレーション、初期状態は空)がある本にだけ、`<details>`で
 * その場に展開する読み取り専用の「読書メモを読む」を表示する。公開
 * メモが無い本には何も表示しない(無効ボタン・0件バッジ・ダミーは
 * 置かない)。編集・削除・投稿にはつながっていない、静的な表示のみ。
 * ------------------------------------------------------------
 */
import styles from "./BookshelfShelf.module.css";
import { bookStatusLabels, type BookStatus, type BookEntry } from "@/types/bookshelf";
import { buildPurchaseUrl, isActiveAffiliateLink } from "@/config/site";
import { getPublicReadingNotesForBook } from "@/data/publicReadingNotes";

interface Props {
  books: BookEntry[];
}

const { books } = Astro.props;

function toRow(book: BookEntry) {
  return {
    book,
    href: buildPurchaseUrl(book),
    isAffiliate: isActiveAffiliateLink(book),
    notes: getPublicReadingNotesForBook(book.id),
  };
}

const rows = books.map(toRow);

/** 見出しは基本的にbookStatusLabelsを使うが、「reading」だけは
    このページ独自の「いま読んでいる」という表現を使う(既存の文言を
    変更しない)。 */
const headings: Record<BookStatus, string> = {
  ...bookStatusLabels,
  reading: "いま読んでいる",
};

/** 表示順は「いま読んでいる」を先頭に、以降は元のstatus表示順を踏襲する。
    実データが1冊以上あるstatusのみセクションとして表示する(架空の
    セクションを作らない)。 */
const statusOrder: BookStatus[] = ["reading", "queued", "wishlist", "finished", "gifted"];
const groups = statusOrder
  .map((status) => ({
    status,
    heading: headings[status],
    rows: rows.filter((row) => row.book.status === status),
  }))
  .filter((group) => group.rows.length > 0);

const hasAffiliateDisclosure = books.some((book) => isActiveAffiliateLink(book));
---

{
  groups.map((group, groupIndex) => (
    <div class={styles.section}>
      <h2 class={groupIndex === 0 ? styles.sectionHeading : `${styles.sectionHeading} ${styles.sectionRule}`}>
        {group.heading}
      </h2>
      <ul class={styles.textList}>
        {group.rows.map(({ book, href, isAffiliate, notes }) => {
          const titleLine = book.contributed ? `${book.title}(持ち寄られた本)` : book.title;
          return (
            <li class={styles.textRow}>
              {href ? (
                <a
                  class={styles.textLink}
                  href={href}
                  target="_blank"
                  rel={isAffiliate ? "noopener noreferrer sponsored" : "noopener noreferrer"}
                >
                  <span class={styles.textTitle}>{titleLine}</span>
                  <span class={styles.textAuthor}>{book.author}</span>
                </a>
              ) : (
                <div class={styles.textLink}>
                  <span class={styles.textTitle}>{titleLine}</span>
                  <span class={styles.textAuthor}>{book.author}</span>
                </div>
              )}
              {notes.length > 0 && (
                <details class={styles.readingNotes}>
                  <summary class={styles.readingNotesSummary}>読書メモを読む</summary>
                  <div class={styles.readingNotesBody}>
                    {notes.map((note) => (
                      <article class={styles.readingNote}>
                        <h3 class={styles.readingNoteTitle}>{note.title}</h3>
                        <p class={styles.readingNoteMeta}>{note.publishedAt}</p>
                        {note.image && <img class={styles.readingNoteImage} src={note.image} alt="" loading="lazy" />}
                        <p class={styles.readingNoteBodyText}>{note.body}</p>
                      </article>
                    ))}
                  </div>
                </details>
              )}
            </li>
          );
        })}
      </ul>
    </div>
  ))
}

{
  hasAffiliateDisclosure && (
    <p class={styles.affiliateDisclosure}>
      Amazonのアソシエイトとして、「ふ、と」は適格販売により収入を得ています。
    </p>
  )
}
