---
/**
 * support.astro (研究を支える)
 * ------------------------------------------------------------
 * 役割: ご支援（寄付）ページ。CLAUDE.md Parking Lotで「β公開後に
 * 着手する」としていた項目(Decision Log 0075)だったが、2026-09-10の
 * トップページ再設計に伴いプロジェクトオーナーが解禁を決定した
 * (Decision Log 0111)。トップページ(index.astro)の「研究を支える」
 * セクションの「継続支援・単発の支援について →」リンク先。
 *
 * 【支援の受け皿は未定】Decision Log 0075時点で「寄付の受け皿
 * (note内蔵のサポート機能/Buy Me a Coffee/Ko-fi等)自体がまだ固まって
 * いない」という課題が指摘されており、今回のトップページ再設計でも
 * この点は解決していない。決済・継続課金の仕組みを持つ実際の支援
 * ページを実装するには受け皿サービスの選定が必要なため、現時点では
 * 決済導線を実装せず、支援に関心がある人がContactページから連絡できる
 * 形にとどめている。受け皿が決まり次第、このページに実際の支援導線
 * (決済リンク等)を追加する想定。
 * ------------------------------------------------------------
 */
import DefaultLayout from "@layouts/DefaultLayout.astro";
import ResearchSection from "@components/ResearchSection.astro";
import ArrowLink from "@components/ArrowLink.astro";
import NightBackground from "@components/NightBackground.astro";
import styles from "./support.module.css";
---

<DefaultLayout title="研究を支える ｜ ふ、と" description="公開研究室「ふ、と」の研究を続けるための支援について。" theme="night">
  <NightBackground />
  <ResearchSection ariaLabel="Support">
    <p class={styles.eyebrow}>SUPPORT</p>
    <h1 class={styles.heading}>研究を支える</h1>
    <div class={styles.body}>
      <p>本を読み、観察し、記録する。「ふ、と」は、そうした地道な過程を続けることで成り立っている公開研究室です。</p>
      <p>
        継続的な支援・単発の支援のいずれも、現在受け付け方法を準備しています。関心のある方は、まずはお問い合わせからご連絡ください。
      </p>
    </div>
    <div class={styles.link}>
      <ArrowLink href="/contact" label="お問い合わせ" />
    </div>
  </ResearchSection>
</DefaultLayout>
