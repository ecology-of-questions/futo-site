---
/**
 * research.astro (Research)
 * ------------------------------------------------------------
 * β公開優先の方針に基づき、Aboutより先に実装したプレースホルダーページ。
 * 「この研究はこれから育っていく」という印象をβ公開時点で示すことが目的。
 *
 * 構成は、ChatGPTが例示した
 *   Research
 *     - Research Statement (Published)
 *     - Research Reviews (Review 01: Preparing)
 *     - Research Fragments (Coming Soon)
 * をそのまま実装した。
 *
 * 【要レビュー】このページのURL(/research)、見出し文言、
 * 3グループの構成・順序は実装上の提案であり、正式なIAではない。
 * Design Specにはまだ反映されていないため、確定版のIAが来た時点で
 * 調整する(Decision Log 0009参照)。
 *
 * Research Reviews部分は、既存のResearchCard(Decision Log 0004・0005)
 * をそのまま再利用している。
 * ------------------------------------------------------------
 */
import DefaultLayout from "@layouts/DefaultLayout.astro";
import ResearchSection from "@components/ResearchSection.astro";
import SectionTitle from "@components/SectionTitle.astro";
import ResearchCard from "@components/ResearchCard.astro";
import { researchStatusLabel } from "@/types/research";
import styles from "./research.module.css";
---

<DefaultLayout title="Research ｜ ふ、と">
  <ResearchSection ariaLabel="Research">
    <div class={styles.group}>
      <SectionTitle>Research Statement</SectionTitle>
      <div class={styles.groupBody}>
        <p class={styles.statementLine}>
          <a href="/#research-statement">Research Statement</a>
          <span class={styles.statusLabel}>{researchStatusLabel.published}</span>
        </p>
      </div>
    </div>

    <div class={styles.group}>
      <SectionTitle>Research Reviews</SectionTitle>
      <div class={styles.groupBody}>
        <ResearchCard
          title="Research Review 01"
          status="preparing"
          currentFocus="What is Inquiry?"
          lastUpdated="2026.xx.xx"
        />
      </div>
    </div>

    <div class={styles.group}>
      <SectionTitle>Research Fragments</SectionTitle>
      <div class={styles.groupBody}>
        <p class={styles.comingSoon}>Coming Soon</p>
      </div>
    </div>
  </ResearchSection>
</DefaultLayout>
