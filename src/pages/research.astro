---
/**
 * research.astro (Research)
 * ------------------------------------------------------------
 * β公開優先の方針に基づき、Aboutより先に実装したプレースホルダーページ。
 * 「この研究はこれから育っていく」という印象をβ公開時点で示すことが目的。
 *
 * 【IA修正(Decision Log 0011)】Research StatementはHomeに属する宣言であり、
 * Researchの一部ではない。そのため、当初実装していた「Researchページから
 * Research Statementへ戻る」導線は削除した。
 *
 *   Home
 *     └ Research Statement (Homeに属する宣言)
 *   Research
 *     ├ Reviews
 *     ├ Fragments
 *     └ Logs (未実装。将来追加時に検討)
 *
 * Home → Research Statement → Research が一本道の導線であり、
 * Researchページ内では Reviews / Fragments / Logs の行き来のみを扱う。
 *
 * 【要レビュー】このページのURL(/research)、見出し文言、
 * グループの構成・順序は実装上の提案であり、正式なIAではない。
 *
 * Research Reviews部分は、既存のResearchCard(Decision Log 0004・0005)
 * をそのまま再利用している。
 *
 * 【2026-08-15追記】研究断面01の公開に伴い、Research Review 01の
 * カードをpublished状態に更新し、詳細ページ(/research/reviews/01)
 * へのリンクを追加した(Decision Log 0030)。
 *
 * Logsは「β公開まで新機能は増やさない」方針により未実装(Parking Lot)。
 * ------------------------------------------------------------
 */
import DefaultLayout from "@layouts/DefaultLayout.astro";
import ResearchSection from "@components/ResearchSection.astro";
import SectionTitle from "@components/SectionTitle.astro";
import ResearchCard from "@components/ResearchCard.astro";
import styles from "./research.module.css";
---

<DefaultLayout title="Research ｜ ふ、と">
  <ResearchSection ariaLabel="Research">
    <div class={styles.group} id="research-reviews">
      <SectionTitle>Research Reviews</SectionTitle>
      <div>
        <ResearchCard
          title="研究断面01"
          status="published"
          currentFocus="「ふと」という日本語について"
          lastUpdated="2026.08.15"
          href="/research/reviews/01"
        />
      </div>
    </div>

    <div class={styles.group}>
      <SectionTitle>Research Fragments</SectionTitle>
      <div>
        <p class={styles.comingSoon}>Coming Soon</p>
      </div>
    </div>
  </ResearchSection>
</DefaultLayout>
