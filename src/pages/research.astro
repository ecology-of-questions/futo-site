---
/**
 * research.astro (Research)
 * ------------------------------------------------------------
 * β公開優先の方針に基づき、Aboutより先に実装したプレースホルダーページ。
 * 「この研究はこれから育っていく」という印象をβ公開時点で示すことが目的。
 *
 * 【IA修正(Decision Log 0011)】Research StatementはHomeに属する宣言であり、
 * Researchの一部ではない。そのため、当初実装していた「Researchページから
 * Research Statementへ戻る」導線は削除した。
 *
 *   Home
 *     └ Research Statement (Homeに属する宣言)
 *   Research
 *     └ 研究断面(Reviews/Fragmentsを統合。Decision Log 0033)
 *     └ Logs (未実装。将来追加時に検討)
 *
 * Home → Research Statement → Research が一本道の導線であり、
 * Researchページ内では 研究断面 / Logs の行き来のみを扱う。
 *
 * 【要レビュー】このページのURL(/research)、見出し文言、
 * 一覧の構成・順序は実装上の提案であり、正式なIAではない。
 *
 * 【2026-08-15追記(Decision Log 0033)】「研究断面01が、論文管理
 * システムのステータス画面のように見える」という指摘を受け、
 * 大きく作り直した。
 * - Research Reviews(ResearchCard、Status/Current Focus/Last
 *   Updatedという管理情報中心のカード)とResearch Fragments
 *   (「Coming Soon」の別セクション)を、「研究断面」という1つの
 *   シリーズの一覧に統合した。
 * - ResearchCardは廃止し、ResearchReviewListに置き換えた。
 *   公開済みのエントリはタイトル・サブタイトル・説明文・更新日を
 *   表示し、構想中のエントリは番号・タイトル・「(構想中)」のみの
 *   1行で表示する(将来の02, 03を先出しできるようにするため)。
 * - 「Published」という表示も、「研究は公開した瞬間に完成しない」
 *   という考え方に合わないという指摘を受け、Status行自体を廃止した
 *   (更新日のみを表示する形にした)。
 *
 * Logsは「β公開まで新機能は増やさない」方針により未実装(Parking Lot)。
 *
 * 【2026-08-17追記】01のsubtitleを、詳細ページ(reviews/01.astro)の
 * サブタイトル改訂に合わせて更新した(Decision Log 0049)。
 *
 * 【2026-08-17再追記(Decision Log 0054)】エントリが増えるとスクロール
 * 量が増え、リンクのクリック可能性も伝わりにくいという指摘を受け、
 * ResearchReviewListを「1行(番号+タイトル+更新日)+サブタイトル」の
 * コンパクトな行に作り替えた。説明文(description)は一覧から外し、
 * 型からも削除した。
 *
 * 【2026-08-17三度目の追記(Decision Log 0056)】行の右側に余白が
 * 生まれていたため、説明文(description)を2行までの要約として
 * 右側に復活させた。型にも再度追加した。
 *
 * 【夜空背景(2026-09-03、Decision Log 0063)】Homeで実装した「夜空」
 * 背景(紺+光の粒、Decision Log 0059〜0062)を、他ページにも揃える
 * 指示を受けてこのページにも適用した。DefaultLayoutにtheme="night"
 * を渡し、<NightBackground />を配置している。
 *
 * 【研究断面1.5の追加(2026-09-03、Decision Log 0068)】プロジェクト
 * オーナーから共有された原稿(PDF)をもとに、研究断面01と02のあいだに
 * 「1.5」を追加した。詳細ページはsrc/pages/research/reviews/1-5.astro
 * (URLは/research/reviews/1-5)。
 *
 * 【見出し下の説明文を1段落に統合(2026-09-04)】「観察し、記録し、
 * 対話し、つくり、また観察する。」「その過程を残していくための研究
 * ノート。」を、別々の`<p>`(強制的に改行される2行)から、1つの`<p>`
 * (自然な折返しに任せる1段落)に統合した。文章そのもの(語順・言葉遣い)
 * は変更していない。
 *
 * 【一覧を縦1カラムに作り直し(2026-09-04、Decision Log 0093)】
 * ResearchReviewList側の改訂に合わせ、見出し「研究断面」を
 * (見出しではない)<p>から、このページ固有の<h1>に変更した
 * (公開済み各記事のタイトルはResearchReviewList側でh2として実装)。
 *
 * 【見出し順序の修正(2026-09-05、Decision Log 0096のAboutページでの
 * 修正をResearch/Contactへ展開)】Eyebrow「RESEARCH」に
 * <SectionTitle>(h2)を使っていたため、「h2の直後にh1」という
 * 不自然な見出し順序になっていた。Aboutページで行った修正と同じ
 * 考え方で、Eyebrowを見出し要素ではないプレーンな<p>に変更し、
 * ページの最初の見出しがh1になるようにした(<SectionTitle>
 * コンポーネント自体は変更していない。他ページでの使用箇所は
 * このタスクの対象外)。
 * ------------------------------------------------------------
 */
import DefaultLayout from "@layouts/DefaultLayout.astro";
import ResearchSection from "@components/ResearchSection.astro";
import ResearchReviewList from "@components/ResearchReviewList.astro";
import NightBackground from "@components/NightBackground.astro";
import CursorGlow from "@components/CursorGlow.astro";
import styles from "./research.module.css";
import type {
  PlannedReviewEntry,
  PublishedReviewEntry,
} from "@/types/researchReviewListing";

const publishedReviews: PublishedReviewEntry[] = [
  {
    number: "01",
    title: "『ふと』という日本語",
    subtitle: "身体、知覚、記憶、思考を横断する言葉",
    description:
      "身体の動きを表していた「ふと」は、なぜ記憶や思考を表す言葉になったのか。辞書、古典文学、日本語研究を手がかりに、その意味の変遷をたどる。",
    updatedLabel: "2026.08.15 更新",
    href: "/research/reviews/01",
  },
  {
    number: "1.5",
    title: "なぜ私たちは、ある瞬間に「ふと」気づくのか",
    subtitle: "その手前にある経験と時間",
    description:
      "「ふと」気づく一瞬の手前には、どのような時間が折り重なっているのか。環世界論、文化的アフォーダンス、言語心理学、実践研究を手がかりに検討する。",
    updatedLabel: "2026.09.03 更新",
    href: "/research/reviews/1-5",
  },
];

const plannedReviews: PlannedReviewEntry[] = [
  { number: "02", title: "認識の変化と言語の生態系", stageLabel: "構想中" },
  { number: "03", title: "世界はどのように見えてくるのか", stageLabel: "構想中" },
];
---

<DefaultLayout title="Research ｜ ふ、と" theme="night">
  <NightBackground />
  <CursorGlow />
  <ResearchSection ariaLabel="Research" id="research-reviews">
    <p class={styles.eyebrow}>RESEARCH</p>
    <div class={styles.headingRow}>
      <h1 class={styles.heading}>研究断面</h1>
      <div class={styles.note}>
        <p>観察し、記録し、対話し、つくり、また観察する。その過程を残していくための研究ノート。</p>
      </div>
    </div>
    <ResearchReviewList published={publishedReviews} planned={plannedReviews} />
  </ResearchSection>
</DefaultLayout>
