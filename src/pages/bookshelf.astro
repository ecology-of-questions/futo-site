---
/**
 * bookshelf.astro (研究の本棚)
 * ------------------------------------------------------------
 * 役割: 「研究の本棚」の正式な本体ページ。トップページ(index.astro)の
 * 「研究の本棚」プレビューの「本棚を見る →」リンク先(2026-09-10、
 * トップページ再設計、Decision Log 0111)。
 *
 * 【2026-09-11、本体ページとしての役割を確立(Decision Log 0117)】
 * `/participate`側で「この本について話したい」「この本を贈る」を
 * 含む本棚UI(Decision Log 0115・0116)を作ったことで、「研究の本棚」
 * が`/bookshelf`と`/participate`の2箇所に分裂していた。プロジェクト
 * オーナーの指示により、`/bookshelf`を本の全一覧・statusフィルター・
 * 話したい・贈る・関連記録リンクを**すべて**集約する正式な本体ページと
 * 位置づけた。`/participate`は「本をプレゼントする」(旧「本から
 * 関わる」、2026-09-11にDecision Log 0128で改称)という短い入口
 * (featured本のみ+本体ページへのリンク)を残すのみになった。
 *
 * 本データは`src/data/bookshelf.ts`(唯一のデータソース、Home・
 * `/participate`と共有)、一覧UIは`BookshelfFullList.astro`(旧
 * `/participate`専用のParticipateBookshelf.astro、Decision Log 0116を
 * そのまま移設)を使う。見出し・導入文はDecision Log 0111時点のまま
 * 変更していない。
 *
 * 【トップページからプレビューを撤去(2026-09-11、Decision Log 0125)】
 * トップページを4層構成に絞る改訂により、上記の「研究の本棚」
 * プレビューはトップページから外れた。このページ自体・データ・
 * `/participate`との共有関係は変更していない。ヘッダー「本棚」からの
 * 導線は引き続きこのページへつながる。
 *
 * 【贈る導線をAmazonほしい物リストに一本化(2026-09-11、Decision Log
 * 0130)】`BookshelfFullList.astro`側の変更に伴い、「手元にある本を
 * 贈る」(お問い合わせ経由)を廃止したため、`contactHref` propを渡す
 * 必要がなくなった。
 *
 * 【HP公開版に向けて「話したい」「プレゼントする」を保留(2026-09-11、
 * Decision Log 0133)】`BookshelfFullList.astro`側の変更に伴い、
 * このページは当面「『ふ、と』が何を読んでいて、何を読みたいと
 * 思っているかを見る場所」に限定される。BOOKSHELF・「研究の本棚」・
 * 見出し文・フィルター・タイトル/著者/status/読みたい理由/image・
 * canonical bookshelf data(`src/data/bookshelf.ts`、6冊すべて)は
 * このページで変更していない。
 * ------------------------------------------------------------
 */
import DefaultLayout from "@layouts/DefaultLayout.astro";
import ResearchSection from "@components/ResearchSection.astro";
import BookshelfFullList from "@components/BookshelfFullList.astro";
import NightBackground from "@components/NightBackground.astro";
import styles from "./bookshelf.module.css";
import { books } from "@/data/bookshelf";
---

<DefaultLayout title="研究の本棚 ｜ ふ、と" description="公開研究室「ふ、と」で読んでいる本、これから読みたい本。" theme="night">
  <NightBackground />
  <ResearchSection ariaLabel="Bookshelf">
    <p class={styles.eyebrow}>BOOKSHELF</p>
    <h1 class={styles.heading}>研究の本棚</h1>
    <div class={styles.note}>
      <p>読んでいる本、これから読みたい本。</p>
    </div>
    <BookshelfFullList books={books} />
  </ResearchSection>
</DefaultLayout>
