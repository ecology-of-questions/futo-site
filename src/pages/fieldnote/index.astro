---
/**
 * src/pages/fieldnote/index.astro
 * ------------------------------------------------------------
 * Fieldnote Reading 最小プロトタイプ。
 *
 * 検証したいこと: 「読書を中断せず、気になったページを残せるか」。
 * ログイン/課金/ISBN検索/タグ/Apple Watch連携/集中モードのネイティブ
 * 連携は、この検証には不要なため実装しない(2026-09-02, Decision Log
 * 0066)。OCR(自動文字起こし)は2026-09-20時点でも未実装のまま
 * (Decision Log 0187、下記参照)。
 *
 * サイト全体のDefaultLayout(Header/Footer)は使わない。カメラ
 * プレビューを画面いっぱいに使う独立したツール画面であり、
 * Home「いま、取り組んでいること」からもまだリンクしていない
 * (制作・検証中、Decision Log 0066)。
 *
 * 保存処理(IndexedDbFieldnoteStore)・カメラ制御(FieldnoteCamera)・
 * 画面遷移/DOM配線(app.ts)は、すべて../../lib/fieldnote/に置く
 * (src/pages配下の.tsはAstroのファイルベースルーティングにより
 * サーバーエンドポイントとして扱われてしまうため、pages配下には
 * 置けない)。
 *
 * 【本棚との紐づけ・過去の記録一覧を追加(2026-09-20、Decision Log
 * 0185)】読書セッション開始時に本棚canonical dataから本を選べる
 * `<select>`(任意)、`/fieldnote/?book=<bookId>`での事前選択、
 * 「過去の記録」一覧(本での絞り込み)。
 *
 * 【抜粋・コメント・まとめ・公開プレビューを追加(2026-09-20、Decision
 * Log 0187)】指示書「Fieldnote読書記録と公開本棚の統合 v3」に基づき、
 * 以下を追加した。
 * - 写真を使わない「クイックメモ」(短文・URL)。読書セッションと同じ
 *   仕組み(1セッション1件)で保存する。
 * - 記録ごとの抜粋・ページの後編集、複数のコメント、他の記録・外部
 *   記録への手動のつながり。
 * - 複数の記録を手動でまとめる「まとめ」画面(`view-collections`)。
 * - 「書き出し/読み込み」(写真を含むJSONバックアップ)。
 * - 「公開プレビュー」(`view-publish`)。選んだ内容を公開用の形に
 *   整えて確認できる。
 *
 * 【OCR・本人限定の公開APIを追加(2026-09-20、Decision Log 0188・0189)】
 * - 写真記録に「文字を読み取る(実験的)」を追加した(Decision Log
 *   0188)。読み取り結果は抜粋欄への下書きに留まり、保存は既存の
 *   blur保存に委ねる。詳細・実測はDecision Log 0188参照。
 * - 公開プレビュー画面に、本人限定ログイン(`/api/admin/login`)+
 *   `/api/reading-notes`(Cloudflare Worker + D1)による実際の
 *   公開・更新・取り下げボタンを追加した(Decision Log 0189)。
 *   サーバー側のsecret設定が完了していない環境では、ログイン自体が
 *   fail closedで失敗する。その場合に備え、「この内容をコピーする」
 *   による手動反映(`src/data/publicReadingNotes.ts`への追記)も
 *   引き続き残している(フォールバック、最終形ではない)。
 *
 * 【撮影を止めずに連続撮影できるようにした(2026-09-20、Decision Log
 * 0192)】セッション開始時に「文字の向き」を選ぶ(本ごとに縦書き/
 * 横書きは一定という前提)。撮影は即座に保存され、OCRは
 * `../../lib/fieldnote/ocrQueue.ts`が裏で1件ずつ進める
 * (カメラは閉じない、次の撮影をブロックしない)。読み取り結果は
 * 「候補」のまま保持され、本人が採用操作をするまで抜粋・ページ欄は
 * 書き換わらない。実機(iPhone)でOCRが失敗した事例を受け、失敗時の
 * 表示は「ブラウザ非対応」への一括集約をやめ、どの段階
 * (コア読み込み/言語データ/初期化/認識実行)で失敗したかを具体的に
 * 示すようにした。詳細はDecision Log 0192参照。
 * ------------------------------------------------------------
 */
import "@styles/tokens.css";
import styles from "./index.module.css";
import { books } from "@/data/bookshelf";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta
      name="description"
      content="Fieldnote Reading: 読んだことを、日々とつなげて残す個人用ツール。"
    />
    <title>Fieldnote Reading ｜ ふ、と</title>
    <link rel="icon" type="image/svg+xml" href="/images/logo/favicon.svg?v=2" />
    <link rel="manifest" href="/fieldnote/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Fieldnote" />
    <meta name="theme-color" content="#f7f5ef" />
  </head>
  <body data-theme="editorial">
    <div id="fieldnote-app" class={styles.app}>
      <section id="view-setup" class={styles.setupView}>
        <a class={styles.back} href="/participate/fieldnote">← 実験室のノートへ</a>
        <p class={styles.eyebrow}>FIELDNOTE READING</p>
        <h1 class={styles.setupHeading}>読んでいる本</h1>
        <form id="setup-form" class={styles.setupForm}>
          <label class={styles.label} for="book-title-input">本のタイトル</label>
          <input
            id="book-title-input"
            class={styles.titleInput}
            type="text"
            placeholder="例: 存在と時間"
            autocomplete="off"
          />

          <label class={styles.label} for="book-select">本棚から選ぶ(任意)</label>
          <select id="book-select" class={styles.bookSelect}>
            <option value="">本を選ばない</option>
            {books.map((book) => (
              <option value={book.id}>{book.author ? `${book.title}／${book.author}` : book.title}</option>
            ))}
          </select>

          <div id="book-location-field" class={styles.locationField} hidden>
            <label class={styles.label} for="book-location-input">ページ・位置(任意)</label>
            <input
              id="book-location-input"
              class={styles.titleInput}
              type="text"
              placeholder="例: p.32-34、第2章"
              autocomplete="off"
            />
          </div>

          <label class={styles.label} for="ocr-orientation-select">文字の向き(撮影する本に合わせる)</label>
          <select id="ocr-orientation-select" class={styles.bookSelect}>
            <option value="horizontal">横書き</option>
            <option value="vertical">縦書き</option>
          </select>

          <button type="submit" class={styles.primaryButton}>写真で読書セッションを開始</button>
        </form>

        <div class={styles.quickEntry}>
          <p class={styles.quickEntryHeading}>写真を使わずに記録する(任意)</p>
          <label class={styles.label} for="quick-text-input">短い文章</label>
          <textarea
            id="quick-text-input"
            class={styles.textarea}
            rows="2"
            placeholder="気づいたこと、思ったこと"
          ></textarea>
          <label class={styles.label} for="quick-url-input">URL</label>
          <input id="quick-url-input" class={styles.titleInput} type="url" placeholder="https://..." autocomplete="off" />
          <label class={styles.label} for="quick-url-title-input">URLの見出し(任意)</label>
          <input id="quick-url-title-input" class={styles.titleInput} type="text" autocomplete="off" />
          <button type="button" id="quick-save-btn" class={styles.secondaryButton}>この内容を記録する</button>
        </div>

        <p id="setup-error" class={styles.setupError} hidden></p>

        <div class={styles.setupLinks}>
          <button type="button" id="open-history-btn" class={styles.historyLink}>過去の記録を見る →</button>
          <button type="button" id="open-collections-btn" class={styles.historyLink}>まとめを見る →</button>
        </div>

        <div class={styles.backupRow}>
          <button type="button" id="export-btn" class={styles.secondaryButton}>書き出す(バックアップ)</button>
          <label class={styles.secondaryButton} for="import-file-input">読み込む</label>
          <input id="import-file-input" type="file" accept="application/json" hidden />
        </div>
        <p id="backup-status" class={styles.backupStatus} role="status" aria-live="polite"></p>
        <p class={styles.publishNote}>
          端末内のデータは、この端末・このブラウザにのみ保存されます。他の端末とは自動で同期されません。「書き出す」で作ったファイルを、端末を変える前に保管してください。
        </p>
      </section>

      <section id="view-camera" class={styles.cameraView} hidden>
        <video id="camera-video" class={styles.video} playsinline autoplay muted></video>
        <div id="ocr-guide-frame" class={styles.guideFrame} aria-hidden="true"></div>
        <div id="shutter-flash" class={styles.shutterFlash}></div>

        <div class={styles.cameraTopBar}>
          <p id="session-title-label" class={styles.sessionTitleLabel}></p>
          <button type="button" id="end-session-btn" class={styles.endButton}>終了</button>
        </div>

        <p id="camera-error" class={styles.cameraError} hidden></p>

        <div class={styles.cameraBottomBar}>
          <div class={styles.shotCount}>
            <p id="shot-count">0枚</p>
          </div>
          <button
            type="button"
            id="capture-btn"
            class={styles.captureButton}
            aria-label="このページを保存"
          ></button>
          <span class={styles.spacer} aria-hidden="true"></span>
        </div>
      </section>

      <section id="view-list" class={styles.listView} hidden>
        <p class={styles.eyebrow}>FIELDNOTE READING</p>
        <h1 id="list-title" class={styles.listHeading}></h1>
        <p id="list-meta" class={styles.listMeta}></p>
        <button type="button" id="list-book-link" class={styles.bookLinkButton} hidden></button>
        <div id="entry-list" class={styles.entryList}></div>
        <button type="button" id="start-new-session-btn" class={styles.primaryButton}
          >新しい記録を始める</button
        >
        <div class={styles.setupLinks}>
          <button type="button" id="list-open-history-btn" class={styles.historyLink}>過去の記録を見る →</button>
          <button type="button" id="list-open-collections-btn" class={styles.historyLink}>まとめを見る →</button>
        </div>
      </section>

      <section id="view-history" class={styles.historyView} hidden>
        <p class={styles.eyebrow}>FIELDNOTE READING</p>
        <h1 class={styles.listHeading}>過去の記録</h1>
        <div class={styles.historyFilterRow}>
          <label class={styles.label} for="history-book-filter">本で絞り込む</label>
          <select id="history-book-filter" class={styles.bookSelect}>
            <option value="">すべて</option>
            {books.map((book) => (
              <option value={book.id}>{book.title}</option>
            ))}
          </select>
        </div>
        <div id="history-list" class={styles.historyList}></div>
        <button type="button" id="history-back-btn" class={styles.primaryButton}>閉じる</button>
      </section>

      <section id="view-collections" class={styles.historyView} hidden>
        <p class={styles.eyebrow}>FIELDNOTE READING</p>
        <h1 class={styles.listHeading}>まとめ</h1>
        <div id="collections-list" class={styles.historyList}></div>

        <p class={styles.quickEntryHeading}>新しいまとめを作る</p>
        <label class={styles.label} for="collection-title-input">タイトル</label>
        <input id="collection-title-input" class={styles.titleInput} type="text" placeholder="例: 「経験」をめぐって" />
        <label class={styles.label} for="collection-picker">まとめに入れる記録(複数選択可)</label>
        <select id="collection-picker" class={styles.collectionPicker} multiple size="6"></select>
        <button type="button" id="collection-save-btn" class={styles.primaryButton}>まとめを保存する</button>
        <p id="collection-status" class={styles.backupStatus} role="status" aria-live="polite"></p>

        <button type="button" id="collections-back-btn" class={styles.historyLink}>閉じる</button>
      </section>

      <section id="view-publish" class={styles.historyView} hidden>
        <p class={styles.eyebrow}>FIELDNOTE READING</p>
        <h1 class={styles.listHeading}>公開プレビュー</h1>
        <p class={styles.publishNote}>
          選んだ内容だけが公開の対象です。写真そのもの・OCRの生データ・非公開のコメントは含まれません。
        </p>

        <label class={styles.label} for="publish-reflection">自分の考え(公開されます)</label>
        <textarea id="publish-reflection" class={styles.textarea} rows="3"></textarea>

        <label class={styles.checkboxRow}>
          <input type="checkbox" id="publish-quote-toggle" />
          本文の引用を含める
        </label>
        <div id="publish-quote-fields" class={styles.locationField} hidden>
          <label class={styles.label} for="publish-quote">引用(本文からそのまま)</label>
          <textarea id="publish-quote" class={styles.textarea} rows="3"></textarea>
          <p id="publish-citation" class={styles.publishCitation}></p>
        </div>

        <p class={styles.quickEntryHeading}>関連記録(サイト内のものだけ選べます)</p>
        <div id="publish-related-list"></div>

        <label class={styles.label} for="publish-output">公開用データ(確認してから使ってください)</label>
        <pre id="publish-output" class={styles.publishOutput}></pre>

        <div id="publish-admin-section" class={styles.publishAdmin}>
          <p class={styles.quickEntryHeading}>本棚へ反映する(本人限定)</p>

          <div id="publish-login-block">
            <label class={styles.label} for="publish-admin-password">パスワード</label>
            <input
              id="publish-admin-password"
              type="password"
              class={styles.titleInput}
              autocomplete="current-password"
            />
            <button type="button" id="publish-login-btn" class={styles.secondaryButton}>ログイン</button>
          </div>

          <div id="publish-authed-block" hidden>
            <p id="publish-session-status" class={styles.backupStatus}></p>

            <div id="publish-existing-notes"></div>

            <button type="button" id="publish-submit-btn" class={styles.primaryButton}>この内容を公開する</button>
            <button type="button" id="publish-logout-btn" class={styles.historyLink}>ログアウト</button>
          </div>

          <p id="publish-admin-status" class={styles.backupStatus} role="status" aria-live="polite"></p>
        </div>

        <button type="button" id="publish-copy-btn" class={styles.secondaryButton}>この内容をコピーする</button>
        <p id="publish-copy-status" class={styles.backupStatus} role="status" aria-live="polite"></p>
        <p class={styles.publishNote}>
          上の「公開する」が使えない場合(サーバー側の設定が未完了な環境など)は、コピーした内容を運営が確認のうえ手動で本棚に反映します。
        </p>

        <button type="button" id="publish-back-btn" class={styles.historyLink}>閉じる</button>
      </section>
    </div>

    <script src="../../lib/fieldnote/app.ts"></script>
  </body>
</html>
