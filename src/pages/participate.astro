---
/**
 * participate.astro (実験室)
 * ------------------------------------------------------------
 * 役割: 「ふ、と」がいまつくっているものを、3冊のノートの表紙として
 * 並べる入口ページ。URLは引き続き`/participate`(2026-09-11に
 * 「持ち寄る」→「実験室」へ改称した際にDecision Log 0139で決めた
 * 方針を維持。過去の履歴・被リンクを保つため変更していない)。
 *
 * 【これまでの経緯】
 * - Decision Log 0113〜0133: 「持ち寄る」として実装。「何かを持ち寄る」
 *   フォーム+「持ち寄られたもの」一覧。
 * - Decision Log 0139: 「実験室」に改称。「いま、考えていること」
 *   3件+共通の「ふと思い出したことを寄せる」フォーム+「持ち寄られた
 *   もの」一覧、という構成に変更。
 * - Decision Log 0140(このコミット): 「いま、つくっていることを
 *   ひらく3冊のノート」という構造に変更。3件を単なる一覧項目ではなく
 *   「ノートの表紙」として見せ、それぞれ`/participate/[slug]`という
 *   専用ページ(共通テンプレート、`src/pages/participate/[slug].astro`)
 *   に遷移する。各ノート内で「ふ、と」自身の記録・訪問者が書き残した
 *   ことが同じ時系列として積み重なる(交換ノートのような構成)ため、
 *   このページの「共通フォーム」「持ち寄られたもの」一覧は不要になり
 *   削除した(旧`src/data/contributions.ts`・
 *   `src/types/contributions.ts`は他に参照箇所が無くなったため削除
 *   した)。書き足すUIは各ノート詳細ページ側に実装している。
 *
 * データは`src/data/labNotebooks.ts`(`/participate`・
 * `/participate/[slug]`が共有、二重管理しない)。
 * ------------------------------------------------------------
 */
import DefaultLayout from "@layouts/DefaultLayout.astro";
import ResearchSection from "@components/ResearchSection.astro";
import NightBackground from "@components/NightBackground.astro";
import styles from "./participate.module.css";
import { labNotebooks } from "@/data/labNotebooks";
---

<DefaultLayout
  title="実験室 ｜ ふ、と"
  description="「ふ、と」がいまつくっているものを、3冊のノートとしてひらいています。"
  theme="night"
>
  <NightBackground />

  <ResearchSection ariaLabel="Lab" id="lab-hero">
    <p class={styles.eyebrow}>LAB</p>
    <h1 class={styles.heading}>実験室</h1>
    <div class={styles.body}>
      <p>ここでは、ツールや企画を、考えたり、つくったり、試したりしています。</p>
      <p>まだ形になる前から、その過程をノートとしてひらいています。</p>
      <p>読んで、ふと思い出したことがあれば、書き足してもらえたらうれしいです。</p>
    </div>
  </ResearchSection>

  <ResearchSection ariaLabel="いま、つくっていること" id="lab-notebooks">
    <h2 class={`${styles.sectionHeading} ${styles.sectionRule}`}>いま、つくっていること</h2>
    <div class={styles.notebookGrid}>
      {
        labNotebooks.map((notebook) => (
          <a class={styles.notebook} href={`/participate/${notebook.slug}`} aria-label={`「${notebook.title}」のノートをひらく`}>
            <span class={styles.cover} data-tone={notebook.tone}>
              <span class={styles.coverCategory}>{notebook.category}</span>
              <span class={styles.coverTitle}>{notebook.title}</span>
            </span>
            <span class={styles.notebookInfo}>
              <span class={styles.notebookDescription}>{notebook.description}</span>
              <span class={styles.notebookLink}>
                ノートをひらく <span class={styles.notebookLinkArrow} aria-hidden="true">→</span>
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </ResearchSection>
</DefaultLayout>
