---
/**
 * participate.astro (持ち寄る)
 * ------------------------------------------------------------
 * 役割: 「ふ、と」に持ち寄るための入口をまとめたページ。
 * プロジェクトオーナーからの指示(添付イメージ・各セクションの構成案)
 * に基づき新規実装した(Decision Log 0113)。日本語表記は当初「関わる」
 * だったが、2026-09-11にサイト全体で「持ち寄る」に変更した(Decision
 * Log 0125、URLは/participateのまま)。
 *
 * 【2026-09-11、本文コピーを確定版に差し替え(Decision Log 0114)】
 * 実装確認後にセッションのコンテキスト要約を挟んだ影響で、いったん
 * 本文を推測で再構成していたが、プロジェクトオーナーから確定済みの
 * 全文言の提示を受け、このコミットで一字一句差し替えた。
 *
 * 【2026-09-11、「本を贈る」中心から「研究の本棚」中心へ再編
 * (Decision Log 0116)】プロジェクトオーナーの指示により、「本を贈る」
 * 3冊固定の構造を、「ふ、とが今何を読み、何をこれから読み、どこへ
 * 関心を向けているのか」が見える「研究の本棚」に変更した。
 *
 * 【2026-09-11、本棚UIを/bookshelfに一本化(Decision Log 0117)】
 * フィルター・話したい・贈る機能付きの本棚UIが`/participate`と
 * `/bookshelf`の2箇所に分裂したため、`/bookshelf`を「研究の本棚」の
 * 正式な本体ページと位置づけ、フル機能はそちらに集約した。本データは
 * `src/data/bookshelf.ts`に一元化した(Home・`/bookshelf`と共有、
 * このページ専用のデータは持たない)。
 *
 * 【トップページ再設計に伴う改訂(2026-09-11、Decision Log 0125)】
 * PARTICIPATEの日本語表記を「関わる」から「持ち寄る」に変更した
 * (URLは/participateのまま)。
 *
 * 【ページ全体を再構成(2026-09-11、Decision Log 0128)】プロジェクト
 * オーナーから、「参加方法をたくさん並べるページ」ではなく「さまざま
 * な人が持っているものを『ふ、と』に持ち寄り、公開できるものは他の
 * 人とも共有されていく場所」への再構成指示を受けた。
 *
 * 旧構成(Hero → 気になるものを寄せる → 本から参加する → 一緒に試す →
 * 話す → 場所・知識・技術を貸す → まとめ)を、以下に整理した。
 *
 *   1. Hero(スタンス表明+「持ち寄る」の考え方の短い説明)
 *   2. 何かを持ち寄る(旧「気になるものを寄せる」フォームを拡張。
 *      旧「場所・知識・技術を貸す」3カードの内容も、別カテゴリに
 *      分けず、この1つの入口に統合した。公開可否チェックボックスを
 *      追加)
 *   3. 持ち寄られたもの(新設。公開承認済みの投稿を
 *      `src/data/contributions.ts`から表示する。Formspreeからの自動
 *      取得・自動公開はしない、運営が手動でdataに追加するMVP)
 *   4. 本をプレゼントする(旧「本から参加する」を改称。featured本の
 *      表示・`/bookshelf`への導線は変更なし)
 *   5. まとめ(旧「一緒に試す」「話す」の独立カードは廃止し、
 *      「持ち寄られたものから話したり試したりすることがある」という
 *      1文に圧縮してこのセクションに統合した)
 *
 * 「紹介」(本や人を知らせる)と「提供」(場所や知識を貸す)を別々の
 * カテゴリに分けない、というのが今回の核心的な変更。データ構造・
 * Formspreeエンドポイント・honeypot等のスパム対策は既存のものを
 * そのまま再利用しており、新しいバックエンドやアカウント機能は
 * 追加していない。詳細はDecision Log 0128参照。
 * ------------------------------------------------------------
 */
import DefaultLayout from "@layouts/DefaultLayout.astro";
import ResearchSection from "@components/ResearchSection.astro";
import ArrowLink from "@components/ArrowLink.astro";
import BookshelfList from "@components/BookshelfList.astro";
import NightBackground from "@components/NightBackground.astro";
import styles from "./participate.module.css";
import { books } from "@/data/bookshelf";
import { contributions } from "@/data/contributions";
import { contributionTypeLabels } from "@/types/contributions";
import { contactFormEndpoint } from "@/config/site";

/** 「本をプレゼントする」に表示するfeatured本(Decision Log 0117)。 */
const featuredBooks = books.filter((book) => book.featured);

/** 公開承認済み(visible: true)の投稿のみ表示する(Decision Log 0128)。 */
const visibleContributions = contributions.filter((c) => c.visible);
---

<DefaultLayout
  title="持ち寄る ｜ ふ、と"
  description="「ふ、と」に持ち寄る、いくつかの方法。何かを持ち寄る、本をプレゼントする。"
  theme="night"
>
  <NightBackground />

  <ResearchSection ariaLabel="Participate" id="participate-hero">
    <div class={styles.hero}>
      <div class={styles.heroText}>
        <p class={styles.eyebrow}>PARTICIPATE</p>
        <h1 class={styles.heading}>持ち寄る</h1>
        <div class={styles.body}>
          <p>「ふ、と」では、自分とは異なる他者や、これまで知らなかった世界との出会いを大切にしたいと考えています。</p>
          <p>
            本や記事、人、場所、知識、経験。
            <br />
            何が新しい「ふと」のきっかけになるかは、まだわかりません。
            <br />
            ここでは、そんなものを持ち寄ることができます。
          </p>
        </div>
      </div>
      <div class={styles.heroPanel} aria-hidden="true"></div>
    </div>
  </ResearchSection>

  <ResearchSection ariaLabel="何かを持ち寄る" id="contribute">
    <h2 class={`${styles.sectionHeading} ${styles.sectionRule}`}>何かを持ち寄る</h2>
    <p class={styles.sectionBody}>
      本や記事、人、場所、知識、経験など、「ふ、と」に届けたいものがあれば教えてください。
      <br />
      「これを知ってほしい」「これが使えるよ」でも構いません。
    </p>

    <form class={styles.form} method="POST" action={contactFormEndpoint} data-contribution-form>
      <input type="text" name="_gotcha" class={styles.honeypot} tabindex="-1" autocomplete="off" aria-hidden="true" />
      <input type="hidden" name="_subject" value="ふ、と｜何かを持ち寄る" />
      <input type="hidden" name="public_ok" value="no" data-contribution-public-ok-value />

      <div class={styles.field}>
        <label class={styles.label} for="contribution-target"
          >持ち寄りたいものの名前 / URL <span class={styles.required}>必須</span></label
        >
        <input class={styles.input} type="text" id="contribution-target" name="target" required />
      </div>

      <div class={styles.field}>
        <label class={styles.label} for="contribution-note"
          >どんなものか、なぜ「ふ、と」に届けたいと思ったか <span class={styles.optional}>任意</span></label
        >
        <textarea class={styles.textarea} id="contribution-note" name="note" rows="4"></textarea>
      </div>

      <div class={styles.field}>
        <label class={styles.label} for="contribution-name">お名前 <span class={styles.optional}>任意</span></label>
        <input class={styles.input} type="text" id="contribution-name" name="name" autocomplete="name" />
      </div>

      <div class={styles.field}>
        <label class={styles.label} for="contribution-email"
          >メールアドレス <span class={styles.optional}>任意</span></label
        >
        <input class={styles.input} type="email" id="contribution-email" name="email" autocomplete="email" />
      </div>

      <div class={styles.checkboxField}>
        <input class={styles.checkbox} type="checkbox" id="contribution-public-ok" data-contribution-public-ok-checkbox />
        <label class={styles.checkboxLabel} for="contribution-public-ok"
          >この内容を、サイト上でみんなにも共有してよい</label
        >
      </div>
      <p class={styles.privacyNote}>
        チェックの有無にかかわらず、お名前やメールアドレスをサイト上で公開することはありません。内容を確認のうえ、運営がサイトに掲載します。
      </p>

      <button class={styles.submit} type="submit">持ち寄る <span aria-hidden="true">→</span></button>
      <p class={styles.status} data-contribution-status role="status" aria-live="polite"></p>
    </form>
  </ResearchSection>

  <ResearchSection ariaLabel="持ち寄られたもの" id="contributions">
    <h2 class={`${styles.sectionHeading} ${styles.sectionRule}`}>持ち寄られたもの</h2>
    <p class={styles.sectionBody}>
      ここに持ち寄られたもののうち、
      <br />
      公開してよいものを紹介しています。
    </p>
    {
      visibleContributions.length > 0 ? (
        <div class={styles.contributionList}>
          {visibleContributions.map((item) => (
            <div class={styles.contributionItem}>
              <p class={styles.contributionLabel}>{contributionTypeLabels[item.type]}</p>
              <h3 class={styles.contributionTitle}>{item.title}</h3>
              {item.note && <p class={styles.contributionBody}>{item.note}</p>}
              {item.url && (
                <div class={styles.contributionLink}>
                  <ArrowLink href={item.url} label="見る" external />
                </div>
              )}
            </div>
          ))}
        </div>
      ) : (
        <p class={styles.contributionEmpty}>
          まだ紹介できるものがありません。届いたものから、少しずつここに加えていきます。
        </p>
      )
    }
  </ResearchSection>

  <ResearchSection ariaLabel="本をプレゼントする" id="gift-books">
    <h2 class={`${styles.sectionHeading} ${styles.sectionRule}`}>本をプレゼントする</h2>
    <p class={styles.sectionBody}>
      研究の本棚には、これから読みたい本も置いています。
      <br />
      そのなかから、プレゼントしたいと思う本があれば贈ることができます。
    </p>
    <BookshelfList books={featuredBooks} />
    <div class={styles.link}>
      <ArrowLink href="/bookshelf" label="研究の本棚を見る" />
    </div>
  </ResearchSection>

  <ResearchSection ariaLabel="ともに、続けていくために" id="closing">
    <div class={styles.closing}>
      <div class={styles.closingPanel} aria-hidden="true" />
      <div class={styles.closingText}>
        <h2 class={`${styles.sectionHeading} ${styles.sectionRule}`}>ともに、続けていくために</h2>
        <div class={styles.sectionBody}>
          <p>持ち寄られたものから、誰かと話したり、一緒に何かを試したりすることがあります。</p>
          <p>
            これからも、気になることや感じたことを、
            <br />
            気軽にお知らせください。
          </p>
        </div>
        <div class={styles.link}>
          <ArrowLink href="/contact" label="お問い合わせ" />
        </div>
        <p class={styles.closingTagline}>
          それぞれのふとが、
          <br />
          研究をひらいていく。
        </p>
      </div>
    </div>
  </ResearchSection>
</DefaultLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-contribution-form]");
  const status = document.querySelector<HTMLElement>("[data-contribution-status]");
  const publicOkCheckbox = document.querySelector<HTMLInputElement>("[data-contribution-public-ok-checkbox]");
  const publicOkValue = document.querySelector<HTMLInputElement>("[data-contribution-public-ok-value]");

  if (form && status) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (publicOkCheckbox && publicOkValue) {
        publicOkValue.value = publicOkCheckbox.checked ? "yes" : "no";
      }

      const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      submitButton?.setAttribute("disabled", "true");
      status.textContent = "送信中...";

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });

        if (response.ok) {
          status.textContent = "送りました。ありがとうございます。";
          form.reset();
        } else {
          status.textContent = "送信に失敗しました。時間をおいて再度お試しください。";
        }
      } catch {
        status.textContent = "送信に失敗しました。通信環境をご確認のうえ再度お試しください。";
      } finally {
        submitButton?.removeAttribute("disabled");
      }
    });
  }
</script>
