---
/**
 * index.astro (Home)
 * ------------------------------------------------------------
 * Home_Hero_v1_mockup.png / Home_Hero_v1_spec.md に基づき Hero を実装済み。
 *
 * Research Statementは、Design Spec 7・8による仮コンテンツ→v0.1
 * (First Draft)を経て、2026-08-07に正式版へ差し替えた(Decision Log
 * 0016)。Homeには冒頭からの抜粋のみを掲載し、全文は独立ページ
 * `/research-statement` に掲載する(Home → Research Statement全文
 * → Research という一本道の導線をDesign Spec v0.4のIAに合わせて
 * 完成させた)。
 *
 * 以下の順で残りのセクションを追加していく(Design Spec 4: Home Structure)。
 *
 * 1. Hero                     ← 実装済み
 * 2. Research Statement(抜粋) ← 実装済み(正式版)
 * 3. 今、取り組んでいること     ← β公開では後回し可(優先度: README参照)
 * 4. 研究断面
 * 5. 研究便り
 * 6. Footer (DefaultLayout側で共通配置)
 *
 * β公開の優先順位(README「現在の方針: β公開優先」)では、
 * Home以降 About → Research(プレースホルダー) の順に進める。
 *
 * 【Desktop背景(2026-08-15、Decision Log 0024)】
 * 渦のアートワーク(VisualFragment)は、以前はHero内の右カラムに
 * 限定されていたが、Desktop幅ではHome全体(Hero〜Research Statement)
 * を貫くposition: fixed背景に変更した。HeroがDOM上の最初のセクション
 * であることに変わりはないため、Design Spec 4のHome Structure
 * (Hero → Research Statement → Footer)の順序・構成そのものは
 * 変更していない。あくまで「そのHero相当のビジュアルを、ページ全体の
 * 視覚的トーンとして拡張した」という位置づけ。Mobileでは変更せず、
 * Hero内蔵の透かし(Decision Log 0023)のまま。
 *
 * 【Desktop背景「夜空」化(2026-09-03、Decision Log 0059)】
 * プロジェクトオーナーの発案により、上記のDesktop背景を生成りの
 * 透かしから「夜空」に変更し、ふと現れて消える光の粒を追加した。
 * DefaultLayoutにtheme="night"を渡し、Desktop幅でmain/footer配下の
 * 文字色を反転させている(global.css参照)。Mobileでは変更なし。
 *
 * 【Desktop背景から画像を撤去(2026-09-03、Decision Log 0060)】
 * プロジェクトオーナーの指示により、上記「夜空」背景から渦の
 * アートワーク(VisualFragment)を外し、紺の背景と光の粒のみに
 * した。.background側での直接利用がなくなったためVisualFragmentの
 * importは削除したが、Hero側(Mobileの透かし表現、Decision Log
 * 0023)がvisualSrc propとして引き続き参照するため、heroVisualSrc
 * 自体は残している。
 *
 * 【他ページへの展開に伴うコンポーネント化(2026-09-03、Decision Log
 * 0063)】この「夜空」背景(紺の背景色+光の粒)を/research・/about・
 * /contactにも揃える指示を受け、NightBackground.astroとして切り出
 * した。以前ここに直接書いていた.background/.lights divは
 * <NightBackground />に置き換えている。
 *
 * 【「いま、取り組んでいること」文言改訂(2026-09-03、Decision Log
 * 0074)】プロジェクトオーナーの指示により、導入文・「問いの生態系」
 * ・「研究断面」の説明文を差し替えた。「研究断面」の説明文は2段落に
 * なったため、CurrentWorkItem.bodyの型をstringからstring[]に変更
 * した(CurrentWorkList.astro側も合わせて更新)。「Fieldnote（仮称）」
 * 項目の文言は今回の指示に含まれていないため変更していない。
 *
 * 【「Fieldnote（仮称）」項目の削除(2026-09-03、Decision Log 0077)】
 * プロジェクトオーナーの指示により、「Fieldnote（仮称）」への言及を
 * 全ページから削除することになったため、currentWorkItemsから
 * 「Practice」項目(上記0074時点では変更せず残していたもの)を
 * まるごと削除した。/fieldnote(Fieldnote Reading最小プロトタイプ、
 * Decision Log 0066)自体は今回の対象外で、引き続き公開している。
 *
 * 【カーソル追従の光(2026-09-03、Decision Log 0078)】プロジェクト
 * オーナーの提案により、カーソル位置の背景がじんわり光る演出
 * (CursorGlow)を試験的に追加した。まずHomeページのみに限定して
 * 試す(他ページへの展開は未定)。
 *
 * 【文言・改行の調整(2026-09-04、Decision Log 0080)】プロジェクト
 * オーナーの指示により、以下を変更した。
 * - 「研究断面」項目の説明文(1段落目)を「「ふと」という現象に
 *   関連してそのとき気になっていることを記録しています。」に差し替え
 * - Research Statement抜粋の一節を「自分との関わり方だけが少し
 *   変わる」から「世界と自分との関わり方が少し変わる」に修正
 *   (全文ページ`research-statement.astro`の同じ一節も合わせて修正)
 * - 「いま、取り組んでいること」導入文に、「観察しています。」の
 *   直後で改行(`<br />`)を1箇所追加
 *
 * 【夜空背景をMobileにも適用(2026-09-04、Decision Log 0085)】
 * プロジェクトオーナーの指示により、上記0059・0063でDesktop幅
 * (900px以上)限定にしていた<NightBackground />・文字色反転を
 * Mobileにも広げた。この時点ではHero内蔵の透かし(Decision Log
 * 0023)はそのまま残り、紺の背景の上に重ねて表示されていた。
 *
 * 【Hero内蔵の透かし画像を撤去(2026-09-04、Decision Log 0086)】
 * プロジェクトオーナーから「トップページの古い右側の画像はPC版同様
 * 削除して」との指示を受け、Mobile限定で残っていたHero内蔵の透かし
 * (渦のアートワーク、Decision Log 0023)を撤去した。Desktopは
 * Decision Log 0060で既に画像なしになっていたため、これで
 * Desktop・Mobileともに渦のアートワーク画像を一切使わない構成に
 * 揃った。heroVisualSrc・Hero側のvisualSrc/visualAlt propは不要に
 * なったため削除した(詳細はHero.astro参照)。
 *
 * 【「一緒に試す」(OPEN PRACTICE)セクション追加(2026-09-04、Decision
 * Log 0091)】プロジェクトオーナーの指示により、「いま、取り組んで
 * いること」の後・Footerの前に新セクションを追加した。「音の道」等の
 * 具体的な実践を使って、気づきや問いが立ち現れる状況を一緒につくり
 * 観察する活動への入口を示す。正式な参加者募集やサービス提供には
 * 見せず、関心が重なる人とまず対話するための入口という位置づけ。
 * 将来Practiceページ(音の道 等)が増えた際にリンクを追加しやすいよう、
 * openPracticeLinks配列としてリンクを持たせている。あわせてHero本文
 * 末尾の一文を「ふ、と は、そんな時間を届ける研究室です。」から
 * 「「ふ、と」は、そんな営みをひらいていく公開研究室です。」に修正した。
 *
 * 【Hero本文の短縮・OPEN PRACTICEの背景差別化(2026-09-04、Decision
 * Log 0094)】ChatGPT/Creative Directorから、Heroの4行がすぐ下の
 * Research Statement抜粋と内容が重なっているという指摘を受け、
 * プロジェクトオーナー確認のうえ2行に短縮した(文言はChatGPT提案を
 * 採用)。あわせて、「一緒に試す」セクションのみ、紺の背景に対して
 * ごく淡く明るい面(--color-nightをcolor-mixでわずかに明るくした
 * もの。新しいHEX値を決め打ちせず、既存トークンから算出している)を
 * 敷き、他のセクションと区別できる「独立した区画」として見せる
 * ようにした(プロジェクトオーナーの指示により、他セクションへの
 * 背景差別化は今回は見送り)。
 * ------------------------------------------------------------
 */
import DefaultLayout from "@layouts/DefaultLayout.astro";
import Hero from "@components/Hero.astro";
import ResearchStatement from "@components/ResearchStatement.astro";
import ResearchSection from "@components/ResearchSection.astro";
import SectionTitle from "@components/SectionTitle.astro";
import ArrowLink from "@components/ArrowLink.astro";
import CurrentWorkList from "@components/CurrentWorkList.astro";
import NightBackground from "@components/NightBackground.astro";
import CursorGlow from "@components/CursorGlow.astro";
import styles from "./index.module.css";
import type { CurrentWorkItem } from "@/types/currentWork";

const currentWorkItems: CurrentWorkItem[] = [
  {
    label: "Research",
    title: "問いの生態系",
    body: ["「ふと」という、人と世界との関係が変化する瞬間を観察し、その先で問いがどのように育っていくのかを探っています。"],
    linkLabel: "Research Statementを読む",
    linkHref: "/research-statement",
  },
  {
    label: "Research Review",
    title: "研究断面",
    body: [
      "「ふと」という現象に関連してそのとき気になっていることを記録しています。",
      "論文のような、検証結果や結論ではなく、後々変わりうるかもしれない考えも大切にしていきます。",
    ],
    linkLabel: "研究断面を見る",
    linkHref: "/research",
  },
];

/**
 * 「一緒に試す」(OPEN PRACTICE)セクションのリンク一覧(2026-09-04、
 * Decision Log 0091)。現時点ではお問い合わせへの導線1件のみだが、
 * 将来「音の道」等のPracticeページが増えた際に、この配列へ項目を
 * 追加するだけでリンクを増やせる構造にしている(currentWorkItemsと
 * 同じ考え方)。
 */
const openPracticeLinks = [{ label: "お問い合わせ", href: "/contact" }];
---

<DefaultLayout title="ふ、と ｜ 世界を観察するための、研究と実践" theme="night">
  <NightBackground />
  <CursorGlow />

  <Hero
    headingLines={["気づいたら、", "そこに問いがある"]}
    bodyLines={[
      "日常に生まれる小さな気づきを観察し、",
      "問いが育つ過程をひらく研究室です。",
    ]}
    ctaLabel="Research Statementを読む"
    ctaHref="#research-statement"
    scrollTargetId="research-statement"
  />

  <ResearchStatement
    title="Research Statement"
    heading="気づいたら、そこに問いがある"
    paragraphs={[
      [
        "いつもの道を歩いていたら、何度も通っていたはずの家が、",
        "その日だけ急に気になった。本を読んでいて、一つの言葉が、まったく別の出来事を思い出させた。料理をしているときに、「あれを足したらおいしくなるかもしれない」と、ふと思いついた。そんな経験はないでしょうか。",
      ],
      [
        "世界は昨日と変わっていないのに、世界と自分との関わり方が少し変わる。それまで見えていなかったものが見えたり、つながっていなかったものがつながったりする。",
      ],
    ]}
    linkLabel="Research Statement 全文を読む"
    linkHref="/research-statement"
  />
  <!--
    上記paragraphsはResearch Statement正式版からの抜粋(冒頭2段落、
    「そんな経験はないでしょうか。」まで)。全文はsrc/pages/research-
    statement.astroに掲載している。抜粋を冒頭2段落に短縮した経緯は
    Decision Log 0027参照(2026-08-15)。文章そのもの(語順・言葉遣い)
    は変更していない。
  -->

  <ResearchSection ariaLabel="いま、取り組んでいること" id="current-work">
    <h2 class={styles.currentWorkHeading}>いま、取り組んでいること</h2>
    <p class={styles.currentWorkIntro}>
      公開研究室「ふ、と」では、「ふと」という瞬間を手がかりに、問いがどのように立ち上がり、育っていくのかを観察しています。<br />
      リサーチ、記録、つくることを往復しながら、研究の過程をひらいていきます。
    </p>
    <CurrentWorkList items={currentWorkItems} />
  </ResearchSection>

  <ResearchSection ariaLabel="一緒に試す" id="open-practice">
    <div class={styles.openPracticePanel}>
      <SectionTitle>OPEN PRACTICE</SectionTitle>
      <h2 class={styles.openPracticeHeading}>一緒に試す</h2>
      <div class={styles.openPracticeBody}>
        <p>
          「ふ、と」では、日常のなかで何かが気になり、まだ言葉にならない感覚が問いへと育っていく過程を、観察、記録、対話、制作を通して探っています。
        </p>
        <p>
          現在、音や場所、歩くこと、身近なものなどを手がかりに、気づきが生まれる瞬間を一緒に観察する、小さな実践を準備しています。
        </p>
        <p>研究や制作の経験にかかわらず、関心の重なる方と、まずはお話しできたらと思います。</p>
      </div>
      <div class={styles.openPracticeLinks}>
        {openPracticeLinks.map((link) => <ArrowLink href={link.href} label={link.label} />)}
      </div>
    </div>
  </ResearchSection>
</DefaultLayout>
