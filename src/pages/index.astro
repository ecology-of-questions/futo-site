---
/**
 * index.astro (Home)
 * ------------------------------------------------------------
 * Home_Hero_v1_mockup.png / Home_Hero_v1_spec.md に基づき Hero を実装済み
 * だったが、2026-09-09にHeroとResearch Statementを統合した(下記
 * 【HeroとResearch Statementを統合】参照)。
 *
 * Research Statementは、Design Spec 7・8による仮コンテンツ→v0.1
 * (First Draft)を経て、2026-08-07に正式版へ差し替えた(Decision Log
 * 0016)。過去の変遷(全文掲載/抜粋掲載の切り替え)は複数回の
 * Decision Logにまたがっているため、直近の構成のみ以下に記す。
 *
 * 【トップページ再設計(2026-09-10、Decision Log 0111)】プロジェクト
 * オーナーから、「白ベースで余白の多い編集的なトップページ」への
 * 再設計指示(添付の理想イメージ・詳細な文案・デザインルール付き)を
 * 受けた。実装前に「変更対象ファイル・現在の構成・変更後の構成案・
 * 各セクションの変更前後の文章・新設セクション」の一覧を提示し、
 * 新設3セクション(研究の本棚・研究便り・研究を支える)がCLAUDE.mdの
 * Parking Lot(β公開まで新機能を増やさない方針)に抵触することを
 * 明示したうえで、プロジェクトオーナーに確認した。プロジェクトオーナー
 * は「3セクションとも今回実装する」と回答し、Parking Lotの方針転換を
 * 明示的に決定した(詳細はDecision Log 0111、CLAUDE.md/PROJECT.mdの
 * Parking Lot節参照)。
 *
 * 変更内容:
 * - Research Statementセクション: 全文(6段落)ではなく、冒頭2文の
 *   要約+「Research Statementを読む →」に変更。全文は独立ページ
 *   `/research-statement`として復活させた(2026-09-09、Decision Log
 *   0102で一度廃止していたもの)。
 * - 「研究の本棚」を新設。本の仮カード3件+一覧ページ`/bookshelf`。
 * - 「一緒に試す」: 本文を1文に短縮。独立区画としての背景面
 *   (Decision Log 0094)は撤去し、他の平場セクションと同じ扱いに
 *   戻した。
 * - 「研究便り」(メルマガ購読フォーム)・「研究を支える」(支援ページ
 *   への導線)を新設し、1つの背景面にまとめて配置した。
 * - 「いま、取り組んでいること」の見出し直前等、3セクションに細い
 *   上罫線を追加した。
 *
 * 【一部の変更を差し戻し(2026-09-10、Decision Log 0112)】上記の
 * 再設計案では、見出し末尾の句点「。」を復活させ(Decision Log 0108
 * で削除)、「Research｜問いの生態系」カードを復活させ(Decision Log
 * 0109で削除)、Headerの「ふ、とについて」表記への差し戻しも指示に
 * 含まれていた。プロジェクトオーナーから「(直近の変更である)
 * Decision Log 0108/0109の状態が正しい」との指摘を受け、この3点のみ
 * 元に戻した: 見出しは句点なし「気づいたら、そこに問いがある」の
 * まま、「問いの生態系」カードは表示せず「研究断面」1件のまま、
 * Headerは「公開研究室ふ、と」のまま。詳細はDecision Log 0112参照。
 *
 * 【「研究の本棚」のデータ元を一元化(2026-09-11、Decision Log 0117)】
 * `/participate`側で本棚UIが独自に拡張された結果、「研究の本棚」が
 * `/bookshelf`と`/participate`の2箇所に分裂したため、プロジェクト
 * オーナーの指示で`/bookshelf`を正式な本体ページと位置づけ、本データを
 * `src/data/bookshelf.ts`の1箇所に統合した。このページのプレビュー
 * (3件)は、以前はここに直接ハードコードしていたが、共有データから
 * `featured: true`の本を絞り込んで表示するよう変更した。見出し・
 * 導入文・カード自体の見た目(BookshelfList.astro)は変更していない。
 *
 * 【「研究を支える」→「関わる」に置き換え(2026-09-11、Decision Log
 * 0120)】プロジェクトオーナーの指示により、支援ページ(`/support`)を
 * 独立ページとして育てない方針に転換したため、このパネルを
 * 「関わる」(`/participate`へのリンク)に差し替えた。「研究便り」
 * パネルは変更していない。
 *
 * 【トップページを4層構成に整理(2026-09-11、Decision Log 0125)】
 * プロジェクトオーナーから、「初めて来た人が上から読むだけで、
 * 何を研究している場所か/今何を考えているか/自分も持ち込める場所か
 * が分かる」構成にする指示を受けた。トップページを「サイト内の
 * 全機能を紹介する場所」にしないという方針のもと、以下の4セクション
 * のみに絞った。
 *
 *   1. Research Statement(本文は変更なし)
 *   2. いま考えていること(旧「いま、取り組んでいること」。
 *      最新の研究断面1件のみを表示。データはsrc/data/
 *      researchReviews.tsから取得し、二重管理しない)
 *   3. 持ち寄る(旧「関わる」パネル。日本語表記を「持ち寄る」に
 *      変更、本文も1文に短縮。具体的な参加方法は列挙せず
 *      /participateへ委ねる)
 *   4. 研究便り(変更なし)
 *
 * 「研究の本棚」プレビュー・「一緒に試す」の独立セクションは
 * トップから削除した。どちらも機能・データ・独立ページ
 * (/bookshelf、お問い合わせ導線)自体は変更していない。ナビゲーション
 * からの入口(Header「本棚」等)もそのまま残している。
 * 「持ち寄る」「研究便り」は、引き続き1つの背景面(.panel)にまとめ、
 * 上記の順(持ち寄る→研究便り)に並べている。
 *
 * 以下、この変更より前の変遷(Hero統合・夜空背景・文章整理等)は、
 * このファイルのgit履歴および各Decision Logを参照。
 * ------------------------------------------------------------
 */
import DefaultLayout from "@layouts/DefaultLayout.astro";
import ResearchStatement from "@components/ResearchStatement.astro";
import ResearchSection from "@components/ResearchSection.astro";
import sectionTitleStyles from "@components/SectionTitle.module.css";
import ArrowLink from "@components/ArrowLink.astro";
import CurrentWorkList from "@components/CurrentWorkList.astro";
import NightBackground from "@components/NightBackground.astro";
import styles from "./index.module.css";
import type { CurrentWorkItem } from "@/types/currentWork";
import { publishedReviews } from "@/data/researchReviews";
import { contactFormEndpoint } from "@/config/site";

/**
 * 「いま考えていること」は、最新の研究断面1件のみを表示する
 * (2026-09-11、Decision Log 0125)。publishedReviewsは公開順
 * (古い→新しい)で並んでいるため、配列の末尾が最新記事になる。
 */
const latestReview = publishedReviews.at(-1)!;
const currentWorkItems: CurrentWorkItem[] = [
  {
    label: "Research Review",
    title: latestReview.title,
    body: [latestReview.description],
    linkLabel: "読む",
    linkHref: latestReview.href,
  },
];
---

<DefaultLayout title="ふ、と ｜ 世界を観察するための、研究と実践" theme="night">
  <NightBackground gradient />

  <ResearchStatement
    title="Research Statement"
    heading="気づいたら、そこに問いがある"
    headingLevel="h1"
    paragraphs={[
      [
        "いつも歩く道で、ある日ふと、ずっとそこにあったはずの建物の存在に気づく。",
      ],
      [
        "人と世界のあいだで問いが生まれ、育っていく過程を探っています。",
      ],
    ]}
    linkLabel="Research Statementを読む"
    linkHref="/research-statement"
  />

  <ResearchSection ariaLabel="いま考えていること" id="current-work">
    <h2 class={`${styles.currentWorkHeading} ${styles.sectionRule}`}>いま考えていること</h2>
    <CurrentWorkList items={currentWorkItems} />
  </ResearchSection>

  <ResearchSection ariaLabel="持ち寄る・研究便り" id="participate-newsletter">
    <div class={styles.panel}>
      <div class={styles.panelSection}>
        <p class={sectionTitleStyles.title}>PARTICIPATE</p>
        <h2 class={styles.panelHeading}>持ち寄る</h2>
        <p class={styles.panelBody}>
          「ふ、と」では、自分とは異なる他者や、これまで知らなかった世界との出会いを大切にしたいと考えています。
        </p>
        <div class={styles.panelLink}>
          <ArrowLink href="/participate" label="持ち寄る" />
        </div>
      </div>

      <div class={styles.panelSection}>
        <p class={sectionTitleStyles.title}>NEWSLETTER</p>
        <h2 class={styles.panelHeading}>研究便り</h2>
        <p class={styles.panelBody}>研究の更新や、最近気になっていることをメールでお届けします。</p>
        <form
          class={styles.newsletterForm}
          method="POST"
          action={contactFormEndpoint}
          data-newsletter-form
        >
          <input type="text" name="_gotcha" class={styles.honeypot} tabindex="-1" autocomplete="off" aria-hidden="true" />
          <input type="hidden" name="_subject" value="ふ、と 研究便り 登録希望" />
          <label class="sr-only" for="newsletter-email">メールアドレス</label>
          <input
            class={styles.newsletterInput}
            type="email"
            id="newsletter-email"
            name="email"
            placeholder="メールアドレス"
            autocomplete="email"
            required
          />
          <button class={styles.newsletterSubmit} type="submit">登録する</button>
        </form>
        <p class={styles.newsletterStatus} data-newsletter-status role="status" aria-live="polite"></p>
      </div>
    </div>
  </ResearchSection>
</DefaultLayout>

<style>
  /* Tailwind等を導入していないため、視覚的に隠しつつスクリーン
     リーダーには読ませる定番の.sr-onlyパターンをこの1箇所のためだけに
     インラインで定義している(メール欄のラベルを視覚的には
     placeholderに譲り、アクセシビリティ用のラベルとして残すため)。 */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-newsletter-form]");
  const status = document.querySelector<HTMLElement>("[data-newsletter-status]");

  if (form && status) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      submitButton?.setAttribute("disabled", "true");
      status.textContent = "送信中...";

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });

        if (response.ok) {
          status.textContent = "登録しました。ありがとうございます。";
          form.reset();
        } else {
          status.textContent = "登録に失敗しました。時間をおいて再度お試しください。";
        }
      } catch {
        status.textContent = "登録に失敗しました。通信環境をご確認のうえ再度お試しください。";
      } finally {
        submitButton?.removeAttribute("disabled");
      }
    });
  }
</script>
