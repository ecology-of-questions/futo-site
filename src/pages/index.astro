---
import DefaultLayout from "@layouts/DefaultLayout.astro";
import HomeMotion from "@components/HomeMotion.astro";
import HeroWalkerFigure from "@components/HeroWalkerFigure.astro";
import styles from "./index.module.css";
import { publishedReviews } from "@/data/researchReviews";
import { books } from "@/data/bookshelf";
import { labNotebooks } from "@/data/labNotebooks";
import { contactFormEndpoint } from "@/config/site";

const reviews = [...publishedReviews].reverse().slice(0, 2);
const reading = books.filter((book) => book.status === "reading").slice(0, 3);
const featured = labNotebooks.find((notebook) => notebook.slug === "oto-no-michi");
// Replace only this asset URL when the owner selects the main visual.
const featureImage: string | undefined = undefined;
// Owner-provided photo of the actual book spines; leave unset until supplied.
const bookshelfPhoto: string | undefined = undefined;
---

<DefaultLayout title="公開研究室ふ、と｜誰もが探究を続けられる場所へ"
  description="個人の探究をひらき、誰もがふらっと立ち寄り、ともに探究を深められる場です。" theme="editorial">
  <div class={styles.home}>
    <section class={styles.intro} aria-labelledby="home-title">
      <div class={styles.heroStage}>
        <h1 id="home-title" class={styles.heroHeading}>
          暮らしのなかで、<span class={styles.srOnly}>観察し、学び、試す。</span>
        </h1>
        {/* 「この場所について」を人物イラストの行と横並びにする
            (2026-09-27、Decision Log 0204)。以前は見出しの右にあり、
            動く人物イラストから離れていて分かりづらかったため。 */}
        <div class={styles.heroSceneWithAside}>
          <div class={styles.heroScene} aria-hidden="true">
            {/* デスクトップ・モバイル共通: 3姿勢を常に横並びで静止表示
                (2026-09-27、Decision Log 0196/0199)。モーションで人物が
                見えなくなる不具合を構造的に無くすため、姿勢ごとに固定の
                インスタンスを1つずつ置く。モバイル専用の「中央の1人が
                姿勢を切り替える」構成(Decision Log 0195)は撤去した。 */}
            <div class={styles.heroSceneRow}>
              <span class={styles.heroGroundLine}></span>
              <div class={styles.heroFigureCell}>
                <span class:list={[styles.heroWalker, styles.heroWalkerObserve]}><HeroWalkerFigure /></span>
                <span class={styles.heroCaption}>観察する</span>
              </div>
              <div class={styles.heroFigureCell}>
                <span class:list={[styles.heroWalker, styles.heroWalkerLearn]}><HeroWalkerFigure /></span>
                <span class={styles.heroCaption}>学ぶ</span>
              </div>
              <div class={styles.heroFigureCell}>
                <span class:list={[styles.heroWalker, styles.heroWalkerTry]}><HeroWalkerFigure /></span>
                <span class={styles.heroCaption}>試す</span>
              </div>
            </div>
          </div>
          <div class={styles.introAside}>
            <a class={styles.textLink} href="/about">この場所について <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </section>

    {/* 表示順は「研究断面/本棚」→「実験室」(2026-09-26、Decision Log 0190で入れ替え)。 */}
    <div class={styles.collections}>
      <section class={styles.research} aria-labelledby="research-title">
        <div class={styles.sectionHead}><h2 id="research-title">研究断面</h2><a href="/research">すべて読む <span aria-hidden="true">→</span></a></div>
        <div class={styles.reviews}>
          {reviews.map((review) => <article class={styles.review}>
            <span class={styles.reviewNumber} aria-hidden="true">{review.number}</span>
            <div><p class={styles.eyebrow}>研究断面 {review.number}</p>
              <h3><a href={review.href}>{review.title}</a></h3>
              <p class={styles.reviewSubtitle}>{review.subtitle}</p>
              <a class={styles.textLink} href={review.href}>続きを読む <span aria-hidden="true">→</span></a>
            </div>
          </article>)}
        </div>
      </section>
      <section class={styles.bookshelf} aria-labelledby="bookshelf-title">
        <div class={styles.sectionHead}><h2 id="bookshelf-title">本棚</h2><a href="/bookshelf">本棚へ <span aria-hidden="true">→</span></a></div>
        <p class={styles.sectionDescription}>読んでいる本、これから読みたい本。</p>
        <p class={styles.readingLabel}>いま読んでいる</p>
        {bookshelfPhoto ? <a class={styles.bookshelfPhoto} href="/bookshelf">
          <img src={bookshelfPhoto} alt={reading.map((book) => book.title).join("、") + "の背表紙。本棚を見る"} loading="lazy" />
        </a> : <ul class={styles.books}>
          {reading.map((book) => <li class={styles.bookRow}>
            <a class={styles.bookLink} href="/bookshelf">
              <span class={styles.bookTitle}>{book.title}</span>
              <span class={styles.bookAuthor}>{book.author}</span>
            </a>
          </li>)}
        </ul>}
      </section>
    </div>

    {featured && <section class:list={[styles.feature, !featureImage && styles.featureWithoutImage]} aria-labelledby="feature-title">
      <div class={styles.featureCopy}>
        <a class:list={[styles.eyebrow, styles.featureEyebrow]} href="/participate">実験室</a>
        <h2 id="feature-title">{featured.title}</h2>
        <p>散歩中の気づきを動きから辿る。</p>
        <div class={styles.soundMotion}><HomeMotion kind="sound" /></div>
        <a class={styles.textLink} href={`/participate/${featured.slug}`}>実験をのぞく <span aria-hidden="true">↗</span></a>
      </div>
      {featureImage && <a class={styles.featureVisual} href={`/participate/${featured.slug}`} aria-label={`${featured.title}のノートを開く`}>
        <img src={featureImage} alt="" width="960" height="640" fetchpriority="high" />
      </a>}
    </section>}

    <section class={styles.newsletter} aria-labelledby="newsletter-title">
      <div><p class={styles.eyebrow}>ふ、とからのお知らせ</p><h2 id="newsletter-title">研究便り</h2><p class={styles.sectionDescription}>研究便りを受け取る</p></div>
      <div class={styles.newsletterFields}>
        <form class={styles.newsletterForm} method="POST" action={contactFormEndpoint} data-newsletter-form>
          <input type="text" name="_gotcha" class={styles.honeypot} tabindex="-1" autocomplete="off" aria-hidden="true" />
          <input type="hidden" name="_subject" value="ふ、と 研究便り 登録希望" />
          <label class={styles.srOnly} for="newsletter-email">メールアドレス</label>
          <input class={styles.newsletterInput} type="email" id="newsletter-email" name="email" placeholder="メールアドレス" autocomplete="email" required />
          <button class={styles.newsletterSubmit} type="submit">登録する <span aria-hidden="true">→</span></button>
        </form>
        <p class={styles.newsletterStatus} data-newsletter-status role="status" aria-live="polite"></p>
      </div>
    </section>
  </div>
</DefaultLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-newsletter-form]");
  const status = document.querySelector<HTMLElement>("[data-newsletter-status]");

  if (form && status) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      submitButton?.setAttribute("disabled", "true");
      status.textContent = "送信中...";

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });

        if (response.ok) {
          status.textContent = "登録しました。ありがとうございます。";
          form.reset();
        } else {
          status.textContent = "登録に失敗しました。時間をおいて再度お試しください。";
        }
      } catch {
        status.textContent = "登録に失敗しました。通信環境をご確認のうえ再度お試しください。";
      } finally {
        submitButton?.removeAttribute("disabled");
      }
    });
  }
</script>
