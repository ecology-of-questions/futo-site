---
/**
 * index.astro (Home)
 * ------------------------------------------------------------
 * Home_Hero_v1_mockup.png / Home_Hero_v1_spec.md に基づき Hero を実装済み。
 * Research Statement は、Design Spec 7・8による仮コンテンツを経て、
 * 2026-08-04 に Research Statement v0.1(First Draft)へ差し替えた
 * (Decision Log 0012)。「まだ途中」であることを前提とした文章であり、
 * 今後の改訂は paragraphs 配列の書き換えだけで反映できる。
 * 以下の順で残りのセクションを追加していく(Design Spec 4: Home Structure)。
 *
 * 1. Hero                     ← 実装済み
 * 2. Research Statement       ← 実装済み(v0.1)
 * 3. 今、取り組んでいること     ← β公開では後回し可(優先度: README参照)
 * 4. 研究断面
 * 5. 研究便り
 * 6. Footer (DefaultLayout側で共通配置)
 *
 * β公開の優先順位(README「現在の方針: β公開優先」)では、
 * Home以降 About → Research(プレースホルダー) の順に進める。
 * ------------------------------------------------------------
 */
import DefaultLayout from "@layouts/DefaultLayout.astro";
import Hero from "@components/Hero.astro";
import ResearchStatement from "@components/ResearchStatement.astro";
---

<DefaultLayout title="ふ、と ｜ 世界を観察するための、研究と実践">
  <Hero
    headingLines={["気づいたら、", "そこに問いはある。"]}
    bodyLines={[
      "世界を、そっと観察する。",
      "小さな気づきを、ていねいに拾い集める。",
      "その積み重ねが、研究になり、実践になる。",
      "ふ、と は、そんな時間を届ける研究室です。",
    ]}
    ctaLabel="研究について知る"
    ctaHref="#research-statement"
    scrollTargetId="research-statement"
    visualAlt=""
  />
  <!--
    TODO: visualSrc は未指定(アセット未受領のためプレースホルダー表示)。
    hero_ai_v1.png 相当の画像ファイルを受け取り次第、
    /public/images/hero/ に配置し、visualSrc="/images/hero/hero_ai_v1.png" を指定する。
  -->

  <ResearchStatement
    title="Research Statement"
    paragraphs={[
      [
        "問いは、いつ生まれるのでしょうか。",
        "よく、「問いを立てる」と言います。",
        "問いは、本当に立てるものなのでしょうか。",
        "それとも、私たちが気づくより前から、すでに立ち上がり始めているものなのでしょうか。",
      ],
      ["この研究室は、その仮説を確かめるためにあります。"],
      [
        "そのために、",
        "暮らしを観察し、",
        "本を読み、",
        "手を動かし、",
        "人と対話しながら、",
        "考えを書き換え続けています。",
      ],
      [
        "ここにある文章やプロトタイプは、",
        "完成した答えではありません。",
        "その時点で見えていることを記録し、",
        "実践を通して更新していくための断面です。",
      ],
      [
        "考えが変わることも、",
        "仮説が覆ることも、",
        "この研究の一部だと考えています。",
      ],
      ["この研究は、まだ途中です。"],
    ]}
    linkLabel="研究の記録を見る"
    linkHref="/research#research-reviews"
  />
  <!--
    TODO: 上記paragraphsはResearch Statement v0.1(First Draft)。
    「まだ途中」であることが文章自体に明言されている通り、今後の
    改訂で差し替わる前提(改訂時もこの配列を書き換えるだけでよい)。
    段落の区切り方(どの行をどの<p>にまとめるか)はClaude側の実装判断。
    文章そのものは変更していない。
  -->
</DefaultLayout>
  <!--
    TODO: 上記のattitudeLines/principleLinesは仮コンテンツ(Design Spec 7・8)。
    正式なResearch Statement(「問いの生態系」のステートメント)が
    執筆され次第、この2つの配列を差し替える。レイアウト側の変更は不要。
  -->
</DefaultLayout>
