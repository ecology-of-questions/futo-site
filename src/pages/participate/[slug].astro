---
/**
 * [slug].astro (ノート詳細)
 * ------------------------------------------------------------
 * 役割: 「実験室」(/participate)の3冊のノートの詳細ページ。1つの
 * テンプレートファイルが`getStaticPaths`で3つのURL
 * (/participate/oto-no-michi、/participate/fieldnote、
 * /participate/research-fragments)を生成する(2026-09-13、Decision
 * Log 0140。プロジェクトオーナーの指示「3ページとも共通レイアウトを
 * 使い、中身だけデータで切り替えられる構造にする」に対応)。
 *
 * 【ノートの構成】
 *   1. 「← 実験室」(`/participate`への実リンク。ブラウザバックには
 *      依存しない)
 *   2. category(Eyebrow)・ノート名(h1)・「現在つくっているもの」
 *      (description)・共通のノート説明文(commonNotebookDescription)
 *   3. 「他のノートを見る」: 残り2冊への小さなテキストリンク
 *      (カルーセル・カード一覧にはしない)。
 *
 * 【交換ノート機能(「書かれたこと」一覧+「ふと思い出したことを
 * 書き残す」投稿フォーム)を撤去(2026-09-18)】3ノート共通のこの
 * テンプレートから、Decision Log 0141で追加した交換ノートUIを削除した
 * (プロジェクトオーナーの指示、Decision Log 0178参照)。
 * `POST/GET /api/notebooks/:slug/entries`のCloudflare Pages Function +
 * D1、および`src/data/labNotebooks.ts`の`entries`データ自体は
 * このコミットでは削除していない(Cloudflare連携設定の変更は別途の
 * 判断が必要なため)。
 *
 * 【Googleスライド埋め込み(2026-09-17、Decision Log 0171)】旧Miro
 * 埋め込み構想(コメントのみで実装は無かった)の置き換えとして、
 * ノート本文の前に、任意でGoogleスライドの区画を追加した。
 * `notebook.slidesEmbedUrl`が無いノートには区画自体を表示しない。
 *
 * 【スライドを主役にした初期表示(2026-09-17、Decision Log 0173)】
 * 「音の道」への実URL設定後、プロジェクトオーナーから「スクロールなしで
 * スライド全体が見えるレイアウトにしてほしい」との指示を受けた。
 * `slidesEmbedSrc`がある場合(現状「音の道」のみ)は、Hero+スライドを
 * 1つの縦flexコンテナ(`.heroViewport`)にまとめ、ヘッダー分を除いた
 * 画面の高さ(`min-height: calc(100dvh - var(--header-height) - ...)`)に
 * 収める。タイトル部分(`.heroTitle`)は内容に応じた自然な高さのまま、
 * スライド部分(`.slideArea`、`flex: 1 1 auto`)が残りの縦幅をすべて
 * 使い、その中で`aspect-ratio`+`max-height: 100%`を持つ
 * `.slidesEmbed`を中央揃えにすることで、縦横比を保ったまま画面の高さに
 * 収まるサイズへ自動的に縮小される(JSでの高さ計測は不要)。
 * 「この断面にコメントを置く」はスライド直下に、それ以外の説明文
 * (`description`・`commonNotebookDescription`)は初期表示の外
 * (スクロールした先の`#notebook-about`)に移した。
 *
 * `slidesEmbedSrc`が無いノート(現状Fieldnote・研究断面をひらく)は、
 * 従来通りのHero構成(縦積みのタイトル+説明文)のまま変更していない
 * (今回の指示は「音の道」ページが対象のため、スライドが無いノートの
 * 見た目は変えない判断)。
 * ------------------------------------------------------------
 */
import DefaultLayout from "@layouts/DefaultLayout.astro";
import ResearchSection from "@components/ResearchSection.astro";
import ArrowLink from "@components/ArrowLink.astro";
import styles from "./[slug].module.css";
import { labNotebooks, commonNotebookDescription } from "@/data/labNotebooks";
import type { LabNotebook } from "@/types/labNotebook";

export function getStaticPaths() {
  return labNotebooks.map((notebook) => ({
    params: { slug: notebook.slug },
    props: { notebook },
  }));
}

interface Props {
  notebook: LabNotebook;
}

const { notebook } = Astro.props;
const otherNotebooks = labNotebooks.filter((n) => n.slug !== notebook.slug);

/**
 * Googleスライドの埋め込み用URL(「ウェブに公開」で取得したもの)に、
 * 自動再生・ループを明示的に無効化するクエリを付加する。コピー元の
 * URLに`start`/`loop`が含まれていた場合も、ここで上書きする
 * (訪問者が自分のペースでページを送れるようにする、という指示への
 * 対応)。URLとして解釈できない値は、壊れたiframeを作らないよう
 * nullを返す(呼び出し側で区画自体を表示しない)。
 */
function buildSlidesEmbedSrc(rawUrl: string): string | null {
  try {
    const url = new URL(rawUrl);
    url.searchParams.set("start", "false");
    url.searchParams.set("loop", "false");
    return url.toString();
  } catch {
    return null;
  }
}

const slidesEmbedSrc = notebook.slidesEmbedUrl ? buildSlidesEmbedSrc(notebook.slidesEmbedUrl) : null;
---

<DefaultLayout title={`${notebook.title} ｜ 実験室 ｜ 公開研究室ふ、と`} description={notebook.description} theme="editorial">

  {
    slidesEmbedSrc ? (
      <ResearchSection ariaLabel={notebook.title} id="notebook-hero">
        <div class={styles.heroViewport}>
          <div class={styles.heroTitle}>
            <a class={styles.back} href="/participate">
              ← 実験室
            </a>
            <p class={styles.eyebrow}>{notebook.category}</p>
            <h1 class={styles.headingCompact}>{notebook.title}</h1>
          </div>
          <div class={styles.slideArea}>
            <div class={styles.slidesEmbed}>
              <iframe src={slidesEmbedSrc} title={`${notebook.title}のスライド`} loading="lazy" allowfullscreen />
            </div>
            {notebook.slidesCommentUrl && (
              <div class={styles.slidesComment}>
                <ArrowLink href={notebook.slidesCommentUrl} label="この断面にコメントを置く" external />
                <p class={styles.slidesCommentNote}>Googleスライドを開いてコメントできます。</p>
              </div>
            )}
          </div>
        </div>
      </ResearchSection>
    ) : (
      <ResearchSection ariaLabel={notebook.title} id="notebook-top">
        <a class={styles.back} href="/participate">
          ← 実験室
        </a>
        <p class={styles.eyebrow}>{notebook.category}</p>
        <h1 class={styles.heading}>{notebook.title}</h1>
        <p class={styles.lead}>{notebook.description}</p>
        <p class={styles.commonNote}>{commonNotebookDescription}</p>
      </ResearchSection>
    )
  }

  {
    slidesEmbedSrc && (
      <ResearchSection ariaLabel="このノートについて" id="notebook-about">
        <p class={styles.lead}>{notebook.description}</p>
        <p class={styles.commonNote}>{commonNotebookDescription}</p>
      </ResearchSection>
    )
  }

  <ResearchSection ariaLabel="他のノートを見る" id="notebook-others">
    <nav aria-label="他のノートを見る">
      <p class={styles.otherNotebooksLabel}>他のノートを見る</p>
      <ul class={styles.otherNotebooksList}>
        {
          otherNotebooks.map((other) => (
            <li>
              <a class={styles.otherNotebookLink} href={`/participate/${other.slug}`}>
                {other.title} <span aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </ResearchSection>
</DefaultLayout>
