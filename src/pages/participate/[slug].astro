---
/**
 * [slug].astro (ノート詳細)
 * ------------------------------------------------------------
 * 役割: 「実験室」(/participate)の3冊のノートの詳細ページ。1つの
 * テンプレートファイルが`getStaticPaths`で3つのURL
 * (/participate/oto-no-michi、/participate/fieldnote、
 * /participate/research-fragments)を生成する(2026-09-13、Decision
 * Log 0140)。
 *
 * 【交換ノート機能を撤去(2026-09-18、Decision Log 0178)】3ノート共通の
 * このテンプレートから、Decision Log 0141の交換ノートUIを削除済み。
 *
 * 【「散歩譜」(旧「音の道」)専用レイアウトへの刷新(2026-09-18、
 * Decision Log 0182)】プロジェクトオーナーが承認した「散歩譜＋支援」
 * 指示書v2に基づき、`slidesEmbedSrc`を持つノート(現状は散歩譜
 * (oto-no-michi)のみ)の表示を作り替えた。
 *
 * - 旧「スライドを1画面に収める」制約(Decision Log 0173、
 *   `.heroViewport`のmin-height計算)を撤去。スライドは常時表示の
 *   通常サイズの埋め込みに戻した(入口の要件にしない、という今回の
 *   意図的な変更)。
 * - 見出し・短い紹介文の直後に身体譜プレイヤー(WalkingScorePlayer)、
 *   続けて「途中の記録」(スライド常時埋め込み+コメントリンク)。
 * - PCでは身体譜+スライドの主列と、支援欄の副列を2カラムで並べる
 *   (`.layout`)。支援欄はデータ未設定の間は`isSupportConfigured`が
 *   falseを返しSupportSection自体が何も描画しないため、その場合は
 *   副列ごと出さず1カラムにする(`hasSupport`で判定)。モバイルの
 *   DOM順は身体譜→スライド/コメント→支援欄(指示書の規定)。
 * - `commonNotebookDescription`(交換ノート撤去後もまだ「書き足せます」
 *   という古い文言が残っている、Decision Log 0178参照)は、散歩譜の
 *   新レイアウトでは表示しない(指示書の構成にこの文言は含まれない)。
 *   Fieldnote・研究断面をひらく(スライド無し分岐)は今回対象外のため、
 *   従来通りcommonNotebookDescriptionを表示したまま変更していない。
 *
 * `slidesEmbedSrc`が無いノート(現状Fieldnote・研究断面をひらく)は、
 * 従来通りのHero構成のまま変更していない(今回の指示は散歩譜が対象)。
 *
 * 【Fieldnoteに体験デモを追加(2026-09-19、Decision Log 0184)】
 * Fieldnote(slug === "fieldnote")のみ、Hero構成の末尾に
 * `FieldnoteMemoDemo`を追加した。プロジェクトオーナーが用意した
 * アプリ構想のモックアップを、サイト内で完結する静的なデモとして
 * 移植したもの。研究断面をひらくには対象外。
 * ------------------------------------------------------------
 */
import DefaultLayout from "@layouts/DefaultLayout.astro";
import ResearchSection from "@components/ResearchSection.astro";
import ArrowLink from "@components/ArrowLink.astro";
import WalkingScorePlayer from "@components/WalkingScorePlayer.astro";
import SupportSection from "@components/SupportSection.astro";
import SupportLedger from "@components/SupportLedger.astro";
import FieldnoteMemoDemo from "@components/FieldnoteMemoDemo.astro";
import styles from "./[slug].module.css";
import { publishedLabNotebooks, commonNotebookDescription } from "@/data/labNotebooks";
import { walkingScoreDemo } from "@/data/walkingScoreDemo";
import { fieldnoteMemoSessions } from "@/data/fieldnoteMemoDemo";
import { supportConfig, isSupportConfigured } from "@/config/support";
import type { LabNotebook } from "@/types/labNotebook";

export function getStaticPaths() {
  return publishedLabNotebooks.map((notebook) => ({
    params: { slug: notebook.slug },
    props: { notebook },
  }));
}

interface Props {
  notebook: LabNotebook;
}

const { notebook } = Astro.props;
const otherNotebooks = publishedLabNotebooks.filter((n) => n.slug !== notebook.slug);

/**
 * Googleスライドの埋め込み用URL(「ウェブに公開」で取得したもの)に、
 * 自動再生・ループを明示的に無効化するクエリを付加する。URLとして
 * 解釈できない値は、壊れたiframeを作らないようnullを返す(呼び出し側で
 * 区画自体を表示しない)。
 */
function buildSlidesEmbedSrc(rawUrl: string): string | null {
  try {
    const url = new URL(rawUrl);
    url.searchParams.set("start", "false");
    url.searchParams.set("loop", "false");
    return url.toString();
  } catch {
    return null;
  }
}

const slidesEmbedSrc = notebook.slidesEmbedUrl ? buildSlidesEmbedSrc(notebook.slidesEmbedUrl) : null;
const showWalkingScore = notebook.slug === "oto-no-michi" && Boolean(slidesEmbedSrc);
const hasSupport = isSupportConfigured(supportConfig);
---

<DefaultLayout title={`${notebook.title} ｜ 実験室 ｜ 公開研究室ふ、と`} description={notebook.description} theme="editorial">

  {
    slidesEmbedSrc ? (
      <ResearchSection ariaLabel={notebook.title} id="notebook-top">
        <a class:list={[styles.back, styles.backTight]} href="/participate">
          ← 実験室
        </a>
        <h1 class:list={[styles.heading, styles.headingTight]}>{notebook.title}</h1>
        <p class={styles.intro}>{notebook.description}</p>

        <div class:list={[styles.layout, !hasSupport && styles.layoutSingle]}>
          <div class={styles.main}>
            {showWalkingScore && <WalkingScorePlayer score={walkingScoreDemo} />}

            <section class={styles.record} aria-labelledby="notebook-record-title">
              <p class={styles.eyebrow}>OPEN NOTEBOOK</p>
              <h2 id="notebook-record-title" class={styles.recordHeading}>途中の記録</h2>
              <div class={styles.slidesEmbed}>
                <iframe src={slidesEmbedSrc} title={`${notebook.title}のスライド`} loading="lazy" allowfullscreen />
              </div>
              {notebook.slidesCommentUrl && (
                <div class={styles.slidesComment}>
                  <ArrowLink href={notebook.slidesCommentUrl} label="この記録にコメントする" external />
                </div>
              )}
            </section>
          </div>

          {hasSupport && (
            <aside class={styles.aside}>
              <SupportSection />
              <SupportLedger />
            </aside>
          )}
        </div>
      </ResearchSection>
    ) : (
      <ResearchSection ariaLabel={notebook.title} id="notebook-top">
        <a class={styles.back} href="/participate">
          ← 実験室
        </a>
        <p class={styles.eyebrow}>{notebook.category}</p>
        <h1 class={styles.heading}>{notebook.title}</h1>
        <p class={styles.lead}>{notebook.description}</p>
        <p class={styles.commonNote}>{commonNotebookDescription}</p>
        {notebook.slug === "fieldnote" && <FieldnoteMemoDemo sessions={fieldnoteMemoSessions} />}
      </ResearchSection>
    )
  }

  <ResearchSection ariaLabel="他のノートを見る" id="notebook-others">
    <nav aria-label="他のノートを見る">
      <p class={styles.otherNotebooksLabel}>他のノートを見る</p>
      <ul class={styles.otherNotebooksList}>
        {
          otherNotebooks.map((other) => (
            <li>
              <a class={styles.otherNotebookLink} href={`/participate/${other.slug}`}>
                {other.title} <span aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </ResearchSection>
</DefaultLayout>
