---
/**
 * zujo/index.astro (頭上の記録 制作ノート — 一覧)
 * ------------------------------------------------------------
 * 役割: 「頭上の記録」(実験室のノートの1つ、src/data/labNotebooks.ts
 * の"zujo-no-kiroku")の制作過程を綴る「制作ノート」の一覧(2026-11-11)。
 * 研究断面(/research)と同じ「一覧ページ+番号つき詳細ページ」の構造を
 * 踏襲し、ResearchReviewListと同じ見た目のProductionNoteListで表示
 * する。詳細ページ(/zujo/01等)は、最初の回の本文が確定してから
 * 追加する。
 *
 * データは`src/data/productionNotes.ts`(現時点では空配列)を参照する。
 * ------------------------------------------------------------
 */
import PageHeading from "@components/PageHeading.astro";
import DefaultLayout from "@layouts/DefaultLayout.astro";
import ResearchSection from "@components/ResearchSection.astro";
import ProductionNoteList from "@components/ProductionNoteList.astro";
import styles from "./index.module.css";
import { productionNotes } from "@/data/productionNotes";
---

<DefaultLayout title="頭上の記録 制作ノート ｜ 公開研究室ふ、と" theme="editorial">
  <ResearchSection ariaLabel="頭上の記録 制作ノート" id="zujo-notes">
    <a class={styles.back} href="/participate">← 実験室</a>
    <PageHeading
      label="NOTES"
      title="頭上の記録 制作ノート"
      description="「頭上の記録」ができていく過程を、迷ったことやつまずいたことも含めて残していく記録です。"
    />
    <ProductionNoteList entries={[...productionNotes].reverse()} />
  </ResearchSection>
</DefaultLayout>
