---
/**
 * about.astro (ふ、とについて)
 * ------------------------------------------------------------
 * 役割: 公開研究室「ふ、と」の紹介ページ。正式公開に向けた
 * プロジェクトオーナーの指示により新規実装した(2026-08-17、
 * Decision Log 0057)。これまでHeader/index.astroのコメントに
 * 「Aboutは未実装」とあったが、今回の指示で解禁された。
 *
 * 3つのセクション(公開研究室「ふ、と」について / 研究と実践 /
 * 運営者について)を、1つのResearchSection内に収めている
 * (ResearchSectionは padding-block: space-6 と大きいため、
 * 3つ別々に並べると余白が過大になる)。見出し階層は、1つ目の
 * セクション見出しをh1、残り2つをh2として扱う。
 *
 * 運営者名は、プロジェクトオーナーの指示により実名を追加せず、
 * 「準備中」であることが分かる形のプレースホルダーで表示していた。
 *
 * 【夜空背景(2026-09-03、Decision Log 0063)】Homeで実装した「夜空」
 * 背景(紺+光の粒、Decision Log 0059〜0062)を、他ページにも揃える
 * 指示を受けてこのページにも適用した。DefaultLayoutにtheme="night"
 * を渡し、<NightBackground />を配置している。
 *
 * 【運営者について本文改訂(2026-09-03、Decision Log 0072)】
 * プロジェクトオーナーの指示により、「（運営者名は準備中です）」の
 * プレースホルダー行を削除し、本文をFieldnoteの仮称明記・所属状況の
 * 言い回し変更を含む内容に差し替えた。運営者名自体は引き続き
 * 実名を追加していない。
 *
 * 【本文フォントサイズ調整(2026-09-03、Decision Log 0074)】
 * 「このページだけ本文の文字サイズが大きい」という指摘を受け、
 * `.body`のfont-sizeを--fs-lgから--fs-baseに変更した(研究断面
 * 詳細ページの本文・Homeの「いま、取り組んでいること」の説明文と
 * 同じサイズ)。
 *
 * 【「Fieldnote（仮称）」への言及を削除(2026-09-03、Decision Log
 * 0077)】プロジェクトオーナーの指示により、「運営者について」本文
 * から「Fieldnote（仮称）」という語を削除した。「そのための研究
 * 環境を制作しています」という形に文章を整え、固有名には触れない
 * ようにした。
 *
 * 【Desktop 2カラム化・プロセス表示の追加(2026-09-04、Decision Log
 * 0094)】3つの区画(公開研究室「ふ、と」について/研究と実践/運営者
 * について)がすべて同じ見た目で縦に連続し、区切りが分かりにくいと
 * いう指摘(ChatGPT/Creative Directorからの提案、プロジェクトオーナー
 * 確認済み)を受け、各区画をDesktop幅で「左: 見出し(控えめなラベル
 * として縮小) / 右: 本文」の2カラムに、区画同士の境界に細い罫線
 * (--color-accent-beige)を追加した。Mobile幅では従来通り縦積みに
 * 戻す(見出しサイズも従来のfs-xlのまま)。見出し階層(h1→h2→h2)・
 * 文章そのものは変更していない。
 *
 * あわせて、「研究と実践」の本文にある「観察する、気づく、記録する、
 * 対話する、つくる、試す、そしてまた観察する」という一文を、本文は
 * そのまま残しつつ、同じ語をそのまま使った縦のプロセス表示(観察する
 * →気づく→記録する→対話する→つくる→試す→また観察する)として
 * 補足的に追加した。新しい語や言い換えは加えていない。
 *
 * 【プロセス表示を循環図に(2026-09-05)】縦の矢印リストだと「また
 * 観察する」で終わってしまい、本文の「この循環を通して」という
 * 内容(最後の観察するが最初の観察するに戻る)が伝わらないという
 * 指摘を受け、7つの語を円周上に並べ、隣接する語の間を矢印でつなぐ
 * 円環図に作り直した。矢印は最後の要素から最初の要素へも1本引かれ、
 * 輪が閉じていることを視覚的に示す。外部の図形・アイコンライブラリは
 * 使わず、位置計算(円周上の座標)はビルド時にAstro側で行い、
 * 見た目は既存トークン(--color-accent-beige、--fs-sm等)のみで
 * 構成する。本文で同じ内容を文章として説明済みのため、図自体は
 * aria-hidden="true"で装飾扱いにし、スクリーンリーダーには本文の
 * 一文のみを情報源として残す。
 * ------------------------------------------------------------
 */
import DefaultLayout from "@layouts/DefaultLayout.astro";
import ResearchSection from "@components/ResearchSection.astro";
import SectionTitle from "@components/SectionTitle.astro";
import NightBackground from "@components/NightBackground.astro";
import styles from "./about.module.css";

const processSteps = ["観察する", "気づく", "記録する", "対話する", "つくる", "試す", "また観察する"];

/**
 * 循環図の座標計算。円周上にprocessStepsの数だけ均等配置し(12時の
 * 位置から時計回り)、隣接する語の中間角度に矢印を1つずつ置く
 * (最後→最初のペアも含めて輪を閉じる)。ラベルは中心からの角度に
 * 応じて左揃え/右揃え/中央揃えを切り替え、円の外側にはみ出す方向を
 * 内側ではなく外側にそろえる(重なりを避けるため)。
 */
const cycleCount = processSteps.length;
const cycleRingRadius = 30;
const cycleArrowRadius = 35;
const cycleLabelRadius = 41;

function pointOnCircle(angleDeg: number, radius: number) {
  const rad = (angleDeg * Math.PI) / 180;
  return { x: 50 + radius * Math.cos(rad), y: 50 + radius * Math.sin(rad) };
}

const cycleNodes = processSteps.map((label, i) => {
  const angle = (i / cycleCount) * 360 - 90;
  const { x, y } = pointOnCircle(angle, cycleLabelRadius);
  const cos = Math.cos((angle * Math.PI) / 180);
  const align = cos > 0.3 ? "left" : cos < -0.3 ? "right" : "center";
  return { label, x, y, align };
});

const cycleArrows = processSteps.map((_, i) => {
  const angle = ((i + 0.5) / cycleCount) * 360 - 90;
  const { x, y } = pointOnCircle(angle, cycleArrowRadius);
  return { x, y, rotate: angle + 90 };
});
---

<DefaultLayout
  title="ふ、とについて ｜ ふ、と"
  description="公開研究室「ふ、と」について。研究と実践、運営者について。"
  theme="night"
>
  <NightBackground />
  <ResearchSection ariaLabel="About">
    <SectionTitle>ABOUT</SectionTitle>

    <div class={styles.block}>
      <h1 class={styles.heading}>公開研究室「ふ、と」について</h1>
      <div class={styles.body}>
        <p>
          「ふ、と」は、日常のなかで生まれる小さな気づきや違和感を観察し、その先で問いがどのように育っていくのかを探る公開研究室です。
        </p>
        <p>
          大学や研究機関の内側だけではなく、暮らし、読書、対話、制作といった日々の営みのなかにも、研究の始まりはあると考えています。完成した成果だけでなく、考え、迷い、試している過程からひらいていきます。
        </p>
      </div>
    </div>

    <div class={styles.block}>
      <h2 class={styles.subheading}>研究と実践</h2>
      <div class={styles.body}>
        <p>
          観察する、気づく、記録する、対話する、つくる、試す、そしてまた観察する。この循環を通して、「問いの生態系」を研究しています。
        </p>
        <div class={styles.cycleWrap}>
          <div class={styles.cycle} aria-hidden="true">
            <svg class={styles.cycleRing} viewBox="0 0 100 100">
              <circle cx="50" cy="50" r={cycleRingRadius} />
            </svg>
            {
              cycleArrows.map((a) => (
                <span
                  class={styles.cycleArrow}
                  style={`left:${a.x}%; top:${a.y}%; --cycle-rotate:${a.rotate}deg;`}
                >
                  →
                </span>
              ))
            }
            {
              cycleNodes.map((n) => (
                <span
                  class={styles.cycleLabel}
                  data-align={n.align}
                  style={`left:${n.x}%; top:${n.y}%;`}
                >
                  {n.label}
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <div class={styles.block}>
      <h2 class={styles.subheading}>運営者について</h2>
      <div class={styles.body}>
        <p>
          「問いが生まれる前の瞬間」に関心を持ち、生活のなかで観察、記録、制作を続けています。現在は公開研究『問いの生態系』と、そのための研究環境を制作しています。大学や研究機関には今のところ所属せず、暮らしのなかから研究をひらく方法を探っています。
        </p>
      </div>
    </div>
  </ResearchSection>
</DefaultLayout>
