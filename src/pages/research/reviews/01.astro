---

<DefaultLayout title="研究断面01 ｜ ふ、と" theme="night">
  <NightBackground />
  <CursorGlow />
  <ResearchReviewArticle
    sectionLabel="Research Review"
    title="研究断面01"
    subtitle="『ふと』という日本語──身体、知覚、記憶、思考を横断する言葉"
    sections={sections}
  />
</DefaultLayout>
