---
/**
 * 01.astro (研究断面01)
 * ------------------------------------------------------------
 * CLAUDE.md Parking Lotで「β公開まで実装しない」としていた
 * Research Review詳細UIを、この1件(研究断面01)に限って解禁した
 * (2026-08-15、プロジェクトオーナーの指示)。解禁の経緯・URL構造
 * (/research/reviews/01、02以降を見越した構造)・命名規則(日本語
 * タイトル「研究断面」・英語ラベル「Research Review」の併用)は
 * Decision Log 0030に記録している。
 *
 * 【2026-08-16改訂】プロジェクトオーナーから改訂版の原稿(PDF)が
 * 共有され、本文を全面的に差し替えた。旧版(エッセイ形式: はじめに→
 * 「ふと」は「突然」ではない→…→おわりに)から、要旨・番号付きの節・
 * 「暫定的な仮説」内の4つの小見出し・古典文学からの引用・「暫定的な
 * 定義」という、より論文に近い構成に変わった。あわせて、節3
 * (「ふと」は何を修飾しているのか)の指定の一文の直後に図1
 * (「ふと」の用例の分布)を挿入した。経緯はDecision Log 0036参照。
 *
 * 【2026-08-17再改訂】プロジェクトオーナーから2度目の改訂原稿(PDF)が
 * 共有され、本文を再度差し替えた(Decision Log 0048)。
 * - 一部の文章がリライトされた(例: 節2「「ふと」は「突然」でも…
 *   でもない」→「類似語はあるものの、それらの語とは完全一致しない」、
 *   節3「経験」→「概念」等)。
 * - 段落の区切り(行間)が詰められ、以前は別々の段落だった短い文が
 *   1つの段落にまとめられた箇所が多数ある。
 * - 節3の「少なくとも、私はこれまで…」「もちろん、これは現時点
 *   での観察にすぎない。」の2文は削除された。
 * - 節4(古典文学)に、「見ゆ」「おぼゆ」という古典日本語の多義性を
 *   検討する新しい段落・表(「おぼゆ」の意味/現代的な分類)が追加され、
 *   「日本語は認識の変化をどのように記述しているのか」という問いへ
 *   接続する形に拡張された。
 * 節3の図1・表の横並び配置(RowBlock、Decision Log 0041〜0045)は
 * プロジェクトオーナーの指示によりそのまま維持している。
 *
 * 文章そのもの(語順・言葉遣い)は、上記のリライト箇所を除いて
 * 変更していない。段落内の改行は、Research Statementで採用した
 * 「自然な折返しに任せる」方針(Decision Log 0026)を踏襲し、
 * 強制改行は入れていない。
 *
 * 02以降を追加する際は、このファイルと同じ構造で
 * `src/pages/research/reviews/02.astro` 等を追加し、
 * ResearchReviewArticleコンポーネントを再利用する想定。
 * ------------------------------------------------------------
 */
import DefaultLayout from "@layouts/DefaultLayout.astro";
import ResearchReviewArticle from "@components/ResearchReviewArticle.astro";
import type { ReviewSection } from "@/types/researchReview";

const sections: ReviewSection[] = [
  {
    heading: "要旨",
    blocks: [
      {
        type: "paragraph",
        text: "「ふと」は、日本語において日常的に使われる言葉である。しかし、その意味を説明しようとすると、意外なほど難しい。",
      },
      {
        type: "paragraph",
        text: "国語辞典では、「思いがけなく」「不意に」「偶然に」と説明されることが多い。けれども、それだけで「ふと」という経験を十分に説明できるのだろうか。",
      },
      {
        type: "paragraph",
        text: "本稿では、辞書、古典文学、日本語研究における用例を手がかりに、「ふと」という言葉を検討する。",
      },
      {
        type: "paragraph",
        text: "その結果、「ふと」は単なる偶然や瞬間性だけでは説明しきれないこと、そして、身体、知覚、記憶、思考を横断する言葉として捉えられる可能性が見えてきた。",
      },
    ],
  },
  {
    heading: "1. 辞書は「ふと」をどのように説明しているのか",
    blocks: [
      {
        type: "paragraph",
        text: "国語辞典では、「ふと」は主に次のような意味で説明されている。",
      },
      { type: "list", items: ["思いがけなく", "偶然に", "不意に", "急に"] },
      {
        type: "paragraph",
        text: "『広辞苑』『大辞泉』『日本国語大辞典』を参照すると、表現には違いがあるものの、「予期していなかったこと」が共通する要素として挙げられている。",
      },
      {
        type: "paragraph",
        text: "辞書を読む限り、「ふと」は予期しない出来事を表す副詞のように思える。",
      },
      {
        type: "paragraph",
        text: "しかし、本当にそれだけだろうか。例えば、次のような表現を考えてみる。",
      },
      {
        type: "list",
        items: ["ふと立ち止まる", "ふと窓の外を見る", "ふと昔のことを思い出す", "ふと疑問を感じる"],
      },
      {
        type: "paragraph",
        text: "これらは、本当にすべて「予期していなかった」という言葉だけで説明できるのだろうか。",
      },
    ],
  },
  {
    heading: "2. 「ふと」は他の言葉とどう違うのか",
    blocks: [
      {
        type: "paragraph",
        text: "「ふと」に似た言葉は数多く存在するが、それらを比較してみると、「ふと」の輪郭が少しずつ見えてくる。",
      },
      {
        type: "table",
        headers: ["言葉", "主な特徴"],
        rows: [
          ["突然", "世界の変化"],
          ["不意に", "予測していなかった出来事"],
          ["思わず", "反射的な行動"],
          ["つい", "習慣や誘惑"],
          ["何気なく", "目的の欠如"],
          ["なんとなく", "理由の曖昧さ"],
          ["はっと", "驚きを伴う気づき"],
          ["ふと", "これらだけでは説明しにくい"],
        ],
      },
      {
        type: "paragraph",
        text: "例えば、「突然、雨が降った」という場合、変化しているのは世界である。一方、「ふと窓の外を見る」という場合、変化しているのは世界そのものではない。「ふと」は、「突然」「不意に」「思わず」など類似語はあるものの、それらの語とは完全一致しない。",
      },
      { type: "paragraph", text: "しかし、それでは「ふと」は何を表しているのだろうか。" },
    ],
  },
  {
    heading: "3. 「ふと」は何を修飾しているのか",
    blocks: [
      {
        type: "paragraph",
        text: "現代の用例を整理すると、「ふと」は特定の領域に限定されていない。なお、本稿では、「見る」「気づく」といった経験を便宜的に「知覚」と呼ぶ。",
      },
      {
        type: "row",
        items: [
          {
            type: "table",
            headers: ["「ふと」の用例", "便宜的な分類"],
            rows: [
              ["ふと立ち止まる、ふと振り返る", "身体"],
              ["ふと見る、ふと気づく", "知覚"],
              ["ふと思い出す", "記憶"],
              ["ふと思う、ふと考える", "思考"],
            ],
          },
          {
            type: "image",
            src: "/images/research/reviews/01/figure-1.svg",
            alt: "図1 「ふと」の用例の分布。中心の「ふと」を、思考(ふと思う・ふと考える)、知覚(ふと見る・ふと気づく)、身体(ふと立ち止まる・ふと振り返る)、記憶(ふと思い出す・ふと昔のことを思う)の4つの経験領域が取り囲む図。用例を整理すると、「ふと」は身体、知覚、記憶、思考という異なる経験領域に分布していることがわかる。",
            width: 1100,
            height: 950,
          },
        ],
      },
      {
        type: "paragraph",
        text: "用例を並べてみると、「ふと」は身体、知覚、記憶、思考という、本来は別々の言葉で表現されることの多い概念を横断する言葉であることに気づく。",
      },
      {
        type: "paragraph",
        text: "「身体」「知覚」「記憶」「思考」という分類そのものも、絶対的なものではない。むしろ、「ふと」という言葉が、私たちが当然のように区別している経験の境界を揺さぶっているようにも見える。",
      },
    ],
  },
  {
    heading: "4. 古典文学に「ふと」を探す",
    blocks: [
      {
        type: "paragraph",
        text: "この気づきを手がかりに、「ふと」の用例を古典文学までさかのぼってみる。",
      },
      { type: "paragraph", text: "『竹取物語』には、次のような表現が見られる。" },
      { type: "quote", text: "我名はうかんるりと言ひて、ふと山の中に入りぬ。" },
      {
        type: "paragraph",
        text: "ここでの「ふと」は、「さっと」「すっと」「素早く」という意味で解釈されている。",
      },
      {
        type: "paragraph",
        text: "『枕草子』や『徒然草』にも、「ふと」を用いた表現が見られる。これらの用例からは、「ふと」が古くから身体的な経験と結びついていたことがうかがえる。",
      },
      {
        type: "paragraph",
        text: "今回の調査では、『竹取物語』や『枕草子』において、「ふと」が身体的な経験と結びついていることを確認した。一方で、古典日本語には、「見ゆ」「おぼゆ」のように、現代語へ単純に置き換えることが難しい言葉も存在する。",
      },
      {
        type: "paragraph",
        text: "例えば、「おぼゆ」は、以下のように複数の意味を持つ。",
      },
      {
        type: "table",
        headers: ["「おぼゆ」の意味", "現代的な分類"],
        rows: [
          ["感じられる", "知覚"],
          ["思われる", "認知・思考"],
          ["思い出される", "記憶"],
        ],
      },
      {
        type: "paragraph",
        text: "興味深いのは、「おぼゆ」が知覚、記憶、思考の境界をまたいでいるように見える点である。もし「ふと」も同じ特徴を持っているのだとすれば、「ふと」は特殊な言葉というよりも、日本語に存在する、ある種の認識語彙の一つとして理解できるかもしれない。",
      },
      {
        type: "paragraph",
        text: "現時点では、これは仮説にすぎないが、「ふと」という一つの副詞をたどるなかで、「日本語は認識の変化をどのように記述しているのか」という新たな問いが立ち上がってきた。",
      },
    ],
  },
  {
    heading: "5. 暫定的な仮説",
    blocks: [
      {
        type: "paragraph",
        text: "ここから先は、『問いの生態系』における研究メモである。現時点では、次の四つの仮説を立てている。",
      },
      { type: "subheading", text: "仮説1「ふと」は身体の痕跡を残している" },
      {
        type: "paragraph",
        text: "古典文学の用例を見ると、「ふと」は身体的な動きと強く結びついている。",
      },
      {
        type: "paragraph",
        text: "そして、その特徴は現代でも失われていない。「ふと」は、身体から切り離された言葉ではないのかもしれない。",
      },
      { type: "subheading", text: "仮説2「ふと」は経験のあり方を記述している" },
      {
        type: "paragraph",
        text: "「ふと」が記述しているのは、出来事そのものではない。重要なのは、「何が起きたのか」ではなく「どのように経験されたのか」という点である。",
      },
      {
        type: "paragraph",
        text: "例えば、「花を見る」と「ふと花を見る」では、「見る」という行為自体は変わらない。変化しているのは、その経験のあり方である。",
      },
      { type: "subheading", text: "仮説3「ふと」は能動と受動のあいだにある" },
      {
        type: "paragraph",
        text: "「見えてしまった」「思い浮かんだ」といった言葉には、自ら意図したわけではないにもかかわらず、何かが立ち上がる感覚がある。「ふと」は、そのような経験を反映しているのかもしれない。",
      },
      { type: "subheading", text: "仮説4「ふと」は背景にあったものが前景化する瞬間である" },
      {
        type: "paragraph",
        text: "世界に新しいものが現れたわけではない。そこに存在していたものが、ある瞬間に見えるようになったのである。「ふと」は、発見というよりも、前景化の経験に近いのかもしれない。",
      },
    ],
  },
  {
    heading: "6. 「ふと」は認識の変化を記述する語彙群の一つなのか",
    blocks: [
      {
        type: "paragraph",
        text: "今回の検討を通して、もう一つ気になることが出てきた。日本語には、「ふと」以外にも、認識の変化を表す言葉が数多く存在する。",
      },
      {
        type: "list",
        items: ["ぼんやり", "なんとなく", "はっと", "気づく", "思い当たる", "腑に落ちる"],
      },
      {
        type: "paragraph",
        text: "これらは、それぞれ独立した言葉なのだろうか。あるいは、一連の認識の変化を記述する語彙群なのだろうか。この点については、今後さらに検討したい。",
      },
    ],
  },
  {
    heading: "暫定的な定義",
    blocks: [
      { type: "paragraph", text: "現時点では、次のように定義しておきたい。" },
      {
        type: "quote",
        text: "「ふと」とは、目的的な行為でも完全な無意識でもないところで、瞬間的に人と世界との関係が変化する様態を表す日本語である。",
      },
    ],
  },
  {
    heading: "今後の課題",
    blocks: [
      { type: "paragraph", text: "今回の検討を通して、次のような研究課題が見えてきた。" },
      {
        type: "list",
        items: [
          "「ふと」は日本語固有の経験なのか。",
          "「ふと」と類似する表現は、他の言語にも存在するのか。",
          "「ふと」は身体と認識を結びつける言葉なのか。",
          "問いは作られるものなのか、それとも立ち上がるものなのか。",
        ],
      },
      { type: "paragraph", text: "「ふと」という一つの副詞について調べるつもりだった。" },
      {
        type: "paragraph",
        text: "しかし、その先で見えてきたのは、人がどのように世界を認識しているのかという、より大きな問いだった。",
      },
    ],
  },
];
---

<DefaultLayout title="研究断面01 ｜ ふ、と">
  <ResearchReviewArticle
    sectionLabel="Research Review"
    title="研究断面01"
    subtitle="『ふと』という日本語──人と世界との関係が変化する瞬間"
    sections={sections}
  />
</DefaultLayout>
