---
/**
 * kyou-no-sora/index.astro (きょうの空 制作ノート — 一覧)
 * ------------------------------------------------------------
 * 役割: 「きょうの空」(実験室のノートの1つ、src/data/labNotebooks.ts
 * の"kyou-no-sora"、旧名「頭上の記録」)の制作過程を綴る「制作ノート」の
 * 一覧(2026-11-11)。研究断面(/research)と同じ「一覧ページ+番号つき
 * 詳細ページ」の構造を踏襲し、ResearchReviewListと同じ見た目の
 * ProductionNoteListで表示する。詳細ページ(/kyou-no-sora/01等)は、
 * 最初の回の本文が確定してから追加する。
 *
 * データは`src/data/productionNotes.ts`(現時点では空配列)を参照する。
 *
 * 【体験デモ+Googleスライドを追加(2026-11-11、同日2件目)】
 * プロジェクトオーナーの指示により、実験室カードからの遷移先は
 * このページのまま(detailHref、Googleスライドの有無で判定する
 * `/participate/[slug]`は使わない)にしつつ、このページ自体に
 * 「触って動くデモ」(`SkyLogDemo`)と、Googleスライドの「制作メモ」
 * 区画を追加した。スライド区画は`notebook.slidesEmbedUrl`が設定される
 * までは描画されない([slug].astroの散歩譜と同じ`buildSlidesEmbedSrc`
 * を共有して使う、壊れたiframeを作らない方針)。
 * ------------------------------------------------------------
 */
import PageHeading from "@components/PageHeading.astro";
import DefaultLayout from "@layouts/DefaultLayout.astro";
import ResearchSection from "@components/ResearchSection.astro";
import ArrowLink from "@components/ArrowLink.astro";
import ProductionNoteList from "@components/ProductionNoteList.astro";
import SkyLogDemo from "@components/SkyLogDemo.astro";
import styles from "./index.module.css";
import { productionNotes } from "@/data/productionNotes";
import { demoEntries } from "@/data/skyLogDemo";
import { labNotebooks, buildSlidesEmbedSrc } from "@/data/labNotebooks";

const notebook = labNotebooks.find((n) => n.slug === "kyou-no-sora");
const slidesEmbedSrc = notebook?.slidesEmbedUrl ? buildSlidesEmbedSrc(notebook.slidesEmbedUrl) : null;
---

<DefaultLayout title="きょうの空 制作ノート ｜ 公開研究室ふ、と" theme="editorial">
  <ResearchSection ariaLabel="きょうの空 制作ノート" id="kyou-no-sora-notes">
    <a class={styles.back} href="/participate">← 実験室</a>
    <PageHeading
      label="NOTES"
      title="きょうの空 制作ノート"
      description="「きょうの空」ができていく過程を、迷ったことやつまずいたことも含めて残していく記録です。"
    />

    <section class={styles.demoSection} aria-labelledby="kyou-no-sora-demo-title">
      <h2 id="kyou-no-sora-demo-title" class={styles.sectionHeading}>体験デモ</h2>
      <SkyLogDemo entries={demoEntries} />
    </section>

    {
      slidesEmbedSrc && (
        <section class={styles.slidesSection} aria-labelledby="kyou-no-sora-memo-title">
          <h2 id="kyou-no-sora-memo-title" class={styles.sectionHeading}>制作メモ</h2>
          <div class={styles.slidesEmbed}>
            <iframe src={slidesEmbedSrc} title="きょうの空の制作メモ" loading="lazy" allowfullscreen />
          </div>
          {notebook?.slidesCommentUrl && (
            <div class={styles.slidesComment}>
              <ArrowLink href={notebook.slidesCommentUrl} label="この制作メモにコメントする" external />
            </div>
          )}
        </section>
      )
    }

    <ProductionNoteList entries={[...productionNotes].reverse()} />
  </ResearchSection>
</DefaultLayout>
