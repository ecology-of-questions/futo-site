---
/**
 * contact.astro (お問い合わせ)
 * ------------------------------------------------------------
 * 役割: お問い合わせページ。正式公開に向けたプロジェクトオーナーの
 * 指示により新規実装した(2026-08-17、Decision Log 0057)。
 *
 * 【2026-08-17改訂(Decision Log 0058)】noteのプロフィールURLが
 * 確定し、お問い合わせ手段をnoteの「クリエイターへのお問い合わせ」に
 * 一本化する方針になったため、メール/フォームURLによる分岐と
 * 「連絡先準備中」表示を廃止し、note経由の導線に差し替えた。
 *
 * 【夜空背景(2026-09-03、Decision Log 0063)】Homeで実装した「夜空」
 * 背景(紺+光の粒、Decision Log 0059〜0062)を、他ページにも揃える
 * 指示を受けてこのページにも適用した。DefaultLayoutにtheme="night"
 * を渡し、<NightBackground />を配置している。
 *
 * 【問い合わせフォームへの変更(2026-09-03、Decision Log 0076)】
 * note経由の問い合わせから、サイト内の入力フォームに変更した。
 * 送信先はFormspree(外部フォームバックエンドサービス)経由で、
 * サイト専用に用意するGmailアドレスにメールで転送される。
 * Cloudflare Pages Functions等のデプロイ先固有の機能は使わず、
 * <form>を直接Formspreeへ POSTするだけの構成のため、ビルドは
 * 引き続きポータブルな静的サイトのまま(CLAUDE.md方針)。
 * JS未対応環境でもフォーム自体は機能する(通常のform submit)よう、
 * fetchによるAjax送信は「デフォルトのページ遷移を止めて同じページ内で
 * 結果を表示する」という進行拡張(progressive enhancement)として
 * 追加している。
 *
 * 【フォーム項目・文言の拡充(2026-09-04、Decision Log 0083)】
 * プロジェクトオーナーの指示により、導入文・注記文を差し替え、
 * 「お問い合わせ種別」(select、任意)を追加した。二重送信防止・
 * 送信中表示・プライバシー注記も追加している。詳細はDecision Log
 * 0083参照。
 * ------------------------------------------------------------
 */
import DefaultLayout from "@layouts/DefaultLayout.astro";
import ResearchSection from "@components/ResearchSection.astro";
import SectionTitle from "@components/SectionTitle.astro";
import NightBackground from "@components/NightBackground.astro";
import styles from "./contact.module.css";
import { contactFormEndpoint } from "@/config/site";
---

<DefaultLayout title="お問い合わせ ｜ ふ、と" description="公開研究室「ふ、と」へのお問い合わせ。" theme="night">
  <NightBackground />
  <ResearchSection ariaLabel="Contact">
    <SectionTitle>CONTACT</SectionTitle>

    <h1 class={styles.heading}>お問い合わせ</h1>
    <div class={styles.body}>
      <p>
        研究についてのご質問、取材・掲載、協働のご相談などがありましたら、こちらからお送りください。
      </p>
    </div>
    <p class={styles.note}>内容を確認のうえ、通常5日以内にご返信します。</p>

    <form class={styles.form} method="POST" action={contactFormEndpoint} data-contact-form>
      <input type="text" name="_gotcha" class={styles.honeypot} tabindex="-1" autocomplete="off" aria-hidden="true" />
      <input type="hidden" name="_subject" value="ふ、と｜ウェブサイトからのお問い合わせ" />

      <div class={styles.field}>
        <label class={styles.label} for="contact-name">
          お名前 <span class={styles.badge}>任意</span>
        </label>
        <input
          class={styles.input}
          type="text"
          id="contact-name"
          name="name"
          autocomplete="name"
          placeholder="例）山田 花子"
        />
      </div>

      <div class={styles.field}>
        <label class={styles.label} for="contact-email">
          ご返信先メールアドレス <span class={styles.badge}>必須</span>
        </label>
        <input
          class={styles.input}
          type="email"
          id="contact-email"
          name="email"
          autocomplete="email"
          placeholder="例）example@email.com"
          required
        />
      </div>

      <div class={styles.field}>
        <label class={styles.label} for="contact-category">
          お問い合わせ種別 <span class={styles.badge}>任意</span>
        </label>
        <select class={styles.select} id="contact-category" name="category">
          <option value="">選択してください</option>
          <option value="研究について">研究について</option>
          <option value="取材・掲載について">取材・掲載について</option>
          <option value="協働・共同制作について">協働・共同制作について</option>
          <option value="イベントについて">イベントについて</option>
          <option value="その他">その他</option>
        </select>
      </div>

      <div class={styles.field}>
        <label class={styles.label} for="contact-message">
          お問い合わせ内容 <span class={styles.badge}>必須</span>
        </label>
        <textarea
          class={styles.textarea}
          id="contact-message"
          name="message"
          rows="8"
          placeholder="ご相談内容をご記入ください"
          required
        ></textarea>
      </div>

      <p class={styles.privacyNote}>ご入力いただいた情報は、お問い合わせへの対応にのみ使用します。</p>

      <button class={styles.submit} type="submit" data-submit-label="送信する" data-pending-label="送信中…">
        送信する
      </button>

      <p class={styles.status} data-contact-status role="status" aria-live="polite"></p>
    </form>
  </ResearchSection>
</DefaultLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  const status = document.querySelector<HTMLElement>("[data-contact-status]");
  const submitButton = form?.querySelector<HTMLButtonElement>("[data-submit-label]") ?? null;

  let isSubmitting = false;

  if (form && status && submitButton) {
    const pendingLabel = submitButton.dataset.pendingLabel ?? "送信中…";
    const submitLabel = submitButton.dataset.submitLabel ?? "送信する";

    form.addEventListener("submit", async (event) => {
      // ブラウザは無効な項目(required・type="email")があると、この
      // submitイベント自体を発火させずネイティブのエラー表示(キーボード・
      // スクリーンリーダー双方に伝わる)を出す。ここに到達している時点で
      // 既にバリデーション済みのため、追加のチェックは不要。
      event.preventDefault();

      if (isSubmitting) return;
      isSubmitting = true;

      submitButton.disabled = true;
      submitButton.textContent = pendingLabel;
      status.textContent = "";
      status.removeAttribute("data-state");

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });

        if (response.ok) {
          status.textContent = "お問い合わせを受け付けました。ご連絡ありがとうございます。";
          status.dataset.state = "success";
          form.reset();
        } else {
          status.textContent = "送信できませんでした。時間をおいて、もう一度お試しください。";
          status.dataset.state = "error";
        }
      } catch {
        status.textContent = "送信できませんでした。時間をおいて、もう一度お試しください。";
        status.dataset.state = "error";
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = submitLabel;
        isSubmitting = false;
      }
    });
  }
</script>
