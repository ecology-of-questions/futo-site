---
/**
 * contact.astro (お問い合わせ)
 * ------------------------------------------------------------
 * 役割: お問い合わせページ。正式公開に向けたプロジェクトオーナーの
 * 指示により新規実装した(2026-08-17、Decision Log 0057)。
 *
 * 【2026-08-17改訂(Decision Log 0058)】noteのプロフィールURLが
 * 確定し、お問い合わせ手段をnoteの「クリエイターへのお問い合わせ」に
 * 一本化する方針になったため、メール/フォームURLによる分岐と
 * 「連絡先準備中」表示を廃止し、note経由の導線に差し替えた。
 * ------------------------------------------------------------
 */
import DefaultLayout from "@layouts/DefaultLayout.astro";
import ResearchSection from "@components/ResearchSection.astro";
import SectionTitle from "@components/SectionTitle.astro";
import ArrowLink from "@components/ArrowLink.astro";
import styles from "./contact.module.css";
import { noteUrl } from "@/config/site";
---

<DefaultLayout title="お問い合わせ ｜ ふ、と" description="公開研究室「ふ、と」へのお問い合わせ。">
  <ResearchSection ariaLabel="Contact">
    <SectionTitle>CONTACT</SectionTitle>

    <h1 class={styles.heading}>お問い合わせ</h1>
    <div class={styles.body}>
      <p>
        研究についてのご感想、対話や共同研究、執筆・制作に関するご相談などは、noteの「クリエイターへのお問い合わせ」からお寄せください。
      </p>
    </div>

    <div class={styles.contactLink}>
      <ArrowLink href={noteUrl} label="noteから問い合わせる" external />
    </div>

    <p class={styles.note}>
      noteのクリエイターページ下部にある「クリエイターへのお問い合わせ」をご利用ください。
    </p>
  </ResearchSection>
</DefaultLayout>
